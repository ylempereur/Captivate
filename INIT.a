;———————————————————————————————————————————————————————————————
; Routine name  SetTrigger
;
; On entry      A1: globals (pointer)
;———————————————————————————————————————————————————————————————
SetTrigger      PROC    ENTRY

                WITH    Globals,XVBLTask

                TST.B   (trigger,A1)
                BNE.S   Exit
                TST     (delay,A1)
                BEQ.S   @1
                MOVE.B  #1,(trigger,A1)
                MOVE.L  A2,-(SP)
                LEA     (vblTask1,A1),A0
                MOVE    #vType,(qType,A0)
                LEA     @0,A2
                MOVE.L  A2,(vblAddr,A0)
                MOVE    (delay,A1),D0
                MULU    #60,D0
                MOVE    D0,(vblCount,A0)
                CLR     (vblPhase,A0)
                MOVE.L  A1,(vblParm,A0)
                _VInstall
                MOVE.L  (SP)+,A2
                BRA.S   Exit
@0              MOVE.L  (vblParm,A0),A1
@1              MOVE.B  #2,(trigger,A1)
Exit            RTS

                ENDP
;———————————————————————————————————————————————————————————————
; Trap macro    _PostEvent
;
; On entry      A0: eventCode (word)
;               D0: eventMsg (long)
;
; On exit       D0: result code (word)
;———————————————————————————————————————————————————————————————
PEFilter        FUNC    ENTRY

                ENTRY   PEPatch

                WITH    Globals

                MOVEM.L D0-D2/A0/A1,-(SP)
                CMP     #keyDown,A0
                BNE.S   @0
                MOVE.L  (Head,PC),A1
                LSR     #8,D0
                CMP.B   (keyCode,A1),D0
                BNE.S   @0
                MOVE    (KeyBrdMap+6),D0
                ROL     #1,D0
                AND.B   #$1B,D0
                CMP.B   (modifiers,A1),D0
                BNE.S   @0
                BSR     SetTrigger
                MOVEM.L (SP)+,D0-D2/A0/A1
                MOVEQ   #noErr,D0
                RTS
@0              MOVEM.L (SP)+,D0-D2/A0/A1
@1              JMP     ($00000000).L

PEPatch         EQU     @1+2

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE MyFilter;
;———————————————————————————————————————————————————————————————
MyFilter        PROC    ENTRY

                WITH    Globals

                MOVEM.L D0-D2/A0/A1,-(SP)
                MOVE.L  (Head,PC),A1

                CMP.B   #2,(trigger,A1)
                BNE.S   Exit
                MOVE.B  #3,(trigger,A1)
                MOVE.L  A1,-(SP)
                BSR     Capture
                MOVE.L  (SP)+,A1
                CLR.B   (trigger,A1)

Exit            MOVEM.L (SP)+,D0-D2/A0/A1
                RTS

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION GetNextEvent (eventMask: INTEGER; VAR theEvent: EventRecord) : BOOLEAN;
;———————————————————————————————————————————————————————————————
GNEFilter       FUNC    ENTRY

                ENTRY   GNEPatch

                BSR.S   MyFilter
@0              JMP     ($00000000).L

GNEPatch        EQU     @0+2

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION EventAvail (eventMask: INTEGER; VAR theEvent: EventRecord) : BOOLEAN;
;———————————————————————————————————————————————————————————————
EAFilter        FUNC    ENTRY

                ENTRY   EAPatch

                BSR.S   MyFilter
@0              JMP     ($00000000).L

EAPatch         EQU     @0+2

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE SetCursor (crsr: Cursor);
;———————————————————————————————————————————————————————————————
SCFilter        PROC    ENTRY

                ENTRY   SCPatch

                WITH    Globals

                MOVE.L  A0,-(SP)
                MOVE.L  (Head,PC),A0
                TST.B   (scFlag,A0)
                MOVE.L  (SP)+,A0
                BNE.S   @1
@0              JMP     ($00000000).L
@1              MOVE.L  (SP)+,(SP)
                RTS

SCPatch         EQU     @0+2

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE SetCCursor (cCrsr: CCrsrHandle);
;———————————————————————————————————————————————————————————————
SCCFilter       PROC    ENTRY

                ENTRY   SCCPatch

                WITH    Globals

                MOVE.L  A0,-(SP)
                MOVE.L  (Head,PC),A0
                TST.B   (scFlag,A0)
                MOVE.L  (SP)+,A0
                BNE.S   @1
@0              JMP     ($00000000).L
@1              MOVE.L  (SP)+,(SP)
                RTS

SCCPatch        EQU     @0+2

                ENDP
;———————————————————————————————————————————————————————————————
; Routine name  Patch
;
; On entry      A0: Globals (pointer)
;
; On exit       A0: p (pointer)
;               D0: newSize (long word)
;———————————————————————————————————————————————————————————————
Patch           FUNC    ENTRY

PostEvent       EQU     $A02F
GetNextEvent    EQU     $A970
EventAvail      EQU     $A971
SetCursor       EQU     $A851
SetCCursor      EQU     $AA1C
HWPriv          EQU     $A198

                LEA     (Head,PC),A1
                MOVE.L  A0,(A1)

                MOVE    #PostEvent,D0
                _GetOSTrapAddress
                LEA     (PEPatch,PC),A1
                MOVE.L  A0,(A1)
                LEA     (PEFilter,PC),A0
                MOVE    #PostEvent,D0
                _SetOSTrapAddress

                MOVE    #GetNextEvent,D0
                _GetToolTrapAddress
                LEA     (GNEPatch,PC),A1
                MOVE.L  A0,(A1)
                LEA     (GNEFilter,PC),A0
                MOVE    #GetNextEvent,D0
                _SetToolTrapAddress

                MOVE    #EventAvail,D0
                _GetToolTrapAddress
                LEA     (EAPatch,PC),A1
                MOVE.L  A0,(A1)
                LEA     (EAFilter,PC),A0
                MOVE    #EventAvail,D0
                _SetToolTrapAddress

                MOVE    #SetCursor,D0
                _GetToolTrapAddress
                LEA     (SCPatch,PC),A1
                MOVE.L  A0,(A1)
                LEA     (SC0,PC),A1
                MOVE.L  A0,(A1)
                LEA     (SC1,PC),A1
                MOVE.L  A0,(A1)
                LEA     (SC2,PC),A1
                MOVE.L  A0,(A1)
                LEA     (SCFilter,PC),A0
                MOVE    #SetCursor,D0
                _SetToolTrapAddress

                MOVE    #SetCCursor,D0
                BSR     TrapAvailable
                BEQ.S   @0

                MOVE    #SetCCursor,D0
                _GetToolTrapAddress
                LEA     (SCCPatch,PC),A1
                MOVE.L  A0,(A1)
                LEA     (SCCFilter,PC),A0
                MOVE    #SetCCursor,D0
                _SetToolTrapAddress

@0              MOVE    #HWPriv,D0
                BSR     TrapAvailable
                BEQ.S   Exit
                _FlushInstructionCache

Exit            LEA     Head,A0
                LEA     Patch,A1
                SUB.L   A0,A1
                MOVE.L  A1,D0
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE Tail;
;———————————————————————————————————————————————————————————————
Tail            PROC    ENTRY

                ENDP
;———————————————————————————————————————————————————————————————
                END
