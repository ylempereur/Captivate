;———————————————————————————————————————————————————————————————
; pascal void SetAllDevicesRealMode(UInt32 realMode)
;———————————————————————————————————————————————————————————————
        IF ¬ GENERATINGCFM THEN
                MACRO
                _SetAllDevicesRealMode
                        DC.W    $203C
                        DC.W    $0004
                        DC.W    $0007
                        DC.W    $ABE0
                ENDM
        ELSE
                IMPORT_CFM_FUNCTION     SetAllDevicesRealMode
        ENDIF
;———————————————————————————————————————————————————————————————
; pascal UInt32 GetAllDevicesRealMode(void)
;———————————————————————————————————————————————————————————————
        IF ¬ GENERATINGCFM THEN
                MACRO
                _GetAllDevicesRealMode
                        DC.W    $7008
                        DC.W    $ABE0
                ENDM
        ELSE
                IMPORT_CFM_FUNCTION     GetAllDevicesRealMode
        ENDIF
;———————————————————————————————————————————————————————————————
; Resource Header
;———————————————————————————————————————————————————————————————
                MAIN    ENTRY

                IMPORT  Main

                BRA.S   Main            ; enter here
                DC      0               ; filler
                DC.L    ('INIT')        ; type
                DC      128             ; ID
                DC      $0460           ; version

                ENDMAIN
;———————————————————————————————————————————————————————————————
; Routine name  Main
;
; On entry      A0: h (handle)          ; handle to INIT resource
;———————————————————————————————————————————————————————————————
Main            PROC    ENTRY

                IMPORT  CheckEnvirons,InitData,Head,Tail,ShowINIT

                SUBQ.L  #2,SP
                BSR     CheckEnvirons
                TST.B   (SP)+
                BEQ.S   @0
                SUBQ.L  #4,SP
                BSR     InitData
                MOVE.L  (SP)+,D0
                BEQ.S   @0
                MOVE.L  D0,A2
                LEA     Head,A1
                LEA     Tail,A0
                SUB.L   A1,A0
                MOVE.L  A0,D1
                MOVE.L  D1,D0
                _NewPtrSys
                BNE.S   @0
                EXG     A0,A1
                MOVE.L  D1,D0
                _BlockMove
                BNE.S   @0
                MOVE.L  A2,A0
                JSR     (A1)
                _SetPtrSize
                BNE.S   @0
                MOVE    #-4064,-(SP)
                MOVE    #-1,-(SP)
                BSR     ShowINIT
                BRA.S   Exit
@0              MOVE    #-4048,-(SP)
                MOVE    #-1,-(SP)
                BSR     ShowINIT
Exit            RTS

                ENDP
;———————————————————————————————————————————————————————————————
; Routine name  GetSysVersion
;
; On exit       D0: system version (word)
;———————————————————————————————————————————————————————————————
GetSysVersion   FUNC    ENTRY

                IMPORT  TrapAvailable

Gestalt         EQU     $A1AD
SysEnvirons     EQU     $A090

StackFrame      RECORD  {A6Link},DECR
RetAddr         DS.L    1
A6Link          DS.L    1
theWorld        DS      SysEnvRec
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVE.L  A0,-(SP)

                MOVE    #Gestalt,D0
                BSR     TrapAvailable
                BEQ.S   @0

                MOVE.L  #gestaltSystemVersion,D0
                _Gestalt
                BNE.S   @0
                MOVE.L  A0,D0
                BRA.S   Exit

@0              MOVE    #SysEnvirons,D0
                BSR     TrapAvailable
                BEQ.S   @2

                LEA     (theWorld,A6),A0
                MOVEQ   #curSysEnvVers,D0
                _SysEnvirons
                BEQ.S   @1
                CMP     #envVersTooBig,D0
                BNE.S   @2
                CMP     #1,(theWorld.environsVersion,A6)
                BLT.S   @2
@1              MOVE    (theWorld.systemVersion,A6),D0
                BRA.S   Exit

@2              MOVE    (SysVersion),D0

Exit            MOVE.L  (SP)+,A0
                UNLK    A6
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; Routine name  GetFindFolder
;
; On exit       D0: 0 if not present, or -1 if present (byte)
;———————————————————————————————————————————————————————————————
GetFindFolder   FUNC    ENTRY

                IMPORT  TrapAvailable

Gestalt         EQU     $A1AD

                MOVE.L  A0,-(SP)

                MOVE    #Gestalt,D0
                BSR     TrapAvailable
                BEQ.S   @0

                MOVE.L  #gestaltFindFolderAttr,D0
                _Gestalt
                BNE.S   @0
                MOVE.L  A0,D0
                BTST    #gestaltFindFolderPresent,D0
                SNE     D0
                BRA.S   Exit

@0              SF      D0

Exit            MOVE.L  (SP)+,A0
                TST.B   D0
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION CheckEnvirons : BOOLEAN;
;———————————————————————————————————————————————————————————————
CheckEnvirons   FUNC    ENTRY

From            EQU     $AE6A3200       ; Sunday, September 22, 1996 12:00:00 AM
To              EQU     $AE8F1C00       ; Sunday, October 20, 1996 12:00:00 AM

StackFrame      RECORD  {A6Link},DECR
Result          DS      1
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                CLR     (Result,A6)
                BSR     GetSysVersion
                CMP     #$0420,D0
                BLO.S   Exit
;               MOVE.L  (Time),D0       ;
;               CMP.L   #From,D0        ;
;               BLO.S   Exit            ;
;               CMP.L   #To,D0          ;
;               BHS.S   Exit            ;
                ST      (Result,A6)
Exit            UNLK    A6
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION InitData : LONGINT;
;———————————————————————————————————————————————————————————————
InitData        FUNC    ENTRY

                IMPORT  TrapAvailable,GetIndString

countryCode     EQU     4

StackFrame      RECORD  {A6Link},DECR
Result          DS.L    1
RetAddr         DS.L    1
A6Link          DS.L    1
saveResFile     DS.W    1
theString       DS.B    256
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                MOVE.L  #GlobalSize,D0
                _NewPtrSysClear
                BNE     @99
                MOVE.L  A0,A4

                BSR     GetFindFolder
                MOVE.B  D0,(hasFindFolder,A4)

                MOVE    #$ABE0,D0
                BSR     TrapAvailable
                MOVE.B  D0,(hasRealMode,A4)

                SUBQ.L  #4,SP
                MOVE.L  #'CNFG',-(SP)
                MOVE    #-4048,-(SP)
                _Get1Resource
                MOVE.L  (SP)+,D0
                BEQ     @98
                MOVE.L  D0,A0
                MOVE.L  (A0),A0
                MOVE.L  A4,A1
                MOVE.L  #CnfgSize,D0
                _BlockMove
                BNE     @98

                SUBQ.L  #4,SP
                MOVE.L  #'STR#',-(SP)
                MOVE    #-4045,-(SP)
                _Get1Resource
                MOVE.L  (SP)+,D0
                BEQ     @98
                MOVE.L  D0,A0
                MOVE.L  (A0),A0
                CMP     #4,(A0)+
                BNE     @98
                CMP.B   #1,(A0)+
                BNE     @98
                MOVE.B  (A0)+,(sChar,A4)
                CMP.B   #1,(A0)+
                BNE     @98
                MOVE.B  (A0)+,(mChar,A4)
                CMP.B   #1,(A0)+
                BNE     @98
                MOVE.B  (A0)+,(aChar,A4)
                CMP.B   #1,(A0)+
                BNE     @98
                MOVE.B  (A0)+,(wChar,A4)

                _GetZone
                MOVE.L  A0,A3
                MOVE.L  (SysZone),A0
                _SetZone

                SUBQ.L  #4,SP
                MOVE    #stopIcon,-(SP)
                _GetIcon
                MOVE.L  (SP)+,D0
                BEQ     @97
                MOVE.L  D0,A0
                _HNoPurge
                MOVE.L  A0,A2
                MOVE.L  A2,-(SP)
                _DetachResource
                MOVE.L  A2,(stopHndl,A4)

                SUBQ.L  #4,SP
                MOVE    #noteIcon,-(SP)
                _GetIcon
                MOVE.L  (SP)+,D0
                BEQ     @96
                MOVE.L  D0,A0
                _HNoPurge
                MOVE.L  A0,A2
                MOVE.L  A2,-(SP)
                _DetachResource
                MOVE.L  A2,(noteHndl,A4)

                SUBQ.L  #4,SP
                MOVE    #-4064,-(SP)
                _GetCursor
                MOVE.L  (SP)+,D0
                BEQ     @95
                MOVE.L  D0,A2
                MOVE.L  A2,-(SP)
                _DetachResource
                MOVE.L  A2,(myCursor,A4)

                SUBQ.L  #4,SP
                MOVE.L  #'STR#',-(SP)
                MOVE    #-4044,-(SP)
                _Get1Resource
                MOVE.L  (SP)+,D0
                BEQ     @94
                MOVE.L  D0,A2
                MOVE.L  A2,-(SP)
                _DetachResource
                MOVE.L  A2,(myStrings,A4)

                SUBQ.L  #2,SP
                _CurResFile
                MOVE    (SP)+,(saveResFile,A6)

                MOVE    #0,-(SP)
                _UseResFile

                SUBQ.L  #4,SP
                MOVE.L  #'vers',-(SP)
                MOVE    #1,-(SP)
                _Get1Resource
                MOVE.L  (SP)+,A2

                MOVE    (saveResFile,A6),-(SP)
                _UseResFile

                MOVE.L  A2,D0
                BEQ.S   @0

                MOVE.L  (A2),A0
                MOVE    (countryCode,A0),D7
                ADDQ    #1,D7

                MOVE.L  A2,-(SP)
                _ReleaseResource

                PEA     (theString,A6)
                MOVE    #-4043,-(SP)
                MOVE    D7,-(SP)
                JSR     GetIndString

                TST.B   (theString,A6)
                BNE.S   @2

@0              SUBQ.L  #4,SP
                MOVE.L  #'vers',-(SP)
                MOVE    #1,-(SP)
                _Get1Resource
                MOVE.L  (SP)+,D0
                BEQ.S   @1
                MOVE.L  D0,A2

                MOVE.L  (A2),A0
                MOVE    (countryCode,A0),D7
                ADDQ    #1,D7

                MOVE.L  A2,-(SP)
                _ReleaseResource

                PEA     (theString,A6)
                MOVE    #-4043,-(SP)
                MOVE    D7,-(SP)
                JSR     GetIndString

                TST.B   (theString,A6)
                BNE.S   @2

@1              PEA     (theString,A6)
                MOVE    #-4043,-(SP)
                MOVE    #1,-(SP)
                JSR     GetIndString

                TST.B   (theString,A6)
                BEQ     @93

@2              SUBQ.L  #4,SP
                PEA     (theString,A6)
                _NewString
                MOVE.L  (SP)+,D0
                BEQ.S   @93
                MOVE.L  D0,(nameScrap,A4)

                SUBQ.L  #4,SP
                MOVE    #-4047,-(SP)
                _GetString
                MOVE.L  (SP)+,D0
                BEQ.S   @92
                MOVE.L  D0,A2
                MOVE.L  A2,-(SP)
                _DetachResource
                MOVE.L  A2,(namePICT,A4)

                SUBQ.L  #4,SP
                MOVE    #-4046,-(SP)
                _GetString
                MOVE.L  (SP)+,D0
                BEQ.S   @91
                MOVE.L  D0,A2
                MOVE.L  A2,-(SP)
                _DetachResource
                MOVE.L  A2,(nameTIFF,A4)

                SUBQ.L  #4,SP
                MOVE    #-4045,-(SP)
                _GetString
                MOVE.L  (SP)+,D0
                BEQ.S   @90
                MOVE.L  D0,A2
                MOVE.L  A2,-(SP)
                _DetachResource
                MOVE.L  A2,(nameGIF,A4)

                SUBQ.L  #4,SP
                MOVE    #-4044,-(SP)
                _GetString
                MOVE.L  (SP)+,D0
                BEQ.S   @89
                MOVE.L  D0,A2
                MOVE.L  A2,-(SP)
                _DetachResource
                MOVE.L  A2,(namePaint,A4)

                MOVE.L  A3,A0
                _SetZone
                BRA.S   Exit
@89             MOVE.L  (nameGIF,A4),A0
                _DisposeHandle
@90             MOVE.L  (nameTIFF,A4),A0
                _DisposeHandle
@91             MOVE.L  (namePICT,A4),A0
                _DisposeHandle
@92             MOVE.L  (nameScrap,A4),A0
                _DisposeHandle
@93             MOVE.L  (myStrings,A4),A0
                _DisposeHandle
@94             MOVE.L  (myCursor,A4),A0
                _DisposeHandle
@95             MOVE.L  (noteHndl,A4),A0
                _DisposeHandle
@96             MOVE.L  (stopHndl,A4),A0
                _DisposeHandle
@97             MOVE.L  A3,A0
                _SetZone
@98             MOVE.L  A4,A0
                _DisposePtr
@99             SUB.L   A4,A4

Exit            MOVE.L  A4,(Result,A6)
                MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE Head;
;———————————————————————————————————————————————————————————————
Head            PROC    ENTRY

                IMPORT  Patch

                BRA.W   Patch           ; pointer to Globals
                DC.L    ('INIT')        ; type
                DC      128             ; ID
                DC      $0460           ; version
                DC.L    ('Capt')        ; creator

                ENDP
;———————————————————————————————————————————————————————————————
; Demo pattern
;———————————————————————————————————————————————————————————————
                IF      demo THEN

DemoPattern     PROC    ENTRY

                DC.B    $80,$40,$04,$08,$10,$20,$02,$01

                ENDP

                ENDIF
;———————————————————————————————————————————————————————————————
; FUNCTION FlushVol (volName: StringPtr; vRefNum: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
FlushVol        FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
volName         DS.L    1
vRefNum         DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
paramBlock      DS      VolumeParam
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,VolumeParam

                LINK    A6,#LocalSize
                MOVE.L  SP,A0
                MOVE    (vRefNum,A6),(ioVRefNum,A0)
                MOVE.L  (volName,A6),(ioNamePtr,A0)
                _PBFlushVolSync
                MOVE    D0,(Result,A6)
                UNLK    A6
                MOVE.L  (SP)+,A1
                ADDQ.L  #ParamSize,SP
                JMP     (A1)

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION IsResFileClosed (fileName: Str255; vRefNum: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
IsResFileClosed FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
fileName        DS.L    1
vRefNum         DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
paramBlock      DS      ParamBlockRec
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,ParamBlockRec

                LINK    A6,#LocalSize
                MOVE.L  SP,A0
                MOVE.L  (fileName,A6),(ioNamePtr,A0)
                MOVE    (vRefNum,A6),(ioVRefNum,A0)
                CLR.B   (ioFVersNum,A0)
                MOVE    #0,(ioFDirIndex,A0)
                _PBGetFInfoSync
                BNE.S   @0
                MOVEQ   #fnfErr,D0
                TST.L   (ioFlRLgLen,A0)
                BEQ.S   @0
                MOVEQ   #opWrErr,D0
                BTST    #2,(ioFlAttrib,A0)
                BNE.S   @0
                MOVEQ   #noErr,D0
@0              MOVE    D0,(Result,A6)
Exit            UNLK    A6
                MOVE.L  (SP)+,A1
                ADDQ.L  #ParamSize,SP
                JMP     (A1)

                ENDF
;———————————————————————————————————————————————————————————————
; Routine name  TrapAvailable
;
; On entry      D0: trapNum (word)
;
; On exit       D0: 0 if not available, or -1 if available (byte)
;———————————————————————————————————————————————————————————————
TrapAvailable   FUNC    ENTRY

ToolTrapBit     EQU     11
InitGraf        EQU     $A86E
Unimplemented   EQU     $A89F

                MOVEM.L D1/A0/A1,-(SP)
                BTST    #ToolTrapBit,D0
                BEQ.S   @3
                AND     #$07FF,D0
                EXG     D0,D1
                MOVE    #InitGraf,D0
                _GetToolTrapAddress
                MOVE.L  A0,A1
                MOVE    #$AA6E,D0
                _GetToolTrapAddress
                CMP.L   A0,A1
                BNE.S   @0
                MOVE    #$200,D0
                BRA.S   @1
@0              MOVE    #$400,D0
@1              EXG     D0,D1
                CMP     D1,D0
                BLO.S   @2
                MOVE    #Unimplemented,D0
@2              _GetToolTrapAddress
                BRA.S   @4
@3              _GetOSTrapAddress
@4              MOVE.L  A0,A1
                MOVE    #Unimplemented,D0
                _GetToolTrapAddress
                CMP.L   A0,A1
                SNE     D0
                MOVEM.L (SP)+,D1/A0/A1
                TST.B   D0
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE Concat (str0,str1,… : Str255; VAR theString: Str255; n: INTEGER);
;———————————————————————————————————————————————————————————————
Concat          PROC    ENTRY

                MOVEM.L D0-D2/A0-A2,-(SP)
                LEA     (28,SP),A1
                MOVE    (A1)+,D0
                MOVE.L  (A1)+,A0
                MOVE    D0,D2
                ADD     D2,D2
                ADD     D2,D2
                ADD     D2,A1
                CLR     D1
                ADDQ    #1,A0
                BRA.S   @3
@0              MOVE.L  -(A1),A2
                CLR     D2
                MOVE.B  (A2)+,D2
                ADD     D2,D1
                CMP     #255,D1
                BLE.S   @2
                SUB     #255,D1
                SUB     D1,D2
                MOVE    #255,D1
                BRA.S   @2
@1              MOVE.B  (A2)+,(A0)+
@2              DBRA    D2,@1
@3              DBRA    D0,@0
                MOVE.L  -(A1),A0
                MOVE.B  D1,(A0)
                MOVE    -(A1),D0
                MOVE.L  A1,A0
                ADD     D0,D0
                ADD     D0,D0
                ADD     D0,A0
                ADDQ    #2,A0
                MOVE.L  -(A1),(A0)
                MOVE.L  A0,(A1)
                MOVEM.L (SP)+,D0-D2/A0-A2
                MOVE.L  (SP)+,SP
                RTS

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION StillDown : BOOLEAN;
;———————————————————————————————————————————————————————————————
StillDown       FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
RetAddr         DS.L    1
A6Link          DS.L    1
theEvent        DS      EventRecord
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                CLR     (Result,A6)
                SUBQ.L  #2,SP
                _Button
                TST.B   (SP)+
                BEQ.S   Exit
                LEA     (theEvent,A6),A0
                MOVEQ   #7,D0
                _OSEventAvail
                TST.B   D0
                BEQ.S   Exit
                ST      (Result,A6)
Exit            UNLK    A6
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE SetCursor (cursorID: INTEGER);
;———————————————————————————————————————————————————————————————
SetCursor       PROC    ENTRY

                ENTRY   SC0,SC1,SC2

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
cursorID        DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVE    (cursorID,A6),D0
                BNE.S   L1
                MOVE.L  (0,A5),A0
                PEA     (arrow,A0)
L0              JSR     ($00000000).L           ; _SetCursor
                BRA.S   Exit
L1              CMP     #5,D0
                BLO.S   L3
                MOVE.L  (Head,PC),A0
                MOVE.L  (myCursor,A0),A0
                MOVE.L  (A0),-(SP)
L2              JSR     ($00000000).L           ; _SetCursor
                BRA.S   Exit
L3              MOVE.B  (ResLoad),-(SP)
                ST      -(SP)
                _SetResLoad
                SUBQ.L  #4,SP
                MOVE    (cursorID,A6),-(SP)
                _GetCursor
                MOVE.L  (SP)+,D0
                BEQ.S   L5
                MOVE.L  D0,A0
                MOVE.L  (A0),-(SP)
L4              JSR     ($00000000).L           ; _SetCursor
L5              _SetResLoad
Exit            UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

SC0             EQU     L0+2
SC1             EQU     L2+2
SC2             EQU     L4+2

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE GrowRect (startPt: Point; VAR r: Rect);
;———————————————————————————————————————————————————————————————
GrowRect        PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
startPt         DS.L    1
r               DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
pnState         DS      PenState
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CurrentQDGlobals,Rect

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                PEA     (pnState,A6)
                _GetPenState
                _PenNormal
                MOVE    #notPatXor,-(SP)
                _PenMode
                MOVE.L  (0,A5),A0
                PEA     (gray,A0)
                _PenPat
                MOVE.L  (r,A6),A2
                MOVE.L  (startPt,A6),D5
                MOVE.L  D5,(topLeft,A2)
                MOVE.L  D5,(botRight,A2)
                MOVE.L  D5,D4
@0              SUBQ.L  #4,SP
                _TickCount
                MOVE.L  (SP)+,D7
@1              SUBQ.L  #2,SP
                BSR     StillDown
                TST.B   (SP)+
                BEQ.S   @3
                SUBQ.L  #4,SP
                _TickCount
                MOVE.L  (SP)+,D0
                SUB.L   D7,D0
                SUBQ.L  #2,D0
                BLT.S   @1
                SUBQ.L  #4,SP
                MOVE.L  SP,-(SP)
                _GetMouse
                MOVE.L  (SP)+,D3
                SUBQ.L  #2,SP
                MOVE.L  D3,-(SP)
                MOVE.L  D4,-(SP)
                _EqualPt
                TST.B   (SP)+
                BNE.S   @0
                MOVE.L  D3,D4
                MOVE.L  A2,-(SP)
                _FrameRect
                MOVE.L  D5,-(SP)
                MOVE.L  D4,-(SP)
                MOVE.L  A2,-(SP)
                _Pt2Rect
                SUBQ.L  #2,SP
                MOVE.L  A2,-(SP)
                _EmptyRect
                TST.B   (SP)+
                BNE.S   @2
                MOVE.L  #$00010001,-(SP)
                PEA     (botRight,A2)
                _AddPt
@2              MOVE.L  A2,-(SP)
                _FrameRect
                BRA.S   @0
@3              MOVE.L  A2,-(SP)
                _FrameRect
                PEA     (pnState,A6)
                _SetPenState
Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION PICTToScrap (thePicture: PicHandle) : OSErr;
;———————————————————————————————————————————————————————————————
PICTToScrap     FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS      1
ParamBegin      EQU     *
thePicture      DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                SUBQ.L  #2,SP
                MOVE    #3,-(SP)
                _SystemEdit
                ADDQ.L  #2,SP

                SUBQ.L  #4,SP
                _ZeroScrap
                MOVE.L  (SP)+,D0
                BNE.S   @1

                MOVE.L  (thePicture,A6),A0
                _HLock
                BNE.S   @1
                _GetHandleSize
                TST.L   D0
                BMI.S   @0
                MOVE.L  (A0),A3
                MOVE.L  D0,D3

                SUBQ.L  #4,SP
                MOVE.L  D3,-(SP)
                MOVE.L  #'PICT',-(SP)
                MOVE.L  A3,-(SP)
                _PutScrap
                MOVE.L  (SP)+,D0
                BNE.S   @0

                MOVE.L  (thePicture,A6),A0
                _HUnlock
                BNE.S   @1

                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@0              MOVE    D0,(Result,A6)
                MOVE.L  (thePicture,A6),A0
                _HUnlock
                BRA.S   Exit

@1              MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; Routine name  GetSysVRefNum
;
; On exit       D0: sysVRefNum (word)
;———————————————————————————————————————————————————————————————
GetSysVRefNum   FUNC    ENTRY

SysEnvirons     EQU     $A090

StackFrame      RECORD  {A6Link},DECR
RetAddr         DS.L    1
A6Link          DS.L    1
theWorld        DS      SysEnvRec
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVE.L  A0,-(SP)

                MOVE    #SysEnvirons,D0
                BSR     TrapAvailable
                BEQ.S   @1

                LEA     (theWorld,A6),A0
                MOVEQ   #curSysEnvVers,D0
                _SysEnvirons
                BEQ.S   @0
                CMP     #envVersTooBig,D0
                BNE.S   @1
                CMP     #1,(theWorld.environsVersion,A6)
                BLT.S   @1
@0              MOVE    (theWorld.sysVRefNum,A6),D0
                BRA.S   Exit

@1              MOVE    (BootDrive),D0

Exit            MOVE.L  (SP)+,A0
                UNLK    A6
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION PICTToScrapbook (thePicture: PicHandle) : OSErr;
;———————————————————————————————————————————————————————————————
PICTToScrapbook FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS      1
ParamBegin      EQU     *
thePicture      DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
saveResLoad     DS      1
saveResFile     DS      1
saveREProc      DS.L    1
fileName        DS.B    64
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                MOVE.L  (Head,PC),A4

                LEA     (fileName,A6),A1
                MOVE.L  (nameScrap,A4),A0
                MOVE.L  (A0),A0
                CLR     D0
                MOVE.B  (A0),D0
@0              MOVE.B  (A0)+,(A1)+
                DBRA    D0,@0

                BSR     GetSysVRefNum
                MOVE    D0,D7

                SUBQ.L  #2,SP
                PEA     (fileName,A6)
                MOVE    D7,-(SP)
                BSR     IsResFileClosed
                MOVE    (SP)+,D0
                BNE     @14

                MOVE.L  (ResErrProc),(saveREProc,A6)
                CLR.L   (ResErrProc)

                MOVE.B  (ResLoad),(saveResLoad,A6)
                ST      -(SP)
                _SetResLoad

                SUBQ.L  #2,SP
                _CurResFile
                MOVE    (SP)+,(saveResFile,A6)

                SUBQ.L  #2,SP
                PEA     (fileName,A6)
                MOVE    D7,-(SP)
                MOVE.B  #fsCurPerm,-(SP)
                _OpenRFPerm
                MOVE    (SP)+,D6
                BPL.S   @1
                SUBQ.L  #2,SP
                _ResError
                MOVE    (SP)+,D0
                BRA     @12

@1              SUBQ.L  #4,SP
                MOVE.L  #'SMAP',-(SP)
                MOVE    #0,-(SP)
                _Get1Resource
                MOVE.L  (SP)+,D0
                BNE.S   @2
                SUBQ.L  #2,SP
                _ResError
                MOVE    (SP)+,D0
                BNE     @10
                MOVE    #resNotFound,D0
                BRA     @10
@2              MOVE.L  D0,A3

                MOVE.L  A3,A0
                _HNoPurge

                MOVE.L  (A3),A0
                CLR     D0
                MOVE    #256-1,D1
@3              TST.B   (A0)+
                BEQ.S   @4
                ADDQ    #1,D0
@4              DBRA    D1,@3
                CMP     #255,D0
                BLO.S   @5
                MOVEQ   #mapFulErr,D0
                BRA     @10

@5              MOVE.L  (A3),A0
                MOVE    #256-1,D0
@6              TST.B   (A0)+
                BEQ.S   @7
                ADDQ.B  #1,(-1,A0)
@7              DBRA    D0,@6

                MOVE.L  (A3),A0
                MOVE    #256-1,D0
@8              TST.B   (A0)+
                DBEQ    D0,@8
                MOVE.B  #1,-(A0)
                MOVE.L  A0,D5
                SUB.L   (A3),D5
                OR      #$8000,D5

                MOVE.L  (thePicture,A6),-(SP)
                MOVE.L  #'PICT',-(SP)
                MOVE    D5,-(SP)
                PEA     #''
                _AddResource

                SUBQ.L  #2,SP
                _ResError
                MOVE    (SP)+,D0
                BNE     @10

                SUBQ.L  #2,SP
                MOVE.L  (thePicture,A6),-(SP)
                _GetResAttrs
                MOVE    (SP)+,D0

                BSET    #resPurgeableBit,D0

                MOVE.L  (thePicture,A6),-(SP)
                MOVE    D0,-(SP)
                _SetResAttrs

                MOVE.L  (thePicture,A6),-(SP)
                _WriteResource

                SUBQ.L  #2,SP
                _ResError
                MOVE    (SP)+,D0
                BNE.S   @9

                MOVE.L  A3,-(SP)
                _ChangedResource

                SUBQ.L  #2,SP
                _ResError
                MOVE    (SP)+,D0
                BNE.S   @9

                MOVE.L  A3,-(SP)
                _WriteResource

                SUBQ.L  #2,SP
                _ResError
                MOVE    (SP)+,D0
                BNE.S   @9

                MOVE.L  (thePicture,A6),-(SP)
                _DetachResource

                MOVE.L  A3,A0
                _HPurge

                MOVE    D6,-(SP)
                _UpdateResFile

                SUBQ.L  #2,SP
                _ResError
                MOVE    (SP)+,D0
                BNE.S   @10

                MOVE    D6,-(SP)
                _CloseResFile

                SUBQ.L  #2,SP
                _ResError
                MOVE    (SP)+,D0
                BNE.S   @12

                MOVE    (saveResFile,A6),-(SP)
                _UseResFile

                MOVE.B  (saveResLoad,A6),-(SP)
                _SetResLoad

                MOVE.L  (saveREProc,A6),(ResErrProc)

                SUBQ.L  #2,SP
                MOVE.L  #NIL,-(SP)
                MOVE    D7,-(SP)
                JSR     FlushVol
                MOVE    (SP)+,D0
                BNE.S   @14

                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@9              MOVE    D0,(Result,A6)
                MOVE.L  (thePicture,A6),-(SP)
                _RemoveResource
                BRA.S   @11

@10             MOVE    D0,(Result,A6)
@11             MOVE    D6,-(SP)
                _CloseResFile
                BRA.S   @13

@12             MOVE    D0,(Result,A6)
@13             MOVE    (saveResFile,A6),-(SP)
                _UseResFile

                MOVE.B  (saveResLoad,A6),-(SP)
                _SetResLoad

                MOVE.L  (saveREProc,A6),(ResErrProc)

                SUBQ.L  #2,SP
                MOVE.L  #NIL,-(SP)
                MOVE    D7,-(SP)
                JSR     FlushVol
                ADDQ.L  #2,SP
                BRA.S   Exit

@14             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetPicture (srcPort: GrafPtr; srcRect: Rect; scale: INTEGER; mode: BOOLEAN) : OSErr;
;———————————————————————————————————————————————————————————————
GetPicture      FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
mode            DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
imageWidth      DS.W    1
imageLength     DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
savePort        DS.L    1
myPicture       DS.L    1
dstRect         DS      Rect
dRect           DS      Rect
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                MOVEQ   #GrafPort.sizeof,D0
                _NewPtr
                BNE     @16
                MOVE.L  A0,A4
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A4,-(SP)
                _OpenPort

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #3*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                ADD     #15,D1
                LSR     #4,D1
                ADD     D1,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @0
                MOVEQ   #1,D0
@0              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @1
                MOVE    D1,D0
@1              MOVE    D0,(rowsPerStrip,A6)

                MOVEQ   #GrafPort.sizeof,D0
                _NewPtr
                BNE     @14
                MOVE.L  A0,A3
                MOVE.L  A3,-(SP)
                _OpenPort
                LEA     (GrafPort.portBits,A3),A2
                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @12
                MOVE.L  A0,(BitMap.baseAddr,A2)
                MOVE    (bytesPerRow,A6),(BitMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(BitMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(BitMap.bounds.botRight,A2)

                MOVE    (scale,A6),D2
                MOVEQ   #100,D1
                CLR.L   (dstRect.topLeft,A6)
                MOVE    (imageLength,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.bottom,A6)
                MOVE    (imageWidth,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.right,A6)

                MOVE.L  A4,-(SP)
                _SetPort
                PEA     (dstRect,A6)
                _ClipRect
                SUBQ.L  #4,SP
                PEA     (dstRect,A6)
                _OpenPicture
                MOVE.L  (SP)+,D0
                BNE.S   @2
                MOVEQ   #memFullErr,D0
                BRA     @10
@2              MOVE.L  D0,(myPicture,A6)
                MOVE    #picDwgBeg,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                MOVE    #picBitBeg,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment

@3              SUBQ.L  #2,SP
                PEA     (BitMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @5
                MOVE    (BitMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (BitMap.bounds.bottom,A2),D0
                BGE.S   @4
                MOVE    D0,(BitMap.bounds.bottom,A2)
@4              MOVE.L  (BitMap.bounds.topLeft,A2),(GrafPort.portRect.topLeft,A3)
                MOVE.L  (BitMap.bounds.botRight,A2),(GrafPort.portRect.botRight,A3)
                MOVE.L  (GrafPort.visRgn,A3),-(SP)
                PEA     (GrafPort.portRect,A3)
                _RectRgn
                MOVE.L  A3,-(SP)
                _SetPort
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (BitMap.bounds,A2)
                PEA     (BitMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (BitMap.bounds.topLeft,A2),(dRect.topLeft,A6)
                MOVE.L  (BitMap.bounds.botRight,A2),(dRect.botRight,A6)
                PEA     (dRect,A6)
                MOVE.L  (srcRect,A6),-(SP)
                PEA     (dstRect,A6)
                _MapRect
                MOVE.L  A4,-(SP)
                _SetPort
                PEA     (GrafPort.portBits,A3)
                PEA     (GrafPort.portBits,A4)
                PEA     (BitMap.bounds,A2)
                PEA     (dRect,A6)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                MOVE.L  (srcRect,A6),A0
                MOVE    (BitMap.bounds.bottom,A2),(BitMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(BitMap.bounds.bottom,A2)
                BRA     @3

@5              MOVE    #picBitEnd,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                MOVE    #picDwgEnd,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                _ClosePicture

                MOVE.L  (myPicture,A6),A0
                _HLock
                BNE.S   @9
                MOVE.L  (A0),A0
                SUBQ.L  #2,SP
                PEA     (Picture.picFrame,A0)
                _EmptyRect
                TST.B   (SP)+
                BEQ.S   @6
                MOVEQ   #memFullErr,D0
                BRA.S   @9
@6              MOVE.L  (myPicture,A6),A0
                _HUnlock
                BNE.S   @9
                TST.B   (mode,A6)
                BNE.S   @7
                SUBQ.L  #2,SP
                MOVE.L  (myPicture,A6),-(SP)
                BSR     PICTToScrap
                MOVE    (SP)+,D0
                BNE.S   @9
                BRA.S   @8
@7              SUBQ.L  #2,SP
                MOVE.L  (myPicture,A6),-(SP)
                BSR     PICTToScrapbook
                MOVE    (SP)+,D0
                BNE.S   @9
@8              MOVE.L  (myPicture,A6),-(SP)
                _KillPicture
                MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  A4,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A4,A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@9              MOVE    D0,(Result,A6)
                MOVE.L  (myPicture,A6),-(SP)
                _KillPicture
                BRA.S   @11

@10             MOVE    D0,(Result,A6)
@11             MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @13

@12             MOVE    D0,(Result,A6)
@13             MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @15

@14             MOVE    D0,(Result,A6)
@15             MOVE.L  A4,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A4,A0
                _DisposePtr
                BRA.S   Exit

@16             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetCPicture (srcPort: CGrafPtr; srcRect: Rect; scale: INTEGER; mode: BOOLEAN) : OSErr;
;———————————————————————————————————————————————————————————————
GetCPicture     FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
mode            DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
pixelSize       DS.W    1
imageWidth      DS.W    1
imageLength     DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
savePort        DS.L    1
myPicture       DS.L    1
dstRect         DS      Rect
dRect           DS      Rect
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                MOVEQ   #CGrafPort.sizeof,D0
                _NewPtr
                BNE     @16
                MOVE.L  A0,A4
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A4,-(SP)
                _OpenCPort

                MOVE.L  (CGrafPort.portPixMap,A4),A0
                MOVE.L  (A0),A0
                MOVE    (PixMap.pixelSize,A0),(pixelSize,A6)

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #50*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                MULU    (pixelSize,A6),D1
                ADD.L   #15,D1
                LSR.L   #4,D1
                ADD     D1,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @0
                MOVEQ   #1,D0
@0              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @1
                MOVE    D1,D0
@1              MOVE    D0,(rowsPerStrip,A6)

                MOVEQ   #CGrafPort.sizeof,D0
                _NewPtr
                BNE     @14
                MOVE.L  A0,A3
                MOVE.L  A3,-(SP)
                _OpenCPort
                MOVE.L  (CGrafPort.portPixMap,A3),A0
                _MoveHHi
                BNE     @12
                _HLock
                BNE     @12
                MOVE.L  (A0),A2
                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @12
                MOVE.L  A0,(PixMap.baseAddr,A2)
                MOVE    (bytesPerRow,A6),D0
                OR      #$8000,D0
                MOVE    D0,(PixMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(PixMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(PixMap.bounds.botRight,A2)

                MOVE    (scale,A6),D2
                MOVEQ   #100,D1
                CLR.L   (dstRect.topLeft,A6)
                MOVE    (imageLength,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.bottom,A6)
                MOVE    (imageWidth,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.right,A6)

                MOVE.L  A4,-(SP)
                _SetPort
                PEA     (dstRect,A6)
                _ClipRect
                SUBQ.L  #4,SP
                PEA     (dstRect,A6)
                _OpenPicture
                MOVE.L  (SP)+,D0
                BNE.S   @2
                MOVEQ   #memFullErr,D0
                BRA     @10
@2              MOVE.L  D0,(myPicture,A6)
                MOVE    #picDwgBeg,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                MOVE    #picBitBeg,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment

@3              SUBQ.L  #2,SP
                PEA     (PixMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @5
                MOVE    (PixMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (PixMap.bounds.bottom,A2),D0
                BGE.S   @4
                MOVE    D0,(PixMap.bounds.bottom,A2)
@4              MOVE.L  (PixMap.bounds.topLeft,A2),(CGrafPort.portRect.topLeft,A3)
                MOVE.L  (PixMap.bounds.botRight,A2),(CGrafPort.portRect.botRight,A3)
                MOVE.L  (CGrafPort.visRgn,A3),-(SP)
                PEA     (CGrafPort.portRect,A3)
                _RectRgn
                MOVE.L  A3,-(SP)
                _SetPort
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (PixMap.bounds,A2)
                PEA     (PixMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (PixMap.bounds.topLeft,A2),(dRect.topLeft,A6)
                MOVE.L  (PixMap.bounds.botRight,A2),(dRect.botRight,A6)
                PEA     (dRect,A6)
                MOVE.L  (srcRect,A6),-(SP)
                PEA     (dstRect,A6)
                _MapRect
                MOVE.L  A4,-(SP)
                _SetPort
                PEA     (GrafPort.portBits,A3)
                PEA     (GrafPort.portBits,A4)
                PEA     (PixMap.bounds,A2)
                PEA     (dRect,A6)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                MOVE.L  (srcRect,A6),A0
                MOVE    (PixMap.bounds.bottom,A2),(PixMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(PixMap.bounds.bottom,A2)
                BRA     @3

@5              MOVE    #picBitEnd,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                MOVE    #picDwgEnd,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                _ClosePicture

                MOVE.L  (myPicture,A6),A0
                _HLock
                BNE.S   @9
                MOVE.L  (A0),A0
                SUBQ.L  #2,SP
                PEA     (Picture.picFrame,A0)
                _EmptyRect
                TST.B   (SP)+
                BEQ.S   @6
                MOVEQ   #memFullErr,D0
                BRA.S   @9
@6              MOVE.L  (myPicture,A6),A0
                _HUnlock
                BNE.S   @9
                TST.B   (mode,A6)
                BNE.S   @7
                SUBQ.L  #2,SP
                MOVE.L  (myPicture,A6),-(SP)
                BSR     PICTToScrap
                MOVE    (SP)+,D0
                BNE.S   @9
                BRA.S   @8
@7              SUBQ.L  #2,SP
                MOVE.L  (myPicture,A6),-(SP)
                BSR     PICTToScrapbook
                MOVE    (SP)+,D0
                BNE.S   @9
@8              MOVE.L  (myPicture,A6),-(SP)
                _KillPicture
                MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  A4,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A4,A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@9              MOVE    D0,(Result,A6)
                MOVE.L  (myPicture,A6),-(SP)
                _KillPicture
                BRA.S   @11

@10             MOVE    D0,(Result,A6)
@11             MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @13

@12             MOVE    D0,(Result,A6)
@13             MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @15

@14             MOVE    D0,(Result,A6)
@15             MOVE.L  A4,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A4,A0
                _DisposePtr
                BRA.S   Exit

@16             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE IncName (fileName: Str255);
;———————————————————————————————————————————————————————————————
INCNAME         PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
fileName        DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize

                MOVE.L  (fileName,A6),A1
                CLR     D1
                MOVE.B  (A1),D1
@0              CMP.B   #'9',(A1,D1)
                BEQ.S   @1
                ADDQ.B  #1,(A1,D1)
                BRA.S   Exit
@1              MOVE.B  #'0',(A1,D1)
                SUBQ    #1,D1
                CMP.B   #'0',(A1,D1)
                BLO.S   @2
                CMP.B   #'9',(A1,D1)
                BLS.S   @0
@2              ADDQ.B  #1,(A1)
                ADDQ    #1,D1
                MOVE.B  #'1',(A1,D1)
@3              ADDQ    #1,D1
                MOVE.B  #'0',(A1,D1)
                CMP.B   (A1),D1
                BNE.S   @3

Exit            UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE MyPutPic (dataPtr: Ptr; byteCount: INTEGER);
;———————————————————————————————————————————————————————————————
MyPutPic        PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
dataPtr         DS.L    1
byteCount       DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (0,A5),A4
                MOVE.L  (thePort,A4),A4
                TST.L   (GrafPort.picSave,A4)
                BEQ.S   Exit
                TST.L   (picLogSize,A4)
                BEQ.S   Exit
                MOVE.L  (dataPtr,A6),A1
                MOVE    (byteCount,A6),D1
                EXT.L   D1
                MOVE.L  (picParamBlock,A4),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D1,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsAtMark,(ParamBlockRec.ioPosMode,A0)
                _PBWriteSync
                BNE.S   @0
                ADD.L   D1,(picLogSize,A4)
                MOVE.L  (picLogSize,A4),D0
                MOVE.L  (GrafPort.picSave,A4),A0
                MOVE.L  (A0),A0
                MOVE.L  (0,A0),A0
                MOVE.L  (A0),A0
                MOVE    D0,(Picture.picSize,A0)
                BRA.S   Exit
@0              CLR.L   (picLogSize,A4)
                MOVE.L  (GrafPort.picSave,A4),A0
                MOVE.L  (A0),A0
                MOVE.L  (0,A0),A0
                MOVE.L  (A0),A0
                MOVE    #-1,(A0)+
                CLR.L   (A0)+
                CLR.L   (A0)+
Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION GetPICT1File (srcPort: GrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetPICT1File    FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
imageWidth      DS.W    1
imageLength     DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
volume          DS.W    1
folder          DS.L    1
savePort        DS.L    1
myPicture       DS.L    1
paramBlock      DS.L    1
dstRect         DS      Rect
dRect           DS      Rect
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @28
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @30

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @30
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@30             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @26
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @26

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @26
                BRA.S   @4

@2              MOVE.L  (namePICT,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @26
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @24
                MOVE.L  #'PICT',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applPICT.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @24
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @24

                MOVE.L  #512+Picture.sizeof,D1
                MOVE.L  D1,D0
                _NewPtrClear
                BNE     @22
                MOVE.L  A0,A1
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D1,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE     @21
                MOVE.L  A1,A0
                _DisposePtr
                BNE     @22

                MOVEQ   #picPortRec,D0
                _NewPtr
                BNE     @22
                MOVE.L  A0,A4
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A4,-(SP)
                _OpenPort

                MOVEQ   #QDProcs.sizeof,D0
                _NewPtr
                BNE     @19
                MOVE.L  A0,A3
                MOVE.L  A3,-(SP)
                _SetStdProcs
                LEA     MyPutPic,A0
                MOVE.L  A0,(QDProcs.putPicProc,A3)
                MOVE.L  A3,(GrafPort.grafProcs,A4)
                MOVE.L  #Picture.sizeof,(picLogSize,A4)
                MOVE.L  (paramBlock,A6),(picParamBlock,A4)

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #3*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                ADD     #15,D1
                LSR     #4,D1
                ADD     D1,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @5
                MOVEQ   #1,D0
@5              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @6
                MOVE    D1,D0
@6              MOVE    D0,(rowsPerStrip,A6)

                MOVEQ   #GrafPort.sizeof,D0
                _NewPtr
                BNE     @17
                MOVE.L  A0,A3
                MOVE.L  A3,-(SP)
                _OpenPort
                LEA     (GrafPort.portBits,A3),A2
                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @15
                MOVE.L  A0,(BitMap.baseAddr,A2)
                MOVE    (bytesPerRow,A6),(BitMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(BitMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(BitMap.bounds.botRight,A2)

                MOVE    (scale,A6),D2
                MOVEQ   #100,D1
                CLR.L   (dstRect.topLeft,A6)
                MOVE    (imageLength,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.bottom,A6)
                MOVE    (imageWidth,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.right,A6)

                MOVE.L  A4,-(SP)
                _SetPort
                PEA     (dstRect,A6)
                _ClipRect
                SUBQ.L  #4,SP
                PEA     (dstRect,A6)
                _OpenPicture
                MOVE.L  (SP)+,D0
                BNE.S   @7
                MOVEQ   #memFullErr,D0
                BRA     @13
@7              MOVE.L  D0,(myPicture,A6)
                MOVE    #picDwgBeg,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                MOVE    #picBitBeg,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment

@8              SUBQ.L  #2,SP
                PEA     (BitMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @10
                MOVE    (BitMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (BitMap.bounds.bottom,A2),D0
                BGE.S   @9
                MOVE    D0,(BitMap.bounds.bottom,A2)
@9              MOVE.L  (BitMap.bounds.topLeft,A2),(GrafPort.portRect.topLeft,A3)
                MOVE.L  (BitMap.bounds.botRight,A2),(GrafPort.portRect.botRight,A3)
                MOVE.L  (GrafPort.visRgn,A3),-(SP)
                PEA     (GrafPort.portRect,A3)
                _RectRgn
                MOVE.L  A3,-(SP)
                _SetPort
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (BitMap.bounds,A2)
                PEA     (BitMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (BitMap.bounds.topLeft,A2),(dRect.topLeft,A6)
                MOVE.L  (BitMap.bounds.botRight,A2),(dRect.botRight,A6)
                PEA     (dRect,A6)
                MOVE.L  (srcRect,A6),-(SP)
                PEA     (dstRect,A6)
                _MapRect
                MOVE.L  A4,-(SP)
                _SetPort
                PEA     (GrafPort.portBits,A3)
                PEA     (GrafPort.portBits,A4)
                PEA     (BitMap.bounds,A2)
                PEA     (dRect,A6)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                MOVE.L  (srcRect,A6),A0
                MOVE    (BitMap.bounds.bottom,A2),(BitMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(BitMap.bounds.bottom,A2)
                BRA     @8

@10             MOVE    #picBitEnd,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                MOVE    #picDwgEnd,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                _ClosePicture

                MOVE.L  (myPicture,A6),A0
                _HLock
                BNE.S   @12
                MOVE.L  (A0),A0
                SUBQ.L  #2,SP
                PEA     (Picture.picFrame,A0)
                _EmptyRect
                TST.B   (SP)+
                BEQ.S   @11
                MOVEQ   #dskFulErr,D0
                BRA.S   @12
@11             MOVE.L  (myPicture,A6),A1
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  (A1),(ParamBlockRec.ioBuffer,A0)
                MOVE.L  #Picture.sizeof,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #512,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @12
                MOVE.L  (myPicture,A6),-(SP)
                _KillPicture
                MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (GrafPort.grafProcs,A4),A0
                _DisposePtr
                MOVE.L  A4,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A4,A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @24
                _PBFlushVolSync
                BNE.S   @26
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@12             MOVE    D0,(Result,A6)
                MOVE.L  (myPicture,A6),-(SP)
                _KillPicture
                BRA.S   @14

@13             MOVE    D0,(Result,A6)
@14             MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @16

@15             MOVE    D0,(Result,A6)
@16             MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @18

@17             MOVE    D0,(Result,A6)
@18             MOVE.L  (GrafPort.grafProcs,A4),A0
                _DisposePtr
                BRA.S   @20

@19             MOVE    D0,(Result,A6)
@20             MOVE.L  A4,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A4,A0
                _DisposePtr
                BRA.S   @23

@21             MOVE    D0,(Result,A6)
                MOVE.L  A1,A0
                _DisposePtr
                BRA.S   @23

@22             MOVE    D0,(Result,A6)
@23             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @25

@24             MOVE    D0,(Result,A6)
@25             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @27

@26             MOVE    D0,(Result,A6)
@27             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@28             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetPICT2File (srcPort: CGrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetPICT2File    FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
pixelSize       DS.W    1
imageWidth      DS.W    1
imageLength     DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
volume          DS.W    1
folder          DS.L    1
savePort        DS.L    1
myPicture       DS.L    1
paramBlock      DS.L    1
dstRect         DS      Rect
dRect           DS      Rect
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @28
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @30

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @30
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@30             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @26
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @26

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @26
                BRA.S   @4

@2              MOVE.L  (namePICT,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @26
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @24
                MOVE.L  #'PICT',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applPICT.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @24
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @24

                MOVE.L  #512+Picture.sizeof,D1
                MOVE.L  D1,D0
                _NewPtrClear
                BNE     @22
                MOVE.L  A0,A1
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D1,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE     @21
                MOVE.L  A1,A0
                _DisposePtr
                BNE     @22

                MOVEQ   #picPortRec,D0
                _NewPtr
                BNE     @22
                MOVE.L  A0,A4
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A4,-(SP)
                _OpenCPort

                MOVEQ   #CQDProcs.sizeof,D0
                _NewPtr
                BNE     @19
                MOVE.L  A0,A3
                MOVE.L  A3,-(SP)
                _SetStdCProcs
                LEA     MyPutPic,A0
                MOVE.L  A0,(CQDProcs.putPicProc,A3)
                MOVE.L  A3,(CGrafPort.grafProcs,A4)
                MOVE.L  #Picture.sizeof,(picLogSize,A4)
                MOVE.L  (paramBlock,A6),(picParamBlock,A4)

                MOVE.L  (CGrafPort.portPixMap,A4),A0
                MOVE.L  (A0),A0
                MOVE    (PixMap.pixelSize,A0),(pixelSize,A6)

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #50*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                MULU    (pixelSize,A6),D1
                ADD.L   #15,D1
                LSR.L   #4,D1
                ADD     D1,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @5
                MOVEQ   #1,D0
@5              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @6
                MOVE    D1,D0
@6              MOVE    D0,(rowsPerStrip,A6)

                MOVEQ   #CGrafPort.sizeof,D0
                _NewPtr
                BNE     @17
                MOVE.L  A0,A3
                MOVE.L  A3,-(SP)
                _OpenCPort
                MOVE.L  (CGrafPort.portPixMap,A3),A0
                _MoveHHi
                BNE     @15
                _HLock
                BNE     @15
                MOVE.L  (A0),A2
                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @15
                MOVE.L  A0,(PixMap.baseAddr,A2)
                MOVE    (bytesPerRow,A6),D0
                OR      #$8000,D0
                MOVE    D0,(PixMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(PixMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(PixMap.bounds.botRight,A2)

                MOVE    (scale,A6),D2
                MOVEQ   #100,D1
                CLR.L   (dstRect.topLeft,A6)
                MOVE    (imageLength,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.bottom,A6)
                MOVE    (imageWidth,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.right,A6)

                MOVE.L  A4,-(SP)
                _SetPort
                PEA     (dstRect,A6)
                _ClipRect
                SUBQ.L  #4,SP
                PEA     (dstRect,A6)
                _OpenPicture
                MOVE.L  (SP)+,D0
                BNE.S   @7
                MOVEQ   #memFullErr,D0
                BRA     @13
@7              MOVE.L  D0,(myPicture,A6)
                MOVE    #picDwgBeg,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                MOVE    #picBitBeg,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment

@8              SUBQ.L  #2,SP
                PEA     (PixMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @10
                MOVE    (PixMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (PixMap.bounds.bottom,A2),D0
                BGE.S   @9
                MOVE    D0,(PixMap.bounds.bottom,A2)
@9              MOVE.L  (PixMap.bounds.topLeft,A2),(CGrafPort.portRect.topLeft,A3)
                MOVE.L  (PixMap.bounds.botRight,A2),(CGrafPort.portRect.botRight,A3)
                MOVE.L  (CGrafPort.visRgn,A3),-(SP)
                PEA     (CGrafPort.portRect,A3)
                _RectRgn
                MOVE.L  A3,-(SP)
                _SetPort
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (PixMap.bounds,A2)
                PEA     (PixMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (PixMap.bounds.topLeft,A2),(dRect.topLeft,A6)
                MOVE.L  (PixMap.bounds.botRight,A2),(dRect.botRight,A6)
                PEA     (dRect,A6)
                MOVE.L  (srcRect,A6),-(SP)
                PEA     (dstRect,A6)
                _MapRect
                MOVE.L  A4,-(SP)
                _SetPort
                PEA     (GrafPort.portBits,A3)
                PEA     (GrafPort.portBits,A4)
                PEA     (PixMap.bounds,A2)
                PEA     (dRect,A6)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                MOVE.L  (srcRect,A6),A0
                MOVE    (PixMap.bounds.bottom,A2),(PixMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(PixMap.bounds.bottom,A2)
                BRA     @8

@10             MOVE    #picBitEnd,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                MOVE    #picDwgEnd,-(SP)
                MOVE    #0,-(SP)
                MOVE.L  #NIL,-(SP)
                _PicComment
                _ClosePicture

                MOVE.L  (myPicture,A6),A0
                _HLock
                BNE.S   @12
                MOVE.L  (A0),A0
                SUBQ.L  #2,SP
                PEA     (Picture.picFrame,A0)
                _EmptyRect
                TST.B   (SP)+
                BEQ.S   @11
                MOVEQ   #dskFulErr,D0
                BRA.S   @12
@11             MOVE.L  (myPicture,A6),A1
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  (A1),(ParamBlockRec.ioBuffer,A0)
                MOVE.L  #Picture.sizeof,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #512,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @12
                MOVE.L  (myPicture,A6),-(SP)
                _KillPicture
                MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (CGrafPort.grafProcs,A4),A0
                _DisposePtr
                MOVE.L  A4,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A4,A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @24
                _PBFlushVolSync
                BNE.S   @26
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@12             MOVE    D0,(Result,A6)
                MOVE.L  (myPicture,A6),-(SP)
                _KillPicture
                BRA.S   @14

@13             MOVE    D0,(Result,A6)
@14             MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @16

@15             MOVE    D0,(Result,A6)
@16             MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @18

@17             MOVE    D0,(Result,A6)
@18             MOVE.L  (CGrafPort.grafProcs,A4),A0
                _DisposePtr
                BRA.S   @20

@19             MOVE    D0,(Result,A6)
@20             MOVE.L  A4,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A4,A0
                _DisposePtr
                BRA.S   @23

@21             MOVE    D0,(Result,A6)
                MOVE.L  A1,A0
                _DisposePtr
                BRA.S   @23

@22             MOVE    D0,(Result,A6)
@23             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @25

@24             MOVE    D0,(Result,A6)
@25             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @27

@26             MOVE    D0,(Result,A6)
@27             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@28             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE PackBits (VAR srcPtr,dstPtr: Ptr; srcBytes: INTEGER);
;———————————————————————————————————————————————————————————————
PackBits        PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
srcPtr          DS.L    1
dstPtr          DS.L    1
srcBytes        DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3/A2,-(SP)
                MOVE.L  (srcPtr,A6),A0
                MOVE.L  (A0),A0
                MOVE.L  (dstPtr,A6),A1
                MOVE.L  (A1),A1
                MOVE    (srcBytes,A6),D3
@0              SUBQ    #1,D3
                BLT.S   @11
                MOVE.B  (A0)+,D1
@1              MOVE.L  A1,A2
@2              MOVE.B  D1,D0
                MOVEQ   #0,D2
@3              SUBQ    #1,D3
                BLT.S   @8
                MOVE.B  (A0)+,D1
                CMP.B   D0,D1
                BNE.S   @4
                SUBQ.B  #1,D2
                CMP.B   #-127,D2
                BGT.S   @3
                MOVE.B  D2,(A1)+
                MOVE.B  D0,(A1)+
                BRA.S   @0
@4              CMP.L   A1,A2
                BNE.S   @5
                TST.B   D2
                BNE.S   @7
                MOVE.B  D2,(A1)+
                MOVE.B  D0,(A1)+
                BRA.S   @2
@5              CMP.B   #-1,D2
                BGT.S   @6
                BLT.S   @7
                CMP.B   #126,(A2)
                BGE.S   @7
                MOVE.B  D0,(A1)+
                ADDQ.B  #1,(A2)
@6              MOVE.B  D0,(A1)+
                ADDQ.B  #1,(A2)
                CMP.B   #127,(A2)
                BLT.S   @2
                BRA.S   @1
@7              MOVE.B  D2,(A1)+
                MOVE.B  D0,(A1)+
                BRA.S   @1
@8              CMP.L   A1,A2
                BEQ.S   @10
                CMP.B   #-1,D2
                BGT.S   @9
                BLT.S   @10
                CMP.B   #126,(A2)
                BGE.S   @10
                MOVE.B  D0,(A1)+
                ADDQ.B  #1,(A2)
@9              MOVE.B  D0,(A1)+
                ADDQ.B  #1,(A2)
                BRA.S   @11
@10             MOVE.B  D2,(A1)+
                MOVE.B  D0,(A1)+
@11             MOVEQ   #0,D0
                MOVE    (srcBytes,A6),D0
                MOVE.L  (srcPtr,A6),A0
                ADD.L   D0,(A0)
                MOVE.L  (dstPtr,A6),A0
                MOVE.L  A1,(A0)
                MOVEM.L (SP)+,D3/A2
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION GetPaintFile (srcPort: GrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetPaintFile    FUNC    ENTRY

bytesPerRow     EQU     72
rowsPerStrip    EQU     8*1024/bytesPerRow

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
imageWidth      DS.W    1
imageLength     DS.W    1
volume          DS.W    1
folder          DS.L    1
srcPtr          DS.L    1
dstPtr          DS.L    1
stripPtr        DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
dstRect         DS      Rect
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @22
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @30

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @30
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@30             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @20
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @20

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @20
                BRA.S   @4

@2              MOVE.L  (namePaint,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @20
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @18
                MOVE.L  #'PNTG',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applPaint.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @18
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @18

                MOVEQ   #0,D7

                MOVE.L  #512,D1
                MOVE.L  D1,D0
                _NewPtrClear
                BNE     @16
                MOVE.L  A0,A1
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D1,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  D7,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE     @15
                ADD.L   D1,D7
                MOVE.L  A1,A0
                _DisposePtr
                BNE     @16

                MOVE.L  (srcRect,A6),A0
                MOVE    (Rect.right,A0),D0
                SUB     (Rect.left,A0),D0
                MOVE    D0,(imageWidth,A6)
                MOVE    (Rect.bottom,A0),D0
                SUB     (Rect.top,A0),D0
                MOVE    D0,(imageLength,A6)

                MOVE.L  #(bytesPerRow+(bytesPerRow+127)/128)*rowsPerStrip,D0
                _NewPtr
                BNE     @16
                MOVE.L  A0,(stripPtr,A6)

                MOVEQ   #GrafPort.sizeof,D0
                _NewPtr
                BNE     @13
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenPort
                LEA     (GrafPort.portBits,A3),A2
                MOVE.L  #bytesPerRow*rowsPerStrip,D0
                _NewPtrClear
                BNE     @11
                MOVE.L  A0,(BitMap.baseAddr,A2)
                MOVE    #bytesPerRow,(BitMap.rowBytes,A2)
                MOVE.L  #$00000000,(BitMap.bounds.topLeft,A2)
                MOVE.L  #$02D00240,(BitMap.bounds.botRight,A2)

                MOVE    (scale,A6),D2
                MOVEQ   #100,D1
                CLR.L   (dstRect.topLeft,A6)
                MOVE    (imageLength,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.bottom,A6)
                MOVE    (imageWidth,A6),D0
                MULU    D2,D0
                DIVU    D1,D0
                MOVE    D0,(dstRect.right,A6)

@5              SUBQ.L  #2,SP
                PEA     (BitMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @9
                MOVE    (BitMap.bounds.top,A2),D0
                ADD     #rowsPerStrip,D0
                CMP     (BitMap.bounds.bottom,A2),D0
                BGE.S   @6
                MOVE    D0,(BitMap.bounds.bottom,A2)
@6              MOVE.L  (BitMap.bounds.topLeft,A2),(GrafPort.portRect.topLeft,A3)
                MOVE.L  (BitMap.bounds.botRight,A2),(GrafPort.portRect.botRight,A3)
                MOVE.L  (GrafPort.visRgn,A3),-(SP)
                PEA     (GrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (GrafPort.portRect,A3)
                _EraseRect
                PEA     (dstRect,A6)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                MOVE.L  (srcRect,A6),-(SP)
                PEA     (dstRect,A6)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (dstRect,A6)
                _PaintRect
                ENDIF
                MOVE.L  (BitMap.baseAddr,A2),(srcPtr,A6)
                MOVE.L  (stripPtr,A6),(dstPtr,A6)
                MOVE    (BitMap.bounds.bottom,A2),D3
                SUB     (BitMap.bounds.top,A2),D3
                BRA.S   @8
@7              PEA     (srcPtr,A6)
                PEA     (dstPtr,A6)
                MOVE    #bytesPerRow,-(SP)
                BSR     PackBits
@8              DBRA    D3,@7
                MOVE.L  (stripPtr,A6),A1
                MOVE.L  (dstPtr,A6),D6
                SUB.L   A1,D6
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D6,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  D7,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @10
                ADD.L   D6,D7
                MOVE    (BitMap.bounds.bottom,A2),(BitMap.bounds.top,A2)
                MOVE    #720,(BitMap.bounds.bottom,A2)
                BRA     @5

@9              MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @18
                _PBFlushVolSync
                BNE.S   @20
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@10             MOVE    D0,(Result,A6)
                MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @12

@11             MOVE    D0,(Result,A6)
@12             MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @14

@13             MOVE    D0,(Result,A6)
@14             MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                BRA.S   @17

@15             MOVE    D0,(Result,A6)
                MOVE.L  A1,A0
                _DisposePtr
                BRA.S   @17

@16             MOVE    D0,(Result,A6)
@17             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @19

@18             MOVE    D0,(Result,A6)
@19             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @21

@20             MOVE    D0,(Result,A6)
@21             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@22             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; Routine name  MUL32
;
; On entry      D0: multiplicand (long word)
;               D1: multiplier (word)
;
; On exit       D0: product (long word)
;———————————————————————————————————————————————————————————————
MUL32           FUNC    ENTRY

                MOVE.L  D2,-(SP)
                MOVE.L  D0,D2
                MULU    D1,D0
                SWAP    D2
                MULU    D1,D2
                SWAP    D2
                CLR     D2
                ADD.L   D2,D0
                MOVE.L  (SP)+,D2
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; Routine name  DIV32
;
; On entry      D0: dividend (long word)
;               D1: divisor (word)
;
; On exit       D0: quotient (long word)
;———————————————————————————————————————————————————————————————
DIV32           FUNC    ENTRY

                MOVEM.L D2/D3,-(SP)
                MOVE    D0,D3
                CLR     D0
                SWAP    D0
                DIVU    D1,D0
                MOVE.L  D0,D2
                SWAP    D0
                MOVE    D3,D2
                DIVU    D1,D2
                MOVE    D2,D0
                MOVEM.L (SP)+,D2/D3
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; Routine name  Secs2DateTime
;
; On entry      A0: pointer to dateTime
;               D0: secs (long word)
;
; On exit       A0: incremented by 20
;———————————————————————————————————————————————————————————————
Secs2DateTime   PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
RetAddr         DS.L    1
A6Link          DS.L    1
date            DS      DateTimeRec
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D1/A1,-(SP)
                MOVE.L  A0,A1
                LEA     (date,A6),A0
                _SecondsToDate
                EXG     A0,A1
                MOVEQ   #6,D1
                BRA.S   @3
@0              MOVE    (A1)+,D0
                CMP     #5,D1
                BNE.S   @1
                EXT.L   D0
                DIVS    #1000,D0
                ADD.B   #'0',D0
                MOVE.B  D0,(A0)+
                SWAP    D0
                EXT.L   D0
                DIVS    #100,D0
                ADD.B   #'0',D0
                MOVE.B  D0,(A0)+
                SWAP    D0
@1              EXT.L   D0
                DIVS    #10,D0
                ADD.B   #'0',D0
                MOVE.B  D0,(A0)+
                SWAP    D0
                ADD.B   #'0',D0
                MOVE.B  D0,(A0)+
                TST     D1
                BEQ.S   @3
                CMP     #3,D1
                BEQ.S   @2
                MOVE.B  #':',(A0)+
                BRA.S   @3
@2              MOVE.B  #' ',(A0)+
@3              DBRA    D1,@0
                CLR.B   (A0)+
                MOVEM.L (SP)+,D1/A1
                UNLK    A6
                RTS

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION GetTIFF40B (srcPort: GrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetTIFF40B      FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
volume          DS.W    1
imageWidth      DS.W    1
imageLength     DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
stripsPerImage  DS.L    1
stripOffsets    DS.L    1
stripByteCounts DS.L    1
xResolution     DS.L    1
yResolution     DS.L    1
stripPtr        DS.L    1
headerPtr       DS.L    1
headerSize      DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
folder          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @30
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @40

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @40
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@40             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @28
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @28

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @28
                BRA.S   @4

@2              MOVE.L  (nameTIFF,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @28
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @26
                MOVE.L  #'TIFF',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applTIFF4.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @26
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @26

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #8*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                ADDQ    #7,D1
                LSR     #3,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @5
                MOVEQ   #1,D0
@5              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @6
                MOVE    D1,D0
@6              MOVE    D0,(rowsPerStrip,A6)
                ADD     D0,D1
                SUBQ    #1,D1
                AND.L   #$0000FFFF,D1
                DIVU    D0,D1
                AND.L   #$0000FFFF,D1
                MOVE.L  D1,(stripsPerImage,A6)
                MOVE.L  #8+2+(17*12)+4+8+8,D0
                LSL.L   #2,D1
                CMP.L   #4,D1
                BLS.S   @7
                ADD.L   D1,D0
                ADD.L   D1,D0
@7              _NewPtrClear
                BNE     @24
                MOVE.L  A0,A3

; Image File Header

                MOVE    #'MM',(A0)+
                MOVE    #42,(A0)+
                MOVE.L  #8,(A0)+

; Image File Directory

                MOVE    #17,(A0)+

; SubfileType

                MOVE    #255,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; ImageWidth

                MOVE    #256,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageWidth,A6),(A0)+
                ADDQ.L  #2,A0

; ImageLength

                MOVE    #257,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageLength,A6),(A0)+
                ADDQ.L  #2,A0

; BitsPerSample

                MOVE    #258,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; Compression

                MOVE    #259,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; PhotometricInterpretation

                MOVE    #262,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #0,(A0)+
                ADDQ.L  #2,A0

; FillOrder

                MOVE    #266,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; StripOffsets

                MOVE    #273,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                ADDQ.L  #4,A0

; Orientation

                MOVE    #274,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; SamplesPerPixel

                MOVE    #277,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; RowsPerStrip

                MOVE    #278,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  #1,(A0)+
                CLR     (A0)+
                MOVE    (rowsPerStrip,A6),(A0)+

; StripByteCounts

                MOVE    #279,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADDQ.L  #4,A0

; MinSampleValue

                MOVE    #280,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #0,(A0)+
                ADDQ.L  #2,A0

; MaxSampleValue

                MOVE    #281,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; XResolution

                MOVE    #282,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(xResolution,A6)
                ADDQ.L  #4,A0

; YResolution

                MOVE    #283,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(yResolution,A6)
                ADDQ.L  #4,A0

; ResolutionUnit

                MOVE    #296,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; no more IFDs

                MOVE.L  #NIL,(A0)+

; StripOffsets

                MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @8
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripOffsets,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripOffsets,A6)
                ADD.L   D0,A0

; StripByteCounts

@8              MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @9
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripByteCounts,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D0,A0

; XResolution

@9              MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (xResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  #72*$10000,D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; YResolution

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (yResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  #72*$10000,D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; Strips

                SUB.L   A3,A0
                MOVE.L  A3,(headerPtr,A6)
                MOVE.L  A0,(headerSize,A6)

                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtr
                BNE     @22
                MOVE.L  A0,(stripPtr,A6)

                MOVEQ   #GrafPort.sizeof,D0
                _NewPtr
                BNE     @20
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenPort
                LEA     (GrafPort.portBits,A3),A2
                MOVE    (imageWidth,A6),D0
                ADD     #15,D0
                LSR     #4,D0
                ADD     D0,D0
                MOVE    D0,D4
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @18
                MOVE.L  A0,(BitMap.baseAddr,A2)
                MOVE    D4,(BitMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(BitMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(BitMap.bounds.botRight,A2)

                MOVE.L  (headerSize,A6),D7
                SUB     (bytesPerRow,A6),D4
                AND.L   #$0000FFFF,D4

@10             SUBQ.L  #2,SP
                PEA     (BitMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @16
                MOVE    (BitMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (BitMap.bounds.bottom,A2),D0
                BGE.S   @11
                MOVE    D0,(BitMap.bounds.bottom,A2)
@11             MOVE.L  (BitMap.bounds.topLeft,A2),(GrafPort.portRect.topLeft,A3)
                MOVE.L  (BitMap.bounds.botRight,A2),(GrafPort.portRect.botRight,A3)
                MOVE.L  (GrafPort.visRgn,A3),-(SP)
                PEA     (GrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (BitMap.bounds,A2)
                PEA     (BitMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (BitMap.baseAddr,A2),A1
                MOVE.L  (stripPtr,A6),A0
                MOVE    (BitMap.bounds.bottom,A2),D3
                SUB     (BitMap.bounds.top,A2),D3
                BRA.S   @15
@12             MOVE    (bytesPerRow,A6),D2
                BRA.S   @14
@13             MOVE.B  (A1)+,(A0)+
@14             DBRA    D2,@13
                ADD.L   D4,A1
@15             DBRA    D3,@12
                MOVE.L  (stripPtr,A6),A1
                MOVE.L  A0,D6
                SUB.L   A1,D6
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D6,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  D7,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @17
                MOVE.L  (stripOffsets,A6),A0
                MOVE.L  D7,(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                MOVE.L  (stripByteCounts,A6),A0
                MOVE.L  D6,(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D6,D7
                MOVE.L  (srcRect,A6),A0
                MOVE    (BitMap.bounds.bottom,A2),(BitMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(BitMap.bounds.bottom,A2)
                BRA     @10

@16             MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  (headerPtr,A6),(ParamBlockRec.ioBuffer,A0)
                MOVE.L  (headerSize,A6),(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @22
                MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @26
                _PBFlushVolSync
                BNE.S   @28
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@17             MOVE    D0,(Result,A6)
                MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @19

@18             MOVE    D0,(Result,A6)
@19             MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @21

@20             MOVE    D0,(Result,A6)
@21             MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                BRA.S   @23

@22             MOVE    D0,(Result,A6)
@23             MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                BRA.S   @25

@24             MOVE    D0,(Result,A6)
@25             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @27

@26             MOVE    D0,(Result,A6)
@27             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @29

@28             MOVE    D0,(Result,A6)
@29             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@30             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetTIFF50B (srcPort: GrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetTIFF50B      FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
volume          DS.W    1
imageWidth      DS.W    1
imageLength     DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
stripsPerImage  DS.L    1
stripOffsets    DS.L    1
stripByteCounts DS.L    1
xResolution     DS.L    1
yResolution     DS.L    1
software        DS.L    1
dateTime        DS.L    1
srcPtr          DS.L    1
dstPtr          DS.L    1
stripPtr        DS.L    1
headerPtr       DS.L    1
headerSize      DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
folder          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @29
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @40

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @40
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@40             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @27
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @27

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @27
                BRA.S   @4

@2              MOVE.L  (nameTIFF,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @27
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @25
                MOVE.L  #'TIFF',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applTIFF5.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @25
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @25

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #8*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                ADDQ    #7,D1
                LSR     #3,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @5
                MOVEQ   #1,D0
@5              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @6
                MOVE    D1,D0
@6              MOVE    D0,(rowsPerStrip,A6)
                ADD     D0,D1
                SUBQ    #1,D1
                AND.L   #$0000FFFF,D1
                DIVU    D0,D1
                AND.L   #$0000FFFF,D1
                MOVE.L  D1,(stripsPerImage,A6)
                MOVE.L  #8+2+(15*12)+4+8+8+12+20,D0
                ADD.L   D1,D1
                CMP.L   #4,D1
                BLS.S   @7
                ADD.L   D1,D0
@7              ADD.L   D1,D1
                CMP.L   #4,D1
                BLS.S   @8
                ADD.L   D1,D0
@8              _NewPtrClear
                BNE     @23
                MOVE.L  A0,A3

; Image File Header

                MOVE    #'MM',(A0)+
                MOVE    #42,(A0)+
                MOVE.L  #8,(A0)+

; Image File Directory

                MOVE    #15,(A0)+

; NewSubfileType

                MOVE    #254,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  #$00000000,(A0)+

; ImageWidth

                MOVE    #256,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageWidth,A6),(A0)+
                ADDQ.L  #2,A0

; ImageLength

                MOVE    #257,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageLength,A6),(A0)+
                ADDQ.L  #2,A0

; BitsPerSample

                MOVE    #258,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; Compression

                MOVE    #259,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #32773,(A0)+
                ADDQ.L  #2,A0

; PhotometricInterpretation

                MOVE    #262,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #0,(A0)+
                ADDQ.L  #2,A0

; StripOffsets

                MOVE    #273,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                ADDQ.L  #4,A0

; SamplesPerPixel

                MOVE    #277,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; RowsPerStrip

                MOVE    #278,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (rowsPerStrip,A6),(A0)+
                ADDQ.L  #2,A0

; StripByteCounts

                MOVE    #279,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADDQ.L  #4,A0

; XResolution

                MOVE    #282,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(xResolution,A6)
                ADDQ.L  #4,A0

; YResolution

                MOVE    #283,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(yResolution,A6)
                ADDQ.L  #4,A0

; ResolutionUnit

                MOVE    #296,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; Software

                MOVE    #305,(A0)+
                MOVE    #2,(A0)+
                MOVE.L  #12,(A0)+
                MOVE.L  A0,(software,A6)
                ADDQ.L  #4,A0

; DateTime

                MOVE    #306,(A0)+
                MOVE    #2,(A0)+
                MOVE.L  #20,(A0)+
                MOVE.L  A0,(dateTime,A6)
                ADDQ.L  #4,A0

; no more IFDs

                MOVE.L  #NIL,(A0)+

; StripOffsets

                MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @9
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripOffsets,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripOffsets,A6)
                ADD.L   D0,A0

; StripByteCounts

@9              MOVE.L  (stripsPerImage,A6),D0
                ADD.L   D0,D0
                CMP.L   #4,D0
                BLS.S   @10
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripByteCounts,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D0,A0

; XResolution

@10             MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (xResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  #72*$10000,D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; YResolution

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (yResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  #72*$10000,D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; Software

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (software,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  #'Capt',(A0)+
                MOVE.L  #'ure ',(A0)+
                MOVE.L  #$342E3600,(A0)+

; DateTime

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (dateTime,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (Time),D0
                BSR     Secs2DateTime

; Strips

                SUB.L   A3,A0
                MOVE.L  A3,(headerPtr,A6)
                MOVE.L  A0,(headerSize,A6)

                MOVE    (bytesPerRow,A6),D0
                MOVE    D0,D1
                ADD     #127,D1
                LSR     #7,D1
                ADD     D1,D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtr
                BNE     @21
                MOVE.L  A0,(stripPtr,A6)

                MOVEQ   #GrafPort.sizeof,D0
                _NewPtr
                BNE     @19
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenPort
                LEA     (GrafPort.portBits,A3),A2
                MOVE    (imageWidth,A6),D0
                ADD     #15,D0
                LSR     #4,D0
                ADD     D0,D0
                MOVE    D0,D4
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @17
                MOVE.L  A0,(BitMap.baseAddr,A2)
                MOVE    D4,(BitMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(BitMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(BitMap.bounds.botRight,A2)

                MOVE.L  (headerSize,A6),D7
                SUB     (bytesPerRow,A6),D4
                AND.L   #$0000FFFF,D4

@11             SUBQ.L  #2,SP
                PEA     (BitMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @15
                MOVE    (BitMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (BitMap.bounds.bottom,A2),D0
                BGE.S   @12
                MOVE    D0,(BitMap.bounds.bottom,A2)
@12             MOVE.L  (BitMap.bounds.topLeft,A2),(GrafPort.portRect.topLeft,A3)
                MOVE.L  (BitMap.bounds.botRight,A2),(GrafPort.portRect.botRight,A3)
                MOVE.L  (GrafPort.visRgn,A3),-(SP)
                PEA     (GrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (BitMap.bounds,A2)
                PEA     (BitMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (BitMap.baseAddr,A2),(srcPtr,A6)
                MOVE.L  (stripPtr,A6),(dstPtr,A6)
                MOVE    (BitMap.bounds.bottom,A2),D3
                SUB     (BitMap.bounds.top,A2),D3
                BRA.S   @14
@13             PEA     (srcPtr,A6)
                PEA     (dstPtr,A6)
                MOVE    (bytesPerRow,A6),-(SP)
                BSR     PackBits
                ADD.L   D4,(srcPtr,A6)
@14             DBRA    D3,@13
                MOVE.L  (stripPtr,A6),A1
                MOVE.L  (dstPtr,A6),D6
                SUB.L   A1,D6
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D6,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  D7,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @16
                MOVE.L  (stripOffsets,A6),A0
                MOVE.L  D7,(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                MOVE.L  (stripByteCounts,A6),A0
                MOVE    D6,(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D6,D7
                MOVE.L  (srcRect,A6),A0
                MOVE    (BitMap.bounds.bottom,A2),(BitMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(BitMap.bounds.bottom,A2)
                BRA     @11

@15             MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  (headerPtr,A6),(ParamBlockRec.ioBuffer,A0)
                MOVE.L  (headerSize,A6),(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @21
                MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @25
                _PBFlushVolSync
                BNE.S   @27
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@16             MOVE    D0,(Result,A6)
                MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @18

@17             MOVE    D0,(Result,A6)
@18             MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @20

@19             MOVE    D0,(Result,A6)
@20             MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                BRA.S   @22

@21             MOVE    D0,(Result,A6)
@22             MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                BRA.S   @24

@23             MOVE    D0,(Result,A6)
@24             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @26

@25             MOVE    D0,(Result,A6)
@26             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @28

@27             MOVE    D0,(Result,A6)
@28             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@29             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
                MACHINE MC68020
;———————————————————————————————————————————————————————————————
; PROCEDURE LZWCompress (srcPtr,dstPtr: Ptr; VAR bytes: INTEGER; storage: Ptr);
;———————————————————————————————————————————————————————————————
LZWCompress     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
srcPtr          DS.L    1
dstPtr          DS.L    1
bytes           DS.L    1
storage         DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (storage,A6),A4
                MOVE.L  (dstPtr,A6),A3
                MOVE.L  (srcPtr,A6),A2
                MOVE.L  (bytes,A6),A0
                MOVE    (A0),D7
                MOVEQ   #0,D6
                MOVEQ   #9,D5
                MOVEQ   #-1,D1
                BRA.S   @3
@0              MOVEQ   #0,D1
                MOVE.B  (A2)+,D1
                TST     D2
                BMI.S   @5
                MOVE    (4,A4,D2*8),D0
                BMI.S   @2
@1              CMP     (2,A4,D0*8),D1
                BEQ.S   @6
                MOVE    (6,A4,D0*8),D0
                BPL.S   @1
@2              BFINS   D2,(A3){D6:D5}
                ADD.L   D5,D6
                CMP     #4094,D3
                BHS.S   @3
                MOVE    (4,A4,D2*8),D0
                MOVE    D3,(4,A4,D2*8)
                MOVE    D2,(0,A4,D3*8)
                MOVE    D1,(2,A4,D3*8)
                MOVE    #-1,(4,A4,D3*8)
                MOVE    D0,(6,A4,D3*8)
                ADDQ    #1,D3
                CMP     D4,D3
                BLO.S   @5
                ADDQ.L  #1,D5
                ADD     D4,D4
                BRA.S   @5
@3              MOVE    #256,D0
                BFINS   D0,(A3){D6:D5}
                ADD.L   D5,D6
                MOVE.L  A4,A0
                MOVEQ   #0,D3
                MOVEQ   #-1,D0
@4              MOVE    D0,(A0)+
                MOVE    D3,(A0)+
                MOVE.L  D0,(A0)+
                ADDQ    #1,D3
                CMP     #258,D3
                BLO.S   @4
                MOVEQ   #9,D5
                MOVE    #512,D4
@5              MOVE    D1,D2
                BRA.S   @7
@6              MOVE    D0,D2
@7              DBRA    D7,@0
                TST     D2
                BMI.S   @8
                BFINS   D2,(A3){D6:D5}
                ADD.L   D5,D6
                ADDQ    #1,D3
                CMP     D4,D3
                BLO.S   @8
                ADDQ.L  #1,D5
@8              MOVE    #257,D0
                BFINS   D0,(A3){D6:D5}
                ADD.L   D5,D6
                BFCLR   (A3){D6:7}
                ADDQ.L  #7,D6
                LSR.L   #3,D6
                MOVE.L  (bytes,A6),A0
                MOVE    D6,(A0)
Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTD     #ParamSize

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION GetTIFF40P (srcPort: CGrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetTIFF40P      FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
volume          DS.W    1
imageWidth      DS.W    1
imageLength     DS.W    1
pixelSize       DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
stripsPerImage  DS.L    1
bitsPerSample   DS.L    1
stripOffsets    DS.L    1
stripByteCounts DS.L    1
minSampleValue  DS.L    1
maxSampleValue  DS.L    1
hResolution     DS.L    1
xResolution     DS.L    1
vResolution     DS.L    1
yResolution     DS.L    1
stripPtr        DS.L    1
colTable        DS.L    1
headerPtr       DS.L    1
headerSize      DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
folder          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @30
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @40

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @40
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@40             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @28
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @28

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @28
                BRA.S   @4

@2              MOVE.L  (nameTIFF,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @28
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @26
                MOVE.L  #'TIFF',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applTIFF4.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @26
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @26

                SUBQ.L  #4,SP
                _GetGDevice
                MOVE.L  (SP)+,A0
                MOVE.L  (A0),A0
                MOVE.L  (GDevice.gdPMap,A0),A0
                MOVE.L  (A0),A0
                MOVE    (PixMap.pixelSize,A0),(pixelSize,A6)
                MOVE.L  (PixMap.hRes,A0),(hResolution,A6)
                MOVE.L  (PixMap.vRes,A0),(vResolution,A6)
                MOVE.L  (PixMap.pmTable,A0),(colTable,A6)

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #8*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                MULU    #3,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @5
                MOVEQ   #1,D0
@5              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @6
                MOVE    D1,D0
@6              MOVE    D0,(rowsPerStrip,A6)
                ADD     D0,D1
                SUBQ    #1,D1
                AND.L   #$0000FFFF,D1
                DIVU    D0,D1
                AND.L   #$0000FFFF,D1
                MOVE.L  D1,(stripsPerImage,A6)
                MOVE.L  #8+2+(18*12)+4+6+6+6+8+8,D0
                LSL.L   #2,D1
                CMP.L   #4,D1
                BLS.S   @7
                ADD.L   D1,D0
                ADD.L   D1,D0
@7              _NewPtrClear
                BNE     @24
                MOVE.L  A0,A3

; Image File Header

                MOVE    #'MM',(A0)+
                MOVE    #42,(A0)+
                MOVE.L  #8,(A0)+

; Image File Directory

                MOVE    #18,(A0)+

; SubfileType

                MOVE    #255,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; ImageWidth

                MOVE    #256,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageWidth,A6),(A0)+
                ADDQ.L  #2,A0

; ImageLength

                MOVE    #257,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageLength,A6),(A0)+
                ADDQ.L  #2,A0

; BitsPerSample

                MOVE    #258,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #3,(A0)+
                MOVE.L  A0,(bitsPerSample,A6)
                ADDQ.L  #4,A0

; Compression

                MOVE    #259,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; PhotometricInterpretation

                MOVE    #262,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; FillOrder

                MOVE    #266,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; StripOffsets

                MOVE    #273,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                ADDQ.L  #4,A0

; Orientation

                MOVE    #274,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; SamplesPerPixel

                MOVE    #277,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #3,(A0)+
                ADDQ.L  #2,A0

; RowsPerStrip

                MOVE    #278,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  #1,(A0)+
                CLR     (A0)+
                MOVE    (rowsPerStrip,A6),(A0)+

; StripByteCounts

                MOVE    #279,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADDQ.L  #4,A0

; MinSampleValue

                MOVE    #280,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #3,(A0)+
                MOVE.L  A0,(minSampleValue,A6)
                ADDQ.L  #4,A0

; MaxSampleValue

                MOVE    #281,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #3,(A0)+
                MOVE.L  A0,(maxSampleValue,A6)
                ADDQ.L  #4,A0

; XResolution

                MOVE    #282,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(xResolution,A6)
                ADDQ.L  #4,A0

; YResolution

                MOVE    #283,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(yResolution,A6)
                ADDQ.L  #4,A0

; PlanarConfiguration

                MOVE    #284,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; ResolutionUnit

                MOVE    #296,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; no more IFDs

                MOVE.L  #NIL,(A0)+

; BitsPerSample

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (bitsPerSample,A6),A1
                MOVE.L  D1,(A1)
                MOVE    #8,(A0)+
                MOVE    #8,(A0)+
                MOVE    #8,(A0)+

; StripOffsets

                MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @8
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripOffsets,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripOffsets,A6)
                ADD.L   D0,A0

; StripByteCounts

@8              MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @9
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripByteCounts,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D0,A0

; MinSampleValue

@9              MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (minSampleValue,A6),A1
                MOVE.L  D1,(A1)
                MOVE    #0,(A0)+
                MOVE    #0,(A0)+
                MOVE    #0,(A0)+

; MaxSampleValue

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (maxSampleValue,A6),A1
                MOVE.L  D1,(A1)
                MOVE    #255,(A0)+
                MOVE    #255,(A0)+
                MOVE    #255,(A0)+

; XResolution

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (xResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (hResolution,A6),D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; YResolution

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (yResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (vResolution,A6),D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; Strips

                SUB.L   A3,A0
                MOVE.L  A3,(headerPtr,A6)
                MOVE.L  A0,(headerSize,A6)

                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtr
                BNE     @22
                MOVE.L  A0,(stripPtr,A6)

                MOVEQ   #CGrafPort.sizeof,D0
                _NewPtr
                BNE     @20
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenCPort
                MOVE.L  (CGrafPort.portPixMap,A3),A0
                _MoveHHi
                BNE     @18
                _HLock
                BNE     @18
                MOVE.L  (A0),A2
                MOVE    (imageWidth,A6),D0
                MULU    (pixelSize,A6),D0
                ADD.L   #15,D0
                LSR.L   #4,D0
                ADD     D0,D0
                MOVE    D0,D5
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @18
                MOVE.L  A0,(PixMap.baseAddr,A2)
                MOVE    D5,D0
                AND     #$1FFF,D0
                OR      #$8000,D0
                MOVE    D0,(PixMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(PixMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(PixMap.bounds.botRight,A2)
                MOVE.L  (hResolution,A6),(PixMap.hRes,A2)
                MOVE.L  (vResolution,A6),(PixMap.vRes,A2)
                MOVE    #chunky,(PixMap.pixelType,A2)
                MOVE    (pixelSize,A6),(PixMap.pixelSize,A2)
                MOVE    #1,(PixMap.cmpCount,A2)
                MOVE    (pixelSize,A6),(PixMap.cmpSize,A2)
                MOVE.L  (colTable,A6),(PixMap.pmTable,A2)

                MOVE.L  (headerSize,A6),D7
                AND.L   #$0000FFFF,D5

@10             SUBQ.L  #2,SP
                PEA     (PixMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @16
                MOVE    (PixMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (PixMap.bounds.bottom,A2),D0
                BGE.S   @11
                MOVE    D0,(PixMap.bounds.bottom,A2)
@11             MOVE.L  (PixMap.bounds.topLeft,A2),(CGrafPort.portRect.topLeft,A3)
                MOVE.L  (PixMap.bounds.botRight,A2),(CGrafPort.portRect.botRight,A3)
                MOVE.L  (CGrafPort.visRgn,A3),-(SP)
                PEA     (CGrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (PixMap.bounds,A2)
                PEA     (PixMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (PixMap.baseAddr,A2),A1
                MOVE.L  (stripPtr,A6),A0
                MOVE    (PixMap.bounds.bottom,A2),D4
                SUB     (PixMap.bounds.top,A2),D4
                MOVE.L  A2,-(SP)
                MOVE.L  (colTable,A6),A2
                MOVE.L  (A2),A2
                MOVEQ   #0,D1
                MOVE    (pixelSize,A6),D1
                BRA.S   @15
@12             MOVE    (imageWidth,A6),D3
                MOVEQ   #0,D2
                BRA.S   @14
@13             BFEXTU  (A1){D2:D1},D0
                ADD.L   D1,D2
                MOVE.B  (ColorTable.ctTable+ColorSpec.rgb.red,A2,D0.L*8),(A0)+
                MOVE.B  (ColorTable.ctTable+ColorSpec.rgb.green,A2,D0.L*8),(A0)+
                MOVE.B  (ColorTable.ctTable+ColorSpec.rgb.blue,A2,D0.L*8),(A0)+
@14             DBRA    D3,@13
                ADD.L   D5,A1
@15             DBRA    D4,@12
                MOVE.L  (SP)+,A2
                MOVE.L  (stripPtr,A6),A1
                MOVE.L  A0,D6
                SUB.L   A1,D6
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D6,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  D7,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @17
                MOVE.L  (stripOffsets,A6),A0
                MOVE.L  D7,(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                MOVE.L  (stripByteCounts,A6),A0
                MOVE.L  D6,(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D6,D7
                MOVE.L  (srcRect,A6),A0
                MOVE    (PixMap.bounds.bottom,A2),(PixMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(PixMap.bounds.bottom,A2)
                BRA     @10

@16             MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  (headerPtr,A6),(ParamBlockRec.ioBuffer,A0)
                MOVE.L  (headerSize,A6),(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @22
                MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @26
                _PBFlushVolSync
                BNE.S   @28
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@17             MOVE    D0,(Result,A6)
                MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @19

@18             MOVE    D0,(Result,A6)
@19             MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @21

@20             MOVE    D0,(Result,A6)
@21             MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                BRA.S   @23

@22             MOVE    D0,(Result,A6)
@23             MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                BRA.S   @25

@24             MOVE    D0,(Result,A6)
@25             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @27

@26             MOVE    D0,(Result,A6)
@27             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @29

@28             MOVE    D0,(Result,A6)
@29             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@30             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTD     #ParamSize

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetTIFF50P (srcPort: CGrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetTIFF50P      FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
volume          DS.W    1
bytes           DS.W    1
imageWidth      DS.W    1
imageLength     DS.W    1
bitsPerSample   DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
stripsPerImage  DS.L    1
stripOffsets    DS.L    1
stripByteCounts DS.L    1
hResolution     DS.L    1
xResolution     DS.L    1
vResolution     DS.L    1
yResolution     DS.L    1
software        DS.L    1
dateTime        DS.L    1
storage         DS.L    1
bufferPtr       DS.L    1
stripPtr        DS.L    1
colTable        DS.L    1
colorMap        DS.L    1
headerPtr       DS.L    1
headerSize      DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
folder          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @38
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @40

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @40
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@40             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @36
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @36

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @36
                BRA.S   @4

@2              MOVE.L  (nameTIFF,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @36
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @34
                MOVE.L  #'TIFF',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applTIFF5.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @34
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @34

                SUBQ.L  #4,SP
                _GetGDevice
                MOVE.L  (SP)+,A0
                MOVE.L  (A0),A0
                MOVE.L  (GDevice.gdPMap,A0),A0
                MOVE.L  (A0),A0
                MOVE    (PixMap.pixelSize,A0),(bitsPerSample,A6)
                MOVE.L  (PixMap.hRes,A0),(hResolution,A6)
                MOVE.L  (PixMap.vRes,A0),(vResolution,A6)
                MOVE.L  (PixMap.pmTable,A0),(colTable,A6)

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #8*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                MULU    (bitsPerSample,A6),D1
                ADDQ.L  #7,D1
                LSR.L   #3,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @5
                MOVEQ   #1,D0
@5              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @6
                MOVE    D1,D0
@6              MOVE    D0,(rowsPerStrip,A6)
                ADD     D0,D1
                SUBQ    #1,D1
                AND.L   #$0000FFFF,D1
                DIVU    D0,D1
                AND.L   #$0000FFFF,D1
                MOVE.L  D1,(stripsPerImage,A6)
                MOVE.L  #8+2+(16*12)+4+8+8+12+20,D0
                ADD.L   D1,D1
                CMP.L   #4,D1
                BLS.S   @7
                ADD.L   D1,D0
@7              ADD.L   D1,D1
                CMP.L   #4,D1
                BLS.S   @8
                ADD.L   D1,D0
@8              MOVEQ   #3*2,D1
                MOVE    (bitsPerSample,A6),D2
                LSL.L   D2,D1
                ADD.L   D1,D0
                _NewPtrClear
                BNE     @32
                MOVE.L  A0,A3

; Image File Header

                MOVE    #'MM',(A0)+
                MOVE    #42,(A0)+
                MOVE.L  #8,(A0)+

; Image File Directory

                MOVE    #16,(A0)+

; NewSubfileType

                MOVE    #254,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  #$00000000,(A0)+

; ImageWidth

                MOVE    #256,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageWidth,A6),(A0)+
                ADDQ.L  #2,A0

; ImageLength

                MOVE    #257,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageLength,A6),(A0)+
                ADDQ.L  #2,A0

; BitsPerSample

                MOVE    #258,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (bitsPerSample,A6),(A0)+
                ADDQ.L  #2,A0

; Compression

                MOVE    #259,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #5,(A0)+
                ADDQ.L  #2,A0

; PhotometricInterpretation

                MOVE    #262,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #3,(A0)+
                ADDQ.L  #2,A0

; StripOffsets

                MOVE    #273,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                ADDQ.L  #4,A0

; SamplesPerPixel

                MOVE    #277,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; RowsPerStrip

                MOVE    #278,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (rowsPerStrip,A6),(A0)+
                ADDQ.L  #2,A0

; StripByteCounts

                MOVE    #279,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADDQ.L  #4,A0

; XResolution

                MOVE    #282,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(xResolution,A6)
                ADDQ.L  #4,A0

; YResolution

                MOVE    #283,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(yResolution,A6)
                ADDQ.L  #4,A0

; ResolutionUnit

                MOVE    #296,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; Software

                MOVE    #305,(A0)+
                MOVE    #2,(A0)+
                MOVE.L  #12,(A0)+
                MOVE.L  A0,(software,A6)
                ADDQ.L  #4,A0

; DateTime

                MOVE    #306,(A0)+
                MOVE    #2,(A0)+
                MOVE.L  #20,(A0)+
                MOVE.L  A0,(dateTime,A6)
                ADDQ.L  #4,A0

; ColorMap

                MOVE    #320,(A0)+
                MOVE    #3,(A0)+
                MOVEQ   #3,D0
                MOVE    (bitsPerSample,A6),D1
                LSL.L   D1,D0
                MOVE.L  D0,(A0)+
                MOVE.L  A0,(colorMap,A6)
                ADDQ.L  #4,A0

; no more IFDs

                MOVE.L  #NIL,(A0)+

; StripOffsets

                MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @9
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripOffsets,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripOffsets,A6)
                ADD.L   D0,A0

; StripByteCounts

@9              MOVE.L  (stripsPerImage,A6),D0
                ADD.L   D0,D0
                CMP.L   #4,D0
                BLS.S   @10
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripByteCounts,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D0,A0

; XResolution

@10             MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (xResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (hResolution,A6),D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; YResolution

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (yResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (vResolution,A6),D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; Software

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (software,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  #'Capt',(A0)+
                MOVE.L  #'ure ',(A0)+
                MOVE.L  #$342E3600,(A0)+

; DateTime

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (dateTime,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (Time),D0
                BSR     Secs2DateTime

; ColorMap

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (colorMap,A6),A1
                MOVE.L  D1,(A1)

                MOVEQ   #2,D7
                MOVE    (bitsPerSample,A6),D0
                LSL.L   D0,D7
                MOVE.L  (colTable,A6),A1
                MOVE.L  (A1),A1
                MOVE    (ColorTable.ctSize,A1),D6
                LEA     (ColorTable.ctTable,A1),A1
                MOVE.L  A1,D5

                MOVE.L  A0,A1
                MOVE.L  D5,A2
                MOVE    D6,D0
@11             MOVE    (ColorSpec.rgb.red,A2),(A1)+
                ADDQ.L  #ColorSpec.sizeof,A2
                DBRA    D0,@11
                ADD.L   D7,A0

                MOVE.L  A0,A1
                MOVE.L  D5,A2
                MOVE    D6,D0
@12             MOVE    (ColorSpec.rgb.green,A2),(A1)+
                ADDQ.L  #ColorSpec.sizeof,A2
                DBRA    D0,@12
                ADD.L   D7,A0

                MOVE.L  A0,A1
                MOVE.L  D5,A2
                MOVE    D6,D0
@13             MOVE    (ColorSpec.rgb.blue,A2),(A1)+
                ADDQ.L  #ColorSpec.sizeof,A2
                DBRA    D0,@13
                ADD.L   D7,A0

; Strips

                SUB.L   A3,A0
                MOVE.L  A3,(headerPtr,A6)
                MOVE.L  A0,(headerSize,A6)

                MOVE.L  #4096*8,D0
                _NewPtr
                BNE     @30
                MOVE.L  A0,(storage,A6)

                MOVE.L  #11431,D0
                _NewPtr
                BNE     @28
                MOVE.L  A0,(bufferPtr,A6)

                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtr
                BNE     @26
                MOVE.L  A0,(stripPtr,A6)

                MOVEQ   #CGrafPort.sizeof,D0
                _NewPtr
                BNE     @24
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenCPort
                MOVE.L  (CGrafPort.portPixMap,A3),A0
                _MoveHHi
                BNE     @22
                _HLock
                BNE     @22
                MOVE.L  (A0),A2
                MOVE    (imageWidth,A6),D0
                MULU    (bitsPerSample,A6),D0
                ADD.L   #15,D0
                LSR.L   #4,D0
                ADD     D0,D0
                MOVE    D0,D5
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @22
                MOVE.L  A0,(PixMap.baseAddr,A2)
                MOVE    D5,D0
                AND     #$1FFF,D0
                OR      #$8000,D0
                MOVE    D0,(PixMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(PixMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(PixMap.bounds.botRight,A2)
                MOVE.L  (hResolution,A6),(PixMap.hRes,A2)
                MOVE.L  (vResolution,A6),(PixMap.vRes,A2)
                MOVE    #chunky,(PixMap.pixelType,A2)
                MOVE    (bitsPerSample,A6),(PixMap.pixelSize,A2)
                MOVE    #1,(PixMap.cmpCount,A2)
                MOVE    (bitsPerSample,A6),(PixMap.cmpSize,A2)
                MOVE.L  (colTable,A6),(PixMap.pmTable,A2)

                MOVE.L  (headerSize,A6),D7
                SUB     (bytesPerRow,A6),D5
                AND.L   #$0000FFFF,D5

@14             SUBQ.L  #2,SP
                PEA     (PixMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @20
                MOVE    (PixMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (PixMap.bounds.bottom,A2),D0
                BGE.S   @15
                MOVE    D0,(PixMap.bounds.bottom,A2)
@15             MOVE.L  (PixMap.bounds.topLeft,A2),(CGrafPort.portRect.topLeft,A3)
                MOVE.L  (PixMap.bounds.botRight,A2),(CGrafPort.portRect.botRight,A3)
                MOVE.L  (CGrafPort.visRgn,A3),-(SP)
                PEA     (CGrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (PixMap.bounds,A2)
                PEA     (PixMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (stripPtr,A6),A1
                MOVE.L  (PixMap.baseAddr,A2),A0
                MOVE    (PixMap.bounds.bottom,A2),D1
                SUB     (PixMap.bounds.top,A2),D1
                BRA.S   @19
@16             MOVE    (bytesPerRow,A6),D0
                BRA.S   @18
@17             MOVE.B  (A0)+,(A1)+
@18             DBRA    D0,@17
                ADD.L   D5,A0
@19             DBRA    D1,@16
                SUB.L   (stripPtr,A6),A1
                MOVE    A1,(bytes,A6)
                MOVE.L  (stripPtr,A6),-(SP)
                MOVE.L  (bufferPtr,A6),-(SP)
                PEA     (bytes,A6)
                MOVE.L  (storage,A6),-(SP)
                BSR     LZWCompress
                MOVE.L  (bufferPtr,A6),A1
                MOVEQ   #0,D6
                MOVE    (bytes,A6),D6
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D6,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  D7,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE     @21
                MOVE.L  (stripOffsets,A6),A0
                MOVE.L  D7,(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                MOVE.L  (stripByteCounts,A6),A0
                MOVE    D6,(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D6,D7
                MOVE.L  (srcRect,A6),A0
                MOVE    (PixMap.bounds.bottom,A2),(PixMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(PixMap.bounds.bottom,A2)
                BRA     @14

@20             MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                MOVE.L  (bufferPtr,A6),A0
                _DisposePtr
                MOVE.L  (storage,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  (headerPtr,A6),(ParamBlockRec.ioBuffer,A0)
                MOVE.L  (headerSize,A6),(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @30
                MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @34
                _PBFlushVolSync
                BNE.S   @36
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@21             MOVE    D0,(Result,A6)
                MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @23

@22             MOVE    D0,(Result,A6)
@23             MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @25

@24             MOVE    D0,(Result,A6)
@25             MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                BRA.S   @27

@26             MOVE    D0,(Result,A6)
@27             MOVE.L  (bufferPtr,A6),A0
                _DisposePtr
                BRA.S   @29

@28             MOVE    D0,(Result,A6)
@29             MOVE.L  (storage,A6),A0
                _DisposePtr
                BRA.S   @31

@30             MOVE    D0,(Result,A6)
@31             MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                BRA.S   @33

@32             MOVE    D0,(Result,A6)
@33             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @35

@34             MOVE    D0,(Result,A6)
@35             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @37

@36             MOVE    D0,(Result,A6)
@37             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@38             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTD     #ParamSize

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetTIFF40R (srcPort: CGrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetTIFF40R      FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
volume          DS.W    1
imageWidth      DS.W    1
imageLength     DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
stripsPerImage  DS.L    1
bitsPerSample   DS.L    1
stripOffsets    DS.L    1
stripByteCounts DS.L    1
minSampleValue  DS.L    1
maxSampleValue  DS.L    1
hResolution     DS.L    1
xResolution     DS.L    1
vResolution     DS.L    1
yResolution     DS.L    1
stripPtr        DS.L    1
headerPtr       DS.L    1
headerSize      DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
folder          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @32
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @40

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @40
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@40             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @30
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @30

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @30
                BRA.S   @4

@2              MOVE.L  (nameTIFF,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @30
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @28
                MOVE.L  #'TIFF',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applTIFF4.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @28
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @28

                SUBQ.L  #4,SP
                _GetGDevice
                MOVE.L  (SP)+,A0
                MOVE.L  (A0),A0
                MOVE.L  (GDevice.gdPMap,A0),A0
                MOVE.L  (A0),A0
                MOVE.L  (PixMap.hRes,A0),(hResolution,A6)
                MOVE.L  (PixMap.vRes,A0),(vResolution,A6)

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #8*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                MULU    #3,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @5
                MOVEQ   #1,D0
@5              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @6
                MOVE    D1,D0
@6              MOVE    D0,(rowsPerStrip,A6)
                ADD     D0,D1
                SUBQ    #1,D1
                AND.L   #$0000FFFF,D1
                DIVU    D0,D1
                AND.L   #$0000FFFF,D1
                MOVE.L  D1,(stripsPerImage,A6)
                MOVE.L  #8+2+(18*12)+4+6+6+6+8+8,D0
                LSL.L   #2,D1
                CMP.L   #4,D1
                BLS.S   @7
                ADD.L   D1,D0
                ADD.L   D1,D0
@7              _NewPtrClear
                BNE     @26
                MOVE.L  A0,A3

; Image File Header

                MOVE    #'MM',(A0)+
                MOVE    #42,(A0)+
                MOVE.L  #8,(A0)+

; Image File Directory

                MOVE    #18,(A0)+

; SubfileType

                MOVE    #255,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; ImageWidth

                MOVE    #256,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageWidth,A6),(A0)+
                ADDQ.L  #2,A0

; ImageLength

                MOVE    #257,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageLength,A6),(A0)+
                ADDQ.L  #2,A0

; BitsPerSample

                MOVE    #258,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #3,(A0)+
                MOVE.L  A0,(bitsPerSample,A6)
                ADDQ.L  #4,A0

; Compression

                MOVE    #259,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; PhotometricInterpretation

                MOVE    #262,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; FillOrder

                MOVE    #266,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; StripOffset

                MOVE    #273,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                ADDQ.L  #4,A0

; Orientation

                MOVE    #274,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; SamplesPerPixel

                MOVE    #277,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #3,(A0)+
                ADDQ.L  #2,A0

; RowsPerStrip

                MOVE    #278,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  #1,(A0)+
                CLR     (A0)+
                MOVE    (rowsPerStrip,A6),(A0)+

; StripByteCounts

                MOVE    #279,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADDQ.L  #4,A0

; MinSampleValue

                MOVE    #280,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #3,(A0)+
                MOVE.L  A0,(minSampleValue,A6)
                ADDQ.L  #4,A0

; MaxSampleValue

                MOVE    #281,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #3,(A0)+
                MOVE.L  A0,(maxSampleValue,A6)
                ADDQ.L  #4,A0

; XResolution

                MOVE    #282,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(xResolution,A6)
                ADDQ.L  #4,A0

; YResolution

                MOVE    #283,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(yResolution,A6)
                ADDQ.L  #4,A0

; PlanarConfiguration

                MOVE    #284,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; ResolutionUnit

                MOVE    #296,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; no more IFDs

                MOVE.L  #NIL,(A0)+

; BitsPerSample

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (bitsPerSample,A6),A1
                MOVE.L  D1,(A1)
                MOVE    #8,(A0)+
                MOVE    #8,(A0)+
                MOVE    #8,(A0)+

; StripOffsets

                MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @8
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripOffsets,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripOffsets,A6)
                ADD.L   D0,A0

; StripByteCounts

@8              MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @9
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripByteCounts,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D0,A0

; MinSampleValue

@9              MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (minSampleValue,A6),A1
                MOVE.L  D1,(A1)
                MOVE    #0,(A0)+
                MOVE    #0,(A0)+
                MOVE    #0,(A0)+

; MaxSampleValue

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (maxSampleValue,A6),A1
                MOVE.L  D1,(A1)
                MOVE    #255,(A0)+
                MOVE    #255,(A0)+
                MOVE    #255,(A0)+

; XResolution

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (xResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (hResolution,A6),D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; YResolution

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (yResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (vResolution,A6),D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; Strips

                SUB.L   A3,A0
                MOVE.L  A3,(headerPtr,A6)
                MOVE.L  A0,(headerSize,A6)

                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtr
                BNE     @24
                MOVE.L  A0,(stripPtr,A6)

                MOVEQ   #CGrafPort.sizeof,D0
                _NewPtr
                BNE     @22
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenCPort
                MOVE.L  (CGrafPort.portPixMap,A3),A0
                _MoveHHi
                BNE     @20
                _HLock
                BNE     @20
                MOVE.L  (A0),A2
                MOVE    (imageWidth,A6),D0
                LSL     #2,D0
                MOVE    D0,D5
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @20
                MOVE.L  A0,(PixMap.baseAddr,A2)
                OR      #$8000,D5
                MOVE    D5,(PixMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(PixMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(PixMap.bounds.botRight,A2)
                MOVE.L  (hResolution,A6),(PixMap.hRes,A2)
                MOVE.L  (vResolution,A6),(PixMap.vRes,A2)
                MOVE    #RGBDirect,(PixMap.pixelType,A2)
                MOVE    #32,(PixMap.pixelSize,A2)
                MOVE    #3,(PixMap.cmpCount,A2)
                MOVE    #8,(PixMap.cmpSize,A2)
                MOVEQ   #ColorTable.sizeof-ColorSpec.sizeof,D0
                _NewHandleClear
                BNE     @18
                MOVE.L  A0,(PixMap.pmTable,A2)
                MOVE.L  (A0),A0
                MOVE.L  #8*3,(ColorTable.ctSeed,A0)

                MOVE.L  (headerSize,A6),D7

@10             SUBQ.L  #2,SP
                PEA     (PixMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @16
                MOVE    (PixMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (PixMap.bounds.bottom,A2),D0
                BGE.S   @11
                MOVE    D0,(PixMap.bounds.bottom,A2)
@11             MOVE.L  (PixMap.bounds.topLeft,A2),(CGrafPort.portRect.topLeft,A3)
                MOVE.L  (PixMap.bounds.botRight,A2),(CGrafPort.portRect.botRight,A3)
                MOVE.L  (CGrafPort.visRgn,A3),-(SP)
                PEA     (CGrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (PixMap.bounds,A2)
                PEA     (PixMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (PixMap.baseAddr,A2),A1
                MOVE.L  (stripPtr,A6),A0
                MOVE    (PixMap.bounds.bottom,A2),D3
                SUB     (PixMap.bounds.top,A2),D3
                BRA.S   @15
@12             MOVE    (imageWidth,A6),D2
                BRA.S   @14
@13             ADDQ.L  #1,A1
                MOVE.B  (A1)+,(A0)+
                MOVE.B  (A1)+,(A0)+
                MOVE.B  (A1)+,(A0)+
@14             DBRA    D2,@13
@15             DBRA    D3,@12
                MOVE.L  (stripPtr,A6),A1
                MOVE.L  A0,D6
                SUB.L   A1,D6
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D6,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  D7,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE     @17
                MOVE.L  (stripOffsets,A6),A0
                MOVE.L  D7,(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                MOVE.L  (stripByteCounts,A6),A0
                MOVE.L  D6,(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D6,D7
                MOVE.L  (srcRect,A6),A0
                MOVE    (PixMap.bounds.bottom,A2),(PixMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(PixMap.bounds.bottom,A2)
                BRA     @10

@16             MOVE.L  (PixMap.pmTable,A2),A0
                _DisposeHandle
                MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  (headerPtr,A6),(ParamBlockRec.ioBuffer,A0)
                MOVE.L  (headerSize,A6),(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @24
                MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @28
                _PBFlushVolSync
                BNE.S   @30
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@17             MOVE    D0,(Result,A6)
                MOVE.L  (PixMap.pmTable,A2),A0
                _DisposeHandle
                BRA.S   @19

@18             MOVE    D0,(Result,A6)
@19             MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @21

@20             MOVE    D0,(Result,A6)
@21             MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @23

@22             MOVE    D0,(Result,A6)
@23             MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                BRA.S   @25

@24             MOVE    D0,(Result,A6)
@25             MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                BRA.S   @27

@26             MOVE    D0,(Result,A6)
@27             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @29

@28             MOVE    D0,(Result,A6)
@29             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @31

@30             MOVE    D0,(Result,A6)
@31             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@32             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTD     #ParamSize

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetTIFF50R (srcPort: CGrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GetTIFF50R      FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
volume          DS.W    1
bytes           DS.W    1
imageWidth      DS.W    1
imageLength     DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
stripsPerImage  DS.L    1
bitsPerSample   DS.L    1
stripOffsets    DS.L    1
stripByteCounts DS.L    1
hResolution     DS.L    1
xResolution     DS.L    1
vResolution     DS.L    1
yResolution     DS.L    1
software        DS.L    1
dateTime        DS.L    1
storage         DS.L    1
bufferPtr       DS.L    1
stripPtr        DS.L    1
headerPtr       DS.L    1
headerSize      DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
folder          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @37
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @40

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @40
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@40             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @35
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @35

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @35
                BRA.S   @4

@2              MOVE.L  (nameTIFF,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @35
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @33
                MOVE.L  #'TIFF',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applTIFF5.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @33
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @33

                SUBQ.L  #4,SP
                _GetGDevice
                MOVE.L  (SP)+,A0
                MOVE.L  (A0),A0
                MOVE.L  (GDevice.gdPMap,A0),A0
                MOVE.L  (A0),A0
                MOVE.L  (PixMap.hRes,A0),(hResolution,A6)
                MOVE.L  (PixMap.vRes,A0),(vResolution,A6)

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #8*1024,D0
                MOVE    (Rect.right,A0),D1
                SUB     (Rect.left,A0),D1
                MOVE    D1,(imageWidth,A6)
                MULU    #3,D1
                MOVE    D1,(bytesPerRow,A6)
                DIVU    D1,D0
                BNE.S   @5
                MOVEQ   #1,D0
@5              MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    D1,(imageLength,A6)
                CMP     D1,D0
                BLS.S   @6
                MOVE    D1,D0
@6              MOVE    D0,(rowsPerStrip,A6)
                ADD     D0,D1
                SUBQ    #1,D1
                AND.L   #$0000FFFF,D1
                DIVU    D0,D1
                AND.L   #$0000FFFF,D1
                MOVE.L  D1,(stripsPerImage,A6)
                MOVE.L  #8+2+(16*12)+4+6+8+8+12+20,D0
                ADD.L   D1,D1
                CMP.L   #4,D1
                BLS.S   @7
                ADD.L   D1,D0
@7              ADD.L   D1,D1
                CMP.L   #4,D1
                BLS.S   @8
                ADD.L   D1,D0
@8              _NewPtrClear
                BNE     @31
                MOVE.L  A0,A3

; Image File Header

                MOVE    #'MM',(A0)+
                MOVE    #42,(A0)+
                MOVE.L  #8,(A0)+

; Image File Directory

                MOVE    #16,(A0)+

; NewSubfileType

                MOVE    #254,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  #$00000000,(A0)+

; ImageWidth

                MOVE    #256,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageWidth,A6),(A0)+
                ADDQ.L  #2,A0

; ImageLength

                MOVE    #257,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (imageLength,A6),(A0)+
                ADDQ.L  #2,A0

; BitsPerSample

                MOVE    #258,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #3,(A0)+
                MOVE.L  A0,(bitsPerSample,A6)
                ADDQ.L  #4,A0

; Compression

                MOVE    #259,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #5,(A0)+
                ADDQ.L  #2,A0

; PhotometricInterpretation

                MOVE    #262,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; StripOffsets

                MOVE    #273,(A0)+
                MOVE    #4,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                ADDQ.L  #4,A0

; SamplesPerPixel

                MOVE    #277,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #3,(A0)+
                ADDQ.L  #2,A0

; RowsPerStrip

                MOVE    #278,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    (rowsPerStrip,A6),(A0)+
                ADDQ.L  #2,A0

; StripByteCounts

                MOVE    #279,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  (stripsPerImage,A6),(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADDQ.L  #4,A0

; XResolution

                MOVE    #282,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(xResolution,A6)
                ADDQ.L  #4,A0

; YResolution

                MOVE    #283,(A0)+
                MOVE    #5,(A0)+
                MOVE.L  #1,(A0)+
                MOVE.L  A0,(yResolution,A6)
                ADDQ.L  #4,A0

; PlanarConfiguration

                MOVE    #284,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #1,(A0)+
                ADDQ.L  #2,A0

; ResolutionUnit

                MOVE    #296,(A0)+
                MOVE    #3,(A0)+
                MOVE.L  #1,(A0)+
                MOVE    #2,(A0)+
                ADDQ.L  #2,A0

; Software

                MOVE    #305,(A0)+
                MOVE    #2,(A0)+
                MOVE.L  #12,(A0)+
                MOVE.L  A0,(software,A6)
                ADDQ.L  #4,A0

; DateTime

                MOVE    #306,(A0)+
                MOVE    #2,(A0)+
                MOVE.L  #20,(A0)+
                MOVE.L  A0,(dateTime,A6)
                ADDQ.L  #4,A0

; no more IFDs

                MOVE.L  #NIL,(A0)+

; BitsPerSample

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (bitsPerSample,A6),A1
                MOVE.L  D1,(A1)
                MOVE    #8,(A0)+
                MOVE    #8,(A0)+
                MOVE    #8,(A0)+

; StripOffsets

                MOVE.L  (stripsPerImage,A6),D0
                LSL.L   #2,D0
                CMP.L   #4,D0
                BLS.S   @9
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripOffsets,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripOffsets,A6)
                ADD.L   D0,A0

; StripByteCounts

@9              MOVE.L  (stripsPerImage,A6),D0
                ADD.L   D0,D0
                CMP.L   #4,D0
                BLS.S   @10
                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (stripByteCounts,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D0,A0

; XResolution

@10             MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (xResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (hResolution,A6),D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; YResolution

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (yResolution,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (vResolution,A6),D0
                MOVEQ   #100,D1
                BSR     MUL32
                MOVE    (scale,A6),D1
                BSR     DIV32
                MOVE.L  D0,(A0)+
                MOVE.L  #$00010000,(A0)+

; Software

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (software,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  #'Capt',(A0)+
                MOVE.L  #'ure ',(A0)+
                MOVE.L  #$342E3600,(A0)+

; DateTime

                MOVE.L  A0,D1
                SUB.L   A3,D1
                MOVE.L  (dateTime,A6),A1
                MOVE.L  D1,(A1)
                MOVE.L  (Time),D0
                BSR     Secs2DateTime

; Strips

                SUB.L   A3,A0
                MOVE.L  A3,(headerPtr,A6)
                MOVE.L  A0,(headerSize,A6)

                MOVE.L  #4096*8,D0
                _NewPtr
                BNE     @29
                MOVE.L  A0,(storage,A6)

                MOVE.L  #11431,D0
                _NewPtr
                BNE     @27
                MOVE.L  A0,(bufferPtr,A6)

                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtr
                BNE     @25
                MOVE.L  A0,(stripPtr,A6)

                MOVEQ   #CGrafPort.sizeof,D0
                _NewPtr
                BNE     @23
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenCPort
                MOVE.L  (CGrafPort.portPixMap,A3),A0
                _MoveHHi
                BNE     @21
                _HLock
                BNE     @21
                MOVE.L  (A0),A2
                MOVE    (imageWidth,A6),D0
                LSL     #2,D0
                MOVE    D0,D5
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @21
                MOVE.L  A0,(PixMap.baseAddr,A2)
                OR      #$8000,D5
                MOVE    D5,(PixMap.rowBytes,A2)
                MOVE.L  (srcRect,A6),A0
                MOVE.L  (Rect.topLeft,A0),(PixMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(PixMap.bounds.botRight,A2)
                MOVE.L  (hResolution,A6),(PixMap.hRes,A2)
                MOVE.L  (vResolution,A6),(PixMap.vRes,A2)
                MOVE    #RGBDirect,(PixMap.pixelType,A2)
                MOVE    #32,(PixMap.pixelSize,A2)
                MOVE    #3,(PixMap.cmpCount,A2)
                MOVE    #8,(PixMap.cmpSize,A2)
                MOVEQ   #ColorTable.sizeof-ColorSpec.sizeof,D0
                _NewHandleClear
                BNE     @19
                MOVE.L  A0,(PixMap.pmTable,A2)
                MOVE.L  (A0),A0
                MOVE.L  #8*3,(ColorTable.ctSeed,A0)

                MOVE.L  (headerSize,A6),D7

@11             SUBQ.L  #2,SP
                PEA     (PixMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @17
                MOVE    (PixMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (PixMap.bounds.bottom,A2),D0
                BGE.S   @12
                MOVE    D0,(PixMap.bounds.bottom,A2)
@12             MOVE.L  (PixMap.bounds.topLeft,A2),(CGrafPort.portRect.topLeft,A3)
                MOVE.L  (PixMap.bounds.botRight,A2),(CGrafPort.portRect.botRight,A3)
                MOVE.L  (CGrafPort.visRgn,A3),-(SP)
                PEA     (CGrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                PEA     (PixMap.bounds,A2)
                PEA     (PixMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (stripPtr,A6),A1
                MOVE.L  (PixMap.baseAddr,A2),A0
                MOVE    (PixMap.bounds.bottom,A2),D1
                SUB     (PixMap.bounds.top,A2),D1
                BRA.S   @16
@13             MOVE    (imageWidth,A6),D0
                BRA.S   @15
@14             ADDQ.L  #1,A0
                MOVE.B  (A0)+,(A1)+
                MOVE.B  (A0)+,(A1)+
                MOVE.B  (A0)+,(A1)+
@15             DBRA    D0,@14
@16             DBRA    D1,@13
                SUB.L   (stripPtr,A6),A1
                MOVE    A1,(bytes,A6)
                MOVE.L  (stripPtr,A6),-(SP)
                MOVE.L  (bufferPtr,A6),-(SP)
                PEA     (bytes,A6)
                MOVE.L  (storage,A6),-(SP)
                BSR     LZWCompress
                MOVE.L  (bufferPtr,A6),A1
                MOVEQ   #0,D6
                MOVE    (bytes,A6),D6
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D6,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  D7,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE     @18
                MOVE.L  (stripOffsets,A6),A0
                MOVE.L  D7,(A0)+
                MOVE.L  A0,(stripOffsets,A6)
                MOVE.L  (stripByteCounts,A6),A0
                MOVE    D6,(A0)+
                MOVE.L  A0,(stripByteCounts,A6)
                ADD.L   D6,D7
                MOVE.L  (srcRect,A6),A0
                MOVE    (PixMap.bounds.bottom,A2),(PixMap.bounds.top,A2)
                MOVE    (Rect.bottom,A0),(PixMap.bounds.bottom,A2)
                BRA     @11

@17             MOVE.L  (PixMap.pmTable,A2),A0
                _DisposeHandle
                MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                MOVE.L  (bufferPtr,A6),A0
                _DisposePtr
                MOVE.L  (storage,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  (headerPtr,A6),(ParamBlockRec.ioBuffer,A0)
                MOVE.L  (headerSize,A6),(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @29
                MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BNE.S   @33
                _PBFlushVolSync
                BNE     @35
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA     Exit

@18             MOVE    D0,(Result,A6)
                MOVE.L  (PixMap.pmTable,A2),A0
                _DisposeHandle
                BRA.S   @20

@19             MOVE    D0,(Result,A6)
@20             MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                BRA.S   @22

@21             MOVE    D0,(Result,A6)
@22             MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @24

@23             MOVE    D0,(Result,A6)
@24             MOVE.L  (stripPtr,A6),A0
                _DisposePtr
                BRA.S   @26

@25             MOVE    D0,(Result,A6)
@26             MOVE.L  (bufferPtr,A6),A0
                _DisposePtr
                BRA.S   @28

@27             MOVE    D0,(Result,A6)
@28             MOVE.L  (storage,A6),A0
                _DisposePtr
                BRA.S   @30

@29             MOVE    D0,(Result,A6)
@30             MOVE.L  (headerPtr,A6),A0
                _DisposePtr
                BRA.S   @32

@31             MOVE    D0,(Result,A6)
@32             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @34

@33             MOVE    D0,(Result,A6)
@34             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @36

@35             MOVE    D0,(Result,A6)
@36             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@37             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTD     #ParamSize

                ENDF
;———————————————————————————————————————————————————————————————
                MACHINE MC68000
;———————————————————————————————————————————————————————————————
; FUNCTION GetGIF87B (srcPort: GrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GETGIF87B       FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
volume          DS.W    1
width           DS.W    1
height          DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
minCodeSize     DS.W    1
codeSize        DS.W    1
clearCode       DS.W    1
eofCode         DS.W    1
freeCode        DS.W    1
maxCode         DS.W    1
omega           DS.W    1
buffer          DS.W    1
error           DS.W    1
curBits         DS.W    1
curAccum        DS.L    1
codeMask        DS.L    1
charCount       DS.L    1
codeTable       DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
folder          DS.L    1
dstRect         DS      Rect
charBuffer      DS.B    256
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @99
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @20

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @20
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@20             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @97
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @97

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @97
                BRA.S   @4

@2              MOVE.L  (nameGIF,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @97
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @95
                MOVE.L  #'GIFf',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applGIF87.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @95
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @95

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #32*1024,D3
                MOVEQ   #100,D2
                MOVE    (scale,A6),D1
                MOVE    (Rect.right,A0),D0
                SUB     (Rect.left,A0),D0
                MULU    D1,D0
                DIVU    D2,D0
                MOVE    D0,(width,A6)
                ADD     #15,D0
                LSR     #4,D0
                ADD     D0,D0
                MOVE    D0,(bytesPerRow,A6)
                DIVU    D0,D3
                BNE.S   @5
                MOVEQ   #1,D3
@5              MOVE    (Rect.bottom,A0),D0
                SUB     (Rect.top,A0),D0
                MULU    D1,D0
                DIVU    D2,D0
                MOVE    D0,(height,A6)
                CMP     D0,D3
                BLS.S   @6
                MOVE    D0,D3
@6              MOVE    D3,(rowsPerStrip,A6)

                CLR.L   (dstRect.topLeft,A6)
                MOVE    (height,A6),(dstRect.bottom,A6)
                MOVE    (width,A6),(dstRect.right,A6)

                MOVE    #2,(minCodeSize,A6)

                MOVE.L  #6+7+6+10+1,D0
                _NewPtrClear
                BNE     @93
                MOVE.L  A0,A3

; Header

                MOVE.L  #'GIF8',(A0)+
                MOVE    #'7a',(A0)+

; Logical Screen Descriptor

                MOVE    (width,A6),D0
                MOVE.B  D0,(A0)+
                LSR     #8,D0
                MOVE.B  D0,(A0)+
                MOVE    (height,A6),D0
                MOVE.B  D0,(A0)+
                LSR     #8,D0
                MOVE.B  D0,(A0)+
                MOVE.B  #%11110000,(A0)+
                MOVE.B  #0,(A0)+
                MOVE.B  #0,(A0)+

; Global Color Table

                MOVE.B  #$FF,(A0)+
                MOVE.B  #$FF,(A0)+
                MOVE.B  #$FF,(A0)+
                MOVE.B  #$00,(A0)+
                MOVE.B  #$00,(A0)+
                MOVE.B  #$00,(A0)+

; Image Descriptor

                MOVE.B  #',',(A0)+
                MOVE.B  #0,(A0)+
                MOVE.B  #0,(A0)+
                MOVE.B  #0,(A0)+
                MOVE.B  #0,(A0)+
                MOVE    (width,A6),D0
                MOVE.B  D0,(A0)+
                LSR     #8,D0
                MOVE.B  D0,(A0)+
                MOVE    (height,A6),D0
                MOVE.B  D0,(A0)+
                LSR     #8,D0
                MOVE.B  D0,(A0)+
                MOVE.B  #%00000000,(A0)+

; LZW Minimum Code Size

                MOVE    (minCodeSize,A6),D0
                MOVE.B  D0,(A0)+

                MOVE.L  A0,D3
                SUB.L   A3,D3

                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A3,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D3,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE     @92

                MOVE.L  A3,A0
                _DisposePtr
                BNE     @93

; Table Based Image Data

                MOVE.L  #4096*8,D0
                _NewPtr
                BNE     @93
                MOVE.L  A0,(codeTable,A6)

                BSR     InitLZW

                MOVEQ   #GrafPort.sizeof,D0
                _NewPtr
                BNE     @90
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenPort
                LEA     (GrafPort.portBits,A3),A2
                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @89
                MOVE.L  A0,(BitMap.baseAddr,A2)
                MOVE    (bytesPerRow,A6),(BitMap.rowBytes,A2)
                MOVE.L  (dstRect.topLeft,A6),(BitMap.bounds.topLeft,A2)
                MOVE.L  (dstRect.botRight,A6),(BitMap.bounds.botRight,A2)

                MOVEQ   #0,D5
                MOVE    (bytesPerRow,A6),D5

@7              SUBQ.L  #2,SP
                PEA     (BitMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @15
                MOVE    (BitMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (BitMap.bounds.bottom,A2),D0
                BGE.S   @8
                MOVE    D0,(BitMap.bounds.bottom,A2)
@8              MOVE.L  (BitMap.bounds.topLeft,A2),(GrafPort.portRect.topLeft,A3)
                MOVE.L  (BitMap.bounds.botRight,A2),(GrafPort.portRect.botRight,A3)
                MOVE.L  (GrafPort.visRgn,A3),-(SP)
                PEA     (GrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                MOVE.L  (srcRect,A6),-(SP)
                PEA     (dstRect,A6)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (GrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (BitMap.baseAddr,A2),A1
                MOVE    (BitMap.bounds.bottom,A2),D4
                SUB     (BitMap.bounds.top,A2),D4
                BRA.S   @14
@9              MOVE    (BitMap.bounds.right,A2),D3
                SUB     (BitMap.bounds.left,A2),D3
                MOVEQ   #0,D2
                BRA.S   @13
@10             MOVE.L  D2,D1
                ADDQ.L  #1,D2
                MOVE    D1,D0
                LSR.L   #3,D1
                NOT     D0
                BTST    D0,(A1,D1.L)
                BNE.S   @11
                MOVEQ   #0,D0
                BRA.S   @12
@11             MOVEQ   #1,D0
@12             BSR     WritePixel
@13             DBRA    D3,@10
                ADD.L   D5,A1
@14             DBRA    D4,@9
                MOVE    (BitMap.bounds.bottom,A2),(BitMap.bounds.top,A2)
                MOVE    (dstRect.bottom,A6),(BitMap.bounds.bottom,A2)
                BRA     @7

@15             MOVE.L  (BitMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr

                BSR     FlushLZW

                MOVE    (error,A6),D0
                BNE.S   @90

                MOVE.L  (codeTable,A6),A0
                _DisposePtr

; Block Terminator, Trailer

                LEA     (buffer,A6),A1
                MOVE.L  A1,A0
                MOVE.B  #0,(A0)+
                MOVE.B  #';',(A0)+
                MOVEQ   #2,D1

                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D1,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsAtMark,(ParamBlockRec.ioPosMode,A0)
                CLR.L   (ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @93
                _PBCloseSync
                BNE.S   @95
                _PBFlushVolSync
                BNE.S   @97
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@89             MOVE    D0,(Result,A6)
                MOVE.L  A3,-(SP)
                _ClosePort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @91

@90             MOVE    D0,(Result,A6)
@91             MOVE.L  (codeTable,A6),A0
                _DisposePtr
                BRA.S   @94

@92             MOVE    D0,(Result,A6)
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @94

@93             MOVE    D0,(Result,A6)
@94             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @96

@95             MOVE    D0,(Result,A6)
@96             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @98

@97             MOVE    D0,(Result,A6)
@98             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@99             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

InitLZW         BSR     InitCode
                BSR.S   InitTable
                MOVE    (clearCode,A6),D0
                BSR     WriteCode
                MOVE    #-1,(omega,A6)
                RTS

FlushLZW        MOVE    (omega,A6),D0
                BMI.S   @0
                BSR     WriteCode
                ADDQ    #1,(freeCode,A6)
                MOVE    (freeCode,A6),D0
                CMP     (maxCode,A6),D0
                BLS.S   @0
                ADDQ    #1,(codeSize,A6)
                MOVE    (codeSize,A6),D1
                MOVEQ   #1,D0
                LSL.L   D1,D0
                MOVE    D0,(maxCode,A6)
                SUBQ.L  #1,D0
                MOVE.L  D0,(codeMask,A6)
@0              MOVE    (eofCode,A6),D0
                BSR     WriteCode
                BSR     FlushCode
                RTS

InitTable       MOVEM.L D0-D2/A0,-(SP)
                MOVE    (minCodeSize,A6),D1
                MOVEQ   #1,D0
                LSL     D1,D0
                MOVE    D0,(clearCode,A6)
                ADDQ    #1,D0
                MOVE    D0,(eofCode,A6)
                ADDQ    #1,D0
                MOVE    D0,(freeCode,A6)
                ADDQ    #1,D1
                MOVE    D1,(codeSize,A6)
                MOVEQ   #1,D0
                LSL.L   D1,D0
                MOVE    D0,(maxCode,A6)
                SUBQ.L  #1,D0
                MOVE.L  D0,(codeMask,A6)
                MOVE.L  (codeTable,A6),A0
                MOVE    (freeCode,A6),D2
                MOVEQ   #0,D1
                MOVEQ   #-1,D0
@0              MOVE    D0,(A0)+
                MOVE    D1,(A0)+
                MOVE.L  D0,(A0)+
                ADDQ    #1,D1
                CMP     D2,D1
                BLO.S   @0
                MOVEM.L (SP)+,D0-D2/A0
                RTS

WritePixel      MOVEM.L D0-D5/A0,-(SP)
                MOVE    (omega,A6),D2
                BMI.S   @4
                MOVE    D0,D1
                MOVE.L  (codeTable,A6),A0
                MOVE    D2,D4
                LSL     #3,D4
                MOVE    (4,A0,D4),D0
                BMI.S   @1
@0              MOVE    D0,D5
                LSL     #3,D5
                CMP     (2,A0,D5),D1
                BEQ.S   @4
                MOVE    (6,A0,D5),D0
                BPL.S   @0
@1              MOVE    D2,D0
                BSR.S   WriteCode
                MOVE    (freeCode,A6),D3
                CMP     #4095,D3
                BHS.S   @2
                MOVE    D3,D5
                LSL     #3,D5
                MOVE    (4,A0,D4),D0
                MOVE    D3,(4,A0,D4)
                MOVE    D2,(0,A0,D5)
                MOVE    D1,(2,A0,D5)
                MOVE    #-1,(4,A0,D5)
                MOVE    D0,(6,A0,D5)
                ADDQ    #1,D3
                MOVE    D3,(freeCode,A6)
                CMP     (maxCode,A6),D3
                BLS.S   @3
                ADDQ    #1,(codeSize,A6)
                MOVE    (codeSize,A6),D2
                MOVEQ   #1,D0
                LSL.L   D2,D0
                MOVE    D0,(maxCode,A6)
                SUBQ.L  #1,D0
                MOVE.L  D0,(codeMask,A6)
                BRA.S   @3
@2              MOVE    (clearCode,A6),D0
                BSR.S   WriteCode
                BSR     InitTable
@3              MOVE    D1,D0
@4              MOVE    D0,(omega,A6)
                MOVEM.L (SP)+,D0-D5/A0
                RTS

InitCode        BSR.S   InitChar
                MOVE    #0,(curBits,A6)
                CLR.L   (curAccum,A6)
                RTS

WriteCode       MOVEM.L D0-D1,-(SP)
                AND.L   (codeMask,A6),D0
                MOVE    (curBits,A6),D1
                LSL.L   D1,D0
                OR.L    (curAccum,A6),D0
                ADD     (codeSize,A6),D1
                BRA.S   @1
@0              BSR.S   WriteChar
                LSR.L   #8,D0
                SUBQ    #8,D1
@1              CMP     #8,D1
                BGE.S   @0
                MOVE    D1,(curBits,A6)
                MOVE.L  D0,(curAccum,A6)
                MOVEM.L (SP)+,D0-D1
                RTS

FlushCode       MOVEM.L D0-D1,-(SP)
                MOVE    (curBits,A6),D1
                MOVE.L  (curAccum,A6),D0
                BRA.S   @1
@0              BSR.S   WriteChar
                LSR.L   #8,D0
                SUBQ    #8,D1
@1              TST     D1
                BGT.S   @0
                BSR.S   FlushChar
                MOVEM.L (SP)+,D0-D1
                RTS

InitChar        MOVE.L  #0,(charCount,A6)
                MOVE    #noErr,(error,A6)
                RTS

WriteChar       MOVEM.L D0-D1/A0,-(SP)
                LEA     (charBuffer,A6),A0
                MOVE.L  (charCount,A6),D1
                MOVE.B  D0,(1,A0,D1.L)
                ADDQ.L  #1,D1
                MOVE.L  D1,(charCount,A6)
                CMP     #255,D1
                BLO.S   @0
                BSR.S   FlushChar
@0              MOVEM.L (SP)+,D0-D1/A0
                RTS

FlushChar       MOVEM.L D0-D1/A0-A1,-(SP)
                MOVE.L  (charCount,A6),D1
                BEQ.S   @1
                LEA     (charBuffer,A6),A1
                MOVE.B  D1,(A1)
                ADDQ.L  #1,D1
                TST     (error,A6)
                BNE.S   @0
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D1,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsAtMark,(ParamBlockRec.ioPosMode,A0)
                CLR.L   (ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BEQ.S   @0
                MOVE    D0,(error,A6)
@0              MOVE.L  #0,(charCount,A6)
@1              MOVEM.L (SP)+,D0-D1/A0-A1
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
                MACHINE MC68020
;———————————————————————————————————————————————————————————————
; FUNCTION GetGIF87P (srcPort: CGrafPtr; srcRect: Rect; scale: INTEGER) : OSErr;
;———————————————————————————————————————————————————————————————
GETGIF87P       FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
ParamBegin      EQU     *
srcPort         DS.L    1
srcRect         DS.L    1
scale           DS.W    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
volume          DS.W    1
width           DS.W    1
height          DS.W    1
pixelSize       DS.W    1
bytesPerRow     DS.W    1
rowsPerStrip    DS.W    1
minCodeSize     DS.W    1
codeSize        DS.W    1
clearCode       DS.W    1
eofCode         DS.W    1
freeCode        DS.W    1
maxCode         DS.W    1
omega           DS.W    1
buffer          DS.W    1
error           DS.W    1
curBits         DS.W    1
curAccum        DS.L    1
codeMask        DS.L    1
charCount       DS.L    1
hResolution     DS.L    1
vResolution     DS.L    1
codeTable       DS.L    1
colTable        DS.L    1
savePort        DS.L    1
paramBlock      DS.L    1
folder          DS.L    1
dstRect         DS      Rect
charBuffer      DS.B    256
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                MOVEQ   #HParamBlockRec.sizeof,D0
                _NewPtrClear
                BNE     @99
                MOVE.L  A0,(paramBlock,A6)

                TST.B   (volName,A4)
                BEQ.S   @0

                PEA     (volName,A4)
                PEA     #':'
                PEA     (log.folder,A4)
                MOVE    #2,-(SP)
                BSR     Concat

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    #0,(HParamBlockRec.ioVRefNum,A0)
                MOVE    #-1,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE.S   @0
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (dirID,A4),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@0              TST.B   (hasFindFolder,A4)
                BEQ.S   @20

                SUBQ.L  #2,SP
                MOVE    #kOnSystemDisk,-(SP)
                MOVE.L  #kDesktopFolderType,-(SP)
                MOVE.B  #kDontCreateFolder,-(SP)
                PEA     (volume,A6)
                PEA     (folder,A6)
                _FindFolder
                TST     (SP)+
                BNE.S   @20
                MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(CInfoPBRec.ioNamePtr,A0)
                MOVE    (volume,A6),(CInfoPBRec.ioVRefNum,A0)
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  (folder,A6),(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BEQ.S   @1

@20             MOVE.L  (paramBlock,A6),A0
                LEA     (log.folder,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                MOVE    (BootDrive),(HParamBlockRec.ioVRefNum,A0)
                MOVE    #0,(HParamBlockRec.ioVolIndex,A0)
                _PBHGetVInfoSync
                BNE     @97
                MOVE    #-1,(CInfoPBRec.ioFDirIndex,A0)
                MOVE.L  #fsRtDirID,(CInfoPBRec.ioDrDirID,A0)
                _PBGetCatInfoSync
                BNE     @97

@1              TST.B   (log.fileName,A4)
                BEQ.S   @2

                MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BNE     @97
                BRA.S   @4

@2              MOVE.L  (nameGIF,A4),A0
                MOVE.L  (A0),-(SP)
                PEA     #'0'
                PEA     (log.fileName,A4)
                MOVE    #2,-(SP)
                BSR     Concat

@3              MOVE.L  (paramBlock,A6),A0
                LEA     (log.fileName,A4),A1
                MOVE.L  A1,(HParamBlockRec.ioNamePtr,A0)
                CLR.B   (HParamBlockRec.ioFVersNum,A0)
                _PBHCreateSync
                BEQ.S   @4
                CMP     #dupFNErr,D0
                BNE     @97
                PEA     (log.fileName,A4)
                BSR     IncName
                BRA.S   @3

@4              MOVE.L  (HParamBlockRec.ioDirID,A0),(folder,A6)
                MOVE    #0,(HParamBlockRec.ioFDirIndex,A0)
                _PBHGetFInfoSync
                BNE     @95
                MOVE.L  #'GIFf',(HParamBlockRec.ioFlFndrInfo.fdType,A0)
                MOVE.L  (applGIF87.creator,A4),(HParamBlockRec.ioFlFndrInfo.fdCreator,A0)
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHSetFInfoSync
                BNE     @95
                MOVE.B  #fsWrPerm,(HParamBlockRec.ioPermssn,A0)
                MOVE.L  #NIL,(HParamBlockRec.ioMisc,A0)
                _PBHOpenSync
                BNE     @95

                SUBQ.L  #4,SP
                _GetGDevice
                MOVE.L  (SP)+,A0
                MOVE.L  (A0),A0
                MOVE.L  (GDevice.gdPMap,A0),A0
                MOVE.L  (A0),A0
                MOVE    (PixMap.pixelSize,A0),(pixelSize,A6)
                MOVE.L  (PixMap.hRes,A0),(hResolution,A6)
                MOVE.L  (PixMap.vRes,A0),(vResolution,A6)
                MOVE.L  (PixMap.pmTable,A0),(colTable,A6)

                MOVE.L  (srcRect,A6),A0
                MOVE.L  #32*1024,D3
                MOVEQ   #100,D2
                MOVE    (scale,A6),D1
                MOVE    (Rect.right,A0),D0
                SUB     (Rect.left,A0),D0
                MULU    D1,D0
                DIVU    D2,D0
                MOVE    D0,(width,A6)
                MULU    (pixelSize,A6),D0
                ADD.L   #15,D0
                LSR.L   #4,D0
                ADD     D0,D0
                MOVE    D0,(bytesPerRow,A6)
                DIVU    D0,D3
                BNE.S   @5
                MOVEQ   #1,D3
@5              MOVE    (Rect.bottom,A0),D0
                SUB     (Rect.top,A0),D0
                MULU    D1,D0
                DIVU    D2,D0
                MOVE    D0,(height,A6)
                CMP     D0,D3
                BLS.S   @6
                MOVE    D0,D3
@6              MOVE    D3,(rowsPerStrip,A6)

                CLR.L   (dstRect.topLeft,A6)
                MOVE    (height,A6),(dstRect.bottom,A6)
                MOVE    (width,A6),(dstRect.right,A6)

                MOVE    (pixelSize,A6),D1
                CMP     #1,D1
                BGT.S   @7
                MOVEQ   #2,D1
@7              MOVE    D1,(minCodeSize,A6)

                MOVE.L  #6+7+10+1,D0
                MOVEQ   #3,D1
                MOVE    (pixelSize,A6),D2
                LSL.L   D2,D1
                ADD.L   D1,D0
                _NewPtrClear
                BNE     @93
                MOVE.L  A0,A3

; Header

                MOVE.L  #'GIF8',(A0)+
                MOVE    #'7a',(A0)+

; Logical Screen Descriptor

                MOVE    (width,A6),D0
                MOVE.B  D0,(A0)+
                LSR     #8,D0
                MOVE.B  D0,(A0)+
                MOVE    (height,A6),D0
                MOVE.B  D0,(A0)+
                LSR     #8,D0
                MOVE.B  D0,(A0)+
                MOVE    (pixelSize,A6),D0
                SUBQ    #1,D0
                AND     #%00000111,D0
                OR      #%11110000,D0
                MOVE.B  D0,(A0)+
                MOVE.B  #0,(A0)+
                MOVE.B  #0,(A0)+

; Global Color Table

                MOVEQ   #1,D0
                MOVE    (pixelSize,A6),D1
                LSL     D1,D0
                MOVE.L  (colTable,A6),A1
                MOVE.L  (A1),A1
                LEA     (ColorTable.ctTable,A1),A1
                BRA.S   @9
@8              MOVE.B  (ColorSpec.rgb.red,A1),(A0)+
                MOVE.B  (ColorSpec.rgb.green,A1),(A0)+
                MOVE.B  (ColorSpec.rgb.blue,A1),(A0)+
                ADDQ.L  #ColorSpec.sizeof,A1
@9              DBRA    D0,@8

; Image Descriptor

                MOVE.B  #',',(A0)+
                MOVE.B  #0,(A0)+
                MOVE.B  #0,(A0)+
                MOVE.B  #0,(A0)+
                MOVE.B  #0,(A0)+
                MOVE    (width,A6),D0
                MOVE.B  D0,(A0)+
                LSR     #8,D0
                MOVE.B  D0,(A0)+
                MOVE    (height,A6),D0
                MOVE.B  D0,(A0)+
                LSR     #8,D0
                MOVE.B  D0,(A0)+
                MOVE.B  #%00000000,(A0)+

; LZW Minimum Code Size

                MOVE    (minCodeSize,A6),D0
                MOVE.B  D0,(A0)+

                MOVE.L  A0,D3
                SUB.L   A3,D3

                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A3,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D3,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsFromStart,(ParamBlockRec.ioPosMode,A0)
                MOVE.L  #0,(ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE     @92

                MOVE.L  A3,A0
                _DisposePtr
                BNE     @93

; Table Based Image Data

                MOVE.L  #4096*8,D0
                _NewPtr
                BNE     @93
                MOVE.L  A0,(codeTable,A6)

                BSR     InitLZW

                MOVEQ   #CGrafPort.sizeof,D0
                _NewPtr
                BNE     @90
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenCPort
                MOVE.L  (CGrafPort.portPixMap,A3),A0
                _MoveHHi
                BNE     @89
                _HLock
                BNE     @89
                MOVE.L  (A0),A2
                MOVE    (bytesPerRow,A6),D0
                MULU    (rowsPerStrip,A6),D0
                _NewPtrClear
                BNE     @89
                MOVE.L  A0,(PixMap.baseAddr,A2)
                MOVE    (bytesPerRow,A6),D0
                AND     #$1FFF,D0
                OR      #$8000,D0
                MOVE    D0,(PixMap.rowBytes,A2)
                MOVE.L  (dstRect.topLeft,A6),(PixMap.bounds.topLeft,A2)
                MOVE.L  (dstRect.botRight,A6),(PixMap.bounds.botRight,A2)
                MOVE    #0,(PixMap.pmVersion,A2)
                MOVE    #0,(PixMap.packType,A2)
                MOVE.L  #0,(PixMap.packSize,A2)
                MOVE.L  (hResolution,A6),(PixMap.hRes,A2)
                MOVE.L  (vResolution,A6),(PixMap.vRes,A2)
                MOVE    #chunky,(PixMap.pixelType,A2)
                MOVE    (pixelSize,A6),(PixMap.pixelSize,A2)
                MOVE    #1,(PixMap.cmpCount,A2)
                MOVE    (pixelSize,A6),(PixMap.cmpSize,A2)
                MOVE.L  #0,(PixMap.planeBytes,A2)
                MOVE.L  (colTable,A6),(PixMap.pmTable,A2)
                MOVE.L  #0,(PixMap.pmReserved,A2)

                MOVEQ   #0,D5
                MOVE    (bytesPerRow,A6),D5

@10             SUBQ.L  #2,SP
                PEA     (PixMap.bounds,A2)
                _EmptyRect
                TST.B   (SP)+
                BNE     @16
                MOVE    (PixMap.bounds.top,A2),D0
                ADD     (rowsPerStrip,A6),D0
                CMP     (PixMap.bounds.bottom,A2),D0
                BGE.S   @11
                MOVE    D0,(PixMap.bounds.bottom,A2)
@11             MOVE.L  (PixMap.bounds.topLeft,A2),(CGrafPort.portRect.topLeft,A3)
                MOVE.L  (PixMap.bounds.botRight,A2),(CGrafPort.portRect.botRight,A3)
                MOVE.L  (CGrafPort.visRgn,A3),-(SP)
                PEA     (CGrafPort.portRect,A3)
                _RectRgn
                IF      demo THEN
                _PenNormal
                ENDIF
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                MOVE.L  (srcPort,A6),A0
                PEA     (GrafPort.portBits,A0)
                PEA     (GrafPort.portBits,A3)
                MOVE.L  (srcRect,A6),-(SP)
                PEA     (dstRect,A6)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                IF      demo THEN
                MOVE    #patOr,-(SP)
                _PenMode
                PEA     (DemoPattern,PC)
                _PenPat
                PEA     (CGrafPort.portRect,A3)
                _PaintRect
                ENDIF
                MOVE.L  (PixMap.baseAddr,A2),A1
                MOVE    (PixMap.bounds.bottom,A2),D4
                SUB     (PixMap.bounds.top,A2),D4
                MOVEQ   #0,D1
                MOVE    (pixelSize,A6),D1
                BRA.S   @15
@12             MOVE    (PixMap.bounds.right,A2),D3
                SUB     (PixMap.bounds.left,A2),D3
                MOVEQ   #0,D2
                BRA.S   @14
@13             BFEXTU  (A1){D2:D1},D0
                ADD.L   D1,D2
                BSR     WritePixel
@14             DBRA    D3,@13
                ADD.L   D5,A1
@15             DBRA    D4,@12
                MOVE    (PixMap.bounds.bottom,A2),(PixMap.bounds.top,A2)
                MOVE    (dstRect.bottom,A6),(PixMap.bounds.bottom,A2)
                BRA     @10

@16             MOVE.L  (PixMap.baseAddr,A2),A0
                _DisposePtr
                MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr

                BSR     FlushLZW

                MOVE    (error,A6),D0
                BNE.S   @90

                MOVE.L  (codeTable,A6),A0
                _DisposePtr

; Block Terminator, Trailer

                LEA     (buffer,A6),A1
                MOVE.L  A1,A0
                MOVE.B  #0,(A0)+
                MOVE.B  #';',(A0)+
                MOVEQ   #2,D1

                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D1,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsAtMark,(ParamBlockRec.ioPosMode,A0)
                CLR.L   (ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BNE.S   @93
                _PBCloseSync
                BNE.S   @95
                _PBFlushVolSync
                BNE.S   @97
                MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                MOVE    #noErr,(Result,A6)
                BRA.S   Exit

@89             MOVE    D0,(Result,A6)
                MOVE.L  A3,-(SP)
                _CloseCPort
                MOVE.L  (savePort,A6),-(SP)
                _SetPort
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @91

@90             MOVE    D0,(Result,A6)
@91             MOVE.L  (codeTable,A6),A0
                _DisposePtr
                BRA.S   @94

@92             MOVE    D0,(Result,A6)
                MOVE.L  A3,A0
                _DisposePtr
                BRA.S   @94

@93             MOVE    D0,(Result,A6)
@94             MOVE.L  (paramBlock,A6),A0
                _PBCloseSync
                BRA.S   @96

@95             MOVE    D0,(Result,A6)
@96             MOVE.L  (paramBlock,A6),A0
                MOVE.L  (folder,A6),(HParamBlockRec.ioDirID,A0)
                _PBHDeleteSync
                BRA.S   @98

@97             MOVE    D0,(Result,A6)
@98             MOVE.L  (paramBlock,A6),A0
                _DisposePtr
                BRA.S   Exit

@99             MOVE    D0,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTD     #ParamSize

InitLZW         BSR     InitCode
                BSR.S   InitTable
                MOVE    (clearCode,A6),D0
                BSR     WriteCode
                MOVE    #-1,(omega,A6)
                RTS

FlushLZW        MOVE    (omega,A6),D0
                BMI.S   @0
                BSR     WriteCode
                ADDQ    #1,(freeCode,A6)
                MOVE    (freeCode,A6),D0
                CMP     (maxCode,A6),D0
                BLS.S   @0
                ADDQ    #1,(codeSize,A6)
                MOVE    (codeSize,A6),D1
                MOVEQ   #1,D0
                LSL.L   D1,D0
                MOVE    D0,(maxCode,A6)
                SUBQ.L  #1,D0
                MOVE.L  D0,(codeMask,A6)
@0              MOVE    (eofCode,A6),D0
                BSR     WriteCode
                BSR     FlushCode
                RTS

InitTable       MOVEM.L D0-D2/A0,-(SP)
                MOVE    (minCodeSize,A6),D1
                MOVEQ   #1,D0
                LSL     D1,D0
                MOVE    D0,(clearCode,A6)
                ADDQ    #1,D0
                MOVE    D0,(eofCode,A6)
                ADDQ    #1,D0
                MOVE    D0,(freeCode,A6)
                ADDQ    #1,D1
                MOVE    D1,(codeSize,A6)
                MOVEQ   #1,D0
                LSL.L   D1,D0
                MOVE    D0,(maxCode,A6)
                SUBQ.L  #1,D0
                MOVE.L  D0,(codeMask,A6)
                MOVE.L  (codeTable,A6),A0
                MOVE    (freeCode,A6),D2
                MOVEQ   #0,D1
                MOVEQ   #-1,D0
@0              MOVE    D0,(A0)+
                MOVE    D1,(A0)+
                MOVE.L  D0,(A0)+
                ADDQ    #1,D1
                CMP     D2,D1
                BLO.S   @0
                MOVEM.L (SP)+,D0-D2/A0
                RTS

WritePixel      MOVEM.L D0-D4/A0,-(SP)
                MOVE    (omega,A6),D2
                BMI.S   @4
                MOVE    D0,D1
                MOVE.L  (codeTable,A6),A0
                MOVE    (4,A0,D2*8),D0
                BMI.S   @1
@0              CMP     (2,A0,D0*8),D1
                BEQ.S   @4
                MOVE    (6,A0,D0*8),D0
                BPL.S   @0
@1              MOVE    D2,D0
                BSR.S   WriteCode
                MOVE    (freeCode,A6),D3
                CMP     #4095,D3
                BHS.S   @2
                MOVE    (4,A0,D2*8),D0
                MOVE    D3,(4,A0,D2*8)
                MOVE    D2,(0,A0,D3*8)
                MOVE    D1,(2,A0,D3*8)
                MOVE    #-1,(4,A0,D3*8)
                MOVE    D0,(6,A0,D3*8)
                ADDQ    #1,D3
                MOVE    D3,(freeCode,A6)
                CMP     (maxCode,A6),D3
                BLS.S   @3
                ADDQ    #1,(codeSize,A6)
                MOVE    (codeSize,A6),D2
                MOVEQ   #1,D0
                LSL.L   D2,D0
                MOVE    D0,(maxCode,A6)
                SUBQ.L  #1,D0
                MOVE.L  D0,(codeMask,A6)
                BRA.S   @3
@2              MOVE    (clearCode,A6),D0
                BSR.S   WriteCode
                BSR     InitTable
@3              MOVE    D1,D0
@4              MOVE    D0,(omega,A6)
                MOVEM.L (SP)+,D0-D4/A0
                RTS

InitCode        BSR.S   InitChar
                MOVE    #0,(curBits,A6)
                CLR.L   (curAccum,A6)
                RTS

WriteCode       MOVEM.L D0-D1,-(SP)
                AND.L   (codeMask,A6),D0
                MOVE    (curBits,A6),D1
                LSL.L   D1,D0
                OR.L    (curAccum,A6),D0
                ADD     (codeSize,A6),D1
                BRA.S   @1
@0              BSR.S   WriteChar
                LSR.L   #8,D0
                SUBQ    #8,D1
@1              CMP     #8,D1
                BGE.S   @0
                MOVE    D1,(curBits,A6)
                MOVE.L  D0,(curAccum,A6)
                MOVEM.L (SP)+,D0-D1
                RTS

FlushCode       MOVEM.L D0-D1,-(SP)
                MOVE    (curBits,A6),D1
                MOVE.L  (curAccum,A6),D0
                BRA.S   @1
@0              BSR.S   WriteChar
                LSR.L   #8,D0
                SUBQ    #8,D1
@1              TST     D1
                BGT.S   @0
                BSR.S   FlushChar
                MOVEM.L (SP)+,D0-D1
                RTS

InitChar        MOVE.L  #0,(charCount,A6)
                MOVE    #noErr,(error,A6)
                RTS

WriteChar       MOVEM.L D0-D1/A0,-(SP)
                LEA     (charBuffer,A6),A0
                MOVE.L  (charCount,A6),D1
                MOVE.B  D0,(1,A0,D1.L)
                ADDQ.L  #1,D1
                MOVE.L  D1,(charCount,A6)
                CMP     #255,D1
                BLO.S   @0
                BSR.S   FlushChar
@0              MOVEM.L (SP)+,D0-D1/A0
                RTS

FlushChar       MOVEM.L D0-D1/A0-A1,-(SP)
                MOVE.L  (charCount,A6),D1
                BEQ.S   @1
                LEA     (charBuffer,A6),A1
                MOVE.B  D1,(A1)
                ADDQ.L  #1,D1
                TST     (error,A6)
                BNE.S   @0
                MOVE.L  (paramBlock,A6),A0
                MOVE.L  A1,(ParamBlockRec.ioBuffer,A0)
                MOVE.L  D1,(ParamBlockRec.ioReqCount,A0)
                MOVE    #fsAtMark,(ParamBlockRec.ioPosMode,A0)
                CLR.L   (ParamBlockRec.ioPosOffset,A0)
                _PBWriteSync
                BEQ.S   @0
                MOVE    D0,(error,A6)
@0              MOVE.L  #0,(charCount,A6)
@1              MOVEM.L (SP)+,D0-D1/A0-A1
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
                MACHINE MC68000
;———————————————————————————————————————————————————————————————
; Routine name  GetQDType
;
; On exit       D0: 0 if B/W QD, or -1 if color QD (byte)
;———————————————————————————————————————————————————————————————
GetQDType       FUNC    ENTRY

Gestalt         EQU     $A1AD
SysEnvirons     EQU     $A090

StackFrame      RECORD  {A6Link},DECR
RetAddr         DS.L    1
A6Link          DS.L    1
theWorld        DS      SysEnvRec
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVE.L  A0,-(SP)

                MOVE    #Gestalt,D0
                BSR     TrapAvailable
                BEQ.S   @0

                MOVE.L  #gestaltQuickdrawVersion,D0
                _Gestalt
                BNE.S   @0
                MOVE.L  A0,D0
                CMP     #gestalt8BitQD,D0
                SHS     D0
                BRA.S   Exit

@0              MOVE    #SysEnvirons,D0
                BSR     TrapAvailable
                BEQ.S   @2

                LEA     (theWorld,A6),A0
                MOVEQ   #curSysEnvVers,D0
                _SysEnvirons
                BEQ.S   @1
                CMP     #envVersTooBig,D0
                BNE.S   @2
                CMP     #1,(theWorld.environsVersion,A6)
                BLT.S   @2
@1              TST.B   (theWorld.hasColorQD,A6)
                SNE     D0
                BRA.S   Exit

@2              CMP     #$3FFF,(ROM85)
                SLS     D0

Exit            MOVE.L  (SP)+,A0
                UNLK    A6
                TST.B   D0
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; Routine name  GetSysZoneType
;
; On exit       D0: 0 if not growable, or -1 if growable (byte)
;———————————————————————————————————————————————————————————————
GetSysZoneType  FUNC    ENTRY

Gestalt         EQU     $A1AD
OSDispatch      EQU     $A88F

                MOVE.L  A0,-(SP)

                MOVE    #Gestalt,D0
                BSR     TrapAvailable
                BEQ.S   @0

                MOVE.L  #gestaltOSAttr,D0
                _Gestalt
                BNE.S   @0
                MOVE.L  A0,D0
                BTST    #gestaltSysZoneGrowable,D0
                SNE     D0
                BRA.S   Exit

@0              MOVE    #OSDispatch,D0
                BSR     TrapAvailable

Exit            MOVE.L  (SP)+,A0
                TST.B   D0
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetKeyChar (message: LONGINT) : CHAR;
;———————————————————————————————————————————————————————————————
GetKeyChar      FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS      1
ParamBegin      EQU     *
message         DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
state           DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                CLR     (Result,A6)
                SUBQ.L  #4,SP
                MOVE    #smKeyScript,-(SP)
                _GetScriptManagerVariable
                MOVE.L  (SP)+,D0
                SUBQ.L  #4,SP
                MOVE    D0,-(SP)
                MOVE    #smScriptKeys,-(SP)
                _GetScriptVariable
                MOVE.L  (SP)+,D0
                SUBQ.L  #4,SP
                MOVE.L  #'KCHR',-(SP)
                MOVE    D0,-(SP)
                _GetResource
                MOVE.L  (SP)+,D0
                BEQ.S   Exit
                MOVE.L  D0,A0
                MOVE.L  (message,A6),D0
                ROR     #8,D0
                AND     #$007F,D0
                OR      #$0080,D0
                CLR.L   (state,A6)
                SUBQ.L  #4,SP
                MOVE.L  (A0),-(SP)
                MOVE    D0,-(SP)
                PEA     (state,A6)
                _KeyTranslate
                MOVE.L  (SP)+,D0
                SWAP    D0
                TST.B   D0
                BNE.S   @0
                SWAP    D0
@0              CMP.B   #'a',D0
                BLO.S   @1
                CMP.B   #'z',D0
                BHI.S   @1
                SUB.B   #'a'-'A',D0
@1              AND     #$00FF,D0
                MOVE    D0,(Result,A6)
Exit            UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE GetIxString (VAR theString: Str255; theList: StrListHandle; index: INTEGER);
;———————————————————————————————————————————————————————————————
GetIxString     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theString       DS.L    1
theList         DS.L    1
index           DS      1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVE.L  (theString,A6),A1
                CLR.B   (A1)
                MOVE.L  (theList,A6),A0
                MOVE.L  (A0),A0
                MOVE    (A0)+,D0
                MOVE    (index,A6),D1
                BEQ.S   Exit
                CMP     D0,D1
                BHI.S   Exit
                MOVEQ   #0,D0
@0              SUBQ    #1,D1
                BEQ.S   @1
                MOVE.B  (A0)+,D0
                ADD.L   D0,A0
                BRA.S   @0
@1              MOVE.B  (A0),D0
                ADDQ.L  #1,D0
                _BlockMove
Exit            UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE DrawMessage (messageID: INTEGER; param0,param1,param2,param3,param4: Str255; box: Rect);
;———————————————————————————————————————————————————————————————
DrawMessage     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
messageID       DS      1
param0          DS.L    1
param1          DS.L    1
param2          DS.L    1
param3          DS.L    1
param4          DS.L    1
box             DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
text            DS.B    256
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                PEA     (text,A6)
                MOVE.L  (Head,PC),A0
                MOVE.L  (myStrings,A0),-(SP)
                MOVE    (messageID,A6),-(SP)
                BSR     GetIxString
                LEA     (text,A6),A0
                MOVEQ   #0,D0
                MOVE.B  (A0)+,D0
                _PtrToHand
                TST     D0
                BNE.S   Exit
                MOVE.L  A0,A4
                MOVEQ   #0,D7
@0              MOVE.L  A4,A0
                _GetHandleSize
                MOVE.L  D0,D6
                MOVE.L  (A4),A3
                ADD.L   D7,A3
                SUB.L   D7,D6
                BRA.S   @5
@1              CMP.B   #'^',(A3)+
                BNE.S   @4
                LEA     (param0,A6),A2
                MOVE.B  #'0',D5
                BRA.S   @3
@2              SUBQ.L  #4,A2
                ADDQ.B  #1,D5
                CMP.B   #'5',D5
                BEQ.S   @4
@3              CMP.B   (A3),D5
                BNE.S   @2
                MOVE.L  (A2),D0
                BEQ.S   @4
                MOVE.L  D0,A0
                MOVEQ   #0,D0
                MOVE.B  (A0)+,D0
                SUBQ.L  #4,SP
                MOVE.L  A4,-(SP)
                MOVE.L  D7,-(SP)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #2,-(SP)
                MOVE.L  A0,-(SP)
                MOVE.L  D0,-(SP)
                _Munger
                MOVE.L  (SP)+,D7
                BRA.S   @0
@4              ADDQ.L  #1,D7
@5              DBRA    D6,@1
                MOVE.L  A4,A0
                _HLock
                MOVE.L  (A0),-(SP)
                _GetHandleSize
                MOVE.L  D0,-(SP)
                MOVE.L  (box,A6),-(SP)
                MOVE    (TESysJust),-(SP)               ; GetSysJust
                _TETextBox
                MOVE.L  A4,A0
                _DisposeHandle

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE CenterRect (VAR r: Rect);
;———————————————————————————————————————————————————————————————
CenterRect      PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
r               DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVE.L  (r,A6),A1
                MOVE.L  (0,A5),A0
                MOVEQ   #20,D0
                TST     (ROM85)
                BMI.S   @0
                MOVE    (MBarHeight),D0                 ; GetMBarHeight
@0              ADD     (screenBits.bounds.top,A0),D0
                SUB     (Rect.top,A1),D0
                ASL     #1,D0
                ADD     (screenBits.bounds.bottom,A0),D0
                SUB     (Rect.bottom,A1),D0
                EXT.L   D0
                DIVS    #3,D0
                MOVE    (screenBits.bounds.left,A0),D1
                ADD     (screenBits.bounds.right,A0),D1
                SUB     (Rect.left,A1),D1
                SUB     (Rect.right,A1),D1
                ASR     #1,D1
                ADD     D0,(A1)+
                ADD     D1,(A1)+
                ADD     D0,(A1)+
                ADD     D1,(A1)+
Exit            UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE Notify;
;———————————————————————————————————————————————————————————————
Notify          PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
RetAddr         DS.L    1
A6Link          DS.L    1
rect1           DS      Rect
rect2           DS      Rect
param4          DS.B    8
param1          DS.B    32
param0          DS.B    32
pnState         DS      PenState
theEvent        DS      EventRecord
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4

                TST     (log.error,A4)
                BNE.S   @0

                PEA     (rect1,A6)
                MOVE    #0,-(SP)
                MOVE    #0,-(SP)
                MOVE    #450,-(SP)
                MOVE    #132,-(SP)
                _SetRect
                BRA.S   @1

@0              PEA     (rect1,A6)
                MOVE    #0,-(SP)
                MOVE    #0,-(SP)
                MOVE    #450,-(SP)
                MOVE    #84,-(SP)
                _SetRect

@1              PEA     (rect1,A6)
                BSR     CenterRect
                PEA     (pnState,A6)
                _GetPenState
                _PenNormal
                PEA     (rect1,A6)
                _FrameRect
                PEA     (rect1,A6)
                MOVE    #1,-(SP)
                MOVE    #1,-(SP)
                _InsetRect
                MOVE    #2,-(SP)
                MOVE    #2,-(SP)
                _PenSize
                MOVE.L  (0,A5),A0
                PEA     (white,A0)
                _PenPat
                PEA     (rect1,A6)
                _FrameRect
                PEA     (rect1,A6)
                MOVE    #2,-(SP)
                MOVE    #2,-(SP)
                _InsetRect
                MOVE.L  (0,A5),A0
                PEA     (black,A0)
                _PenPat
                PEA     (rect1,A6)
                _FrameRect
                PEA     (rect1,A6)
                MOVE    #2,-(SP)
                MOVE    #2,-(SP)
                _InsetRect
                PEA     (rect1,A6)
                _EraseRect

                MOVE.L  (rect1.topLeft,A6),(rect2.topLeft,A6)
                MOVE.L  #$000D0017,-(SP)
                PEA     (rect2.topLeft,A6)
                _AddPt
                MOVE.L  (rect2.topLeft,A6),(rect2.botRight,A6)
                MOVE.L  #$00200020,-(SP)
                PEA     (rect2.botRight,A6)
                _AddPt

                MOVE.L  (stopHndl,A4),A3
                TST     (log.error,A4)
                BNE.S   @13
                MOVE.L  (noteHndl,A4),A3

@13             PEA     (rect2,A6)
                MOVE.L  A3,-(SP)
                _PlotIcon

                MOVE.L  (rect1.topLeft,A6),(rect2.topLeft,A6)
                MOVE.L  #$000D004E,-(SP)
                PEA     (rect2.topLeft,A6)
                _AddPt
                MOVE.L  (rect1.botRight,A6),(rect2.botRight,A6)
                MOVE.L  #$000D000D,-(SP)
                PEA     (rect2.botRight,A6)
                _SubPt

                TST     (log.error,A4)
                BNE     @9

                PEA     (param0,A6)
                MOVE.L  (myStrings,A4),-(SP)
                MOVE    (log.area,A4),-(SP)
                ADD     #10,(SP)
                CMP     #14,(SP)
                BLO.S   @15
                ADD     #21,(SP)
@15             BSR     GetIxString
                PEA     (param1,A6)
                MOVE.L  (myStrings,A4),-(SP)
                MOVE    (log.format,A4),-(SP)
                ADD     #14,(SP)
                BSR     GetIxString
                MOVE    (log.scale,A4),D0
                EXT.L   D0
                LEA     (param4,A6),A0
                _NumToString

                TST.B   (log.force,A4)
                BNE     @5

                CMP     #2,(log.format,A4)
                BHS.S   @3

                CMP     #100,(log.scale,A4)
                BNE.S   @2

                MOVE    #1,-(SP)
                PEA     (param0,A6)
                PEA     (param1,A6)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #NIL,-(SP)
                PEA     (rect2,A6)
                BSR     DrawMessage
                BRA     @11

@2              MOVE    #2,-(SP)
                PEA     (param0,A6)
                PEA     (param1,A6)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #NIL,-(SP)
                PEA     (param4,A6)
                PEA     (rect2,a6)
                BSR     DrawMessage
                BRA     @11

@3              CMP     #100,(log.scale,A4)
                BNE.S   @4

                MOVE    #3,-(SP)
                PEA     (param0,A6)
                PEA     (param1,A6)
                PEA     (log.folder,A4)
                PEA     (log.fileName,A4)
                MOVE.L  #NIL,-(SP)
                PEA     (rect2,A6)
                BSR     DrawMessage
                BRA     @11

@4              MOVE    #4,-(SP)
                PEA     (param0,A6)
                PEA     (param1,A6)
                PEA     (log.folder,A4)
                PEA     (log.fileName,A4)
                PEA     (param4,A6)
                PEA     (rect2,A6)
                BSR     DrawMessage
                BRA     @11

@5              CMP     #2,(log.format,A4)
                BHS.S   @7

                CMP     #100,(log.scale,A4)
                BNE.S   @6

                MOVE    #5,-(SP)
                PEA     (param0,A6)
                PEA     (param1,A6)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #NIL,-(SP)
                PEA     (rect2,A6)
                BSR     DrawMessage
                BRA     @11

@6              MOVE    #6,-(SP)
                PEA     (param0,A6)
                PEA     (param1,A6)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #NIL,-(SP)
                PEA     (param4,A6)
                PEA     (rect2,A6)
                BSR     DrawMessage
                BRA     @11

@7              CMP     #100,(log.scale,A4)
                BNE.S   @8

                MOVE    #7,-(SP)
                PEA     (param0,A6)
                PEA     (param1,A6)
                PEA     (log.folder,A4)
                PEA     (log.fileName,A4)
                MOVE.L  #NIL,-(SP)
                PEA     (rect2,A6)
                BSR     DrawMessage
                BRA     @11

@8              MOVE    #8,-(SP)
                PEA     (param0,A6)
                PEA     (param1,A6)
                PEA     (log.folder,A4)
                PEA     (log.fileName,A4)
                PEA     (param4,A6)
                PEA     (rect2,A6)
                BSR     DrawMessage
                BRA     @11

@9              MOVE    (log.error,A4),D7

                MOVEQ   #21,D6
                CMP     #memFullErr,D7
                BEQ.S   @10
                MOVEQ   #22,D6
                CMP     #dirFulErr,D7
                BEQ.S   @10
                CMP     #dskFulErr,D7
                BEQ.S   @10
                MOVEQ   #23,D6
                CMP     #wPrErr,D7
                BEQ.S   @10
                CMP     #vLckdErr,D7
                BEQ.S   @10
                MOVEQ   #24,D6
                CMP     #fBsyErr,D7
                BEQ.S   @10
                CMP     #opWrErr,D7
                BEQ.S   @10
                MOVEQ   #25,D6
                CMP     #fLckdErr,D7
                BEQ.S   @10
                CMP     #permErr,D7
                BEQ.S   @10
                CMP     #wrPermErr,D7
                BEQ.S   @10
                MOVEQ   #26,D6
                CMP     #fnfErr,D7
                BEQ.S   @10
                MOVEQ   #27,D6
                CMP     #dupFNErr,D7
                BEQ.S   @10
                MOVEQ   #28,D6
                CMP     #ioErr,D7
                BEQ.S   @10
                MOVEQ   #29,D6
                CMP     #mapFulErr,D7
                BEQ.S   @10
                MOVEQ   #30,D6
                CMP     #tooDeepErr,D7
                BEQ.S   @10
                MOVEQ   #31,D6

@10             PEA     (param0,A6)
                MOVE.L  (myStrings,A4),-(SP)
                MOVE    D6,-(SP)
                BSR     GetIxString
                MOVE    D7,D0
                EXT.L   D0
                LEA     (param4,A6),A0
                _NumToString

                MOVE    #9,-(SP)
                PEA     (param0,A6)
                PEA     (param4,A6)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #NIL,-(SP)
                MOVE.L  #NIL,-(SP)
                PEA     (rect2,A6)
                BSR     DrawMessage

@11             PEA     (pnState,A6)
                _SetPenState

                MOVE    #arrowCursor,-(SP)
                BSR     SetCursor

                MOVE    #8,-(SP)
                _SysBeep

@12             LEA     (theEvent,A6),A0
                MOVEQ   #$3F,D0
                _GetOSEvent
                TST.B   D0
                BNE.S   @12
                MOVE    (theEvent.what,A6),D0
                CMP     #mouseDown,D0
                BEQ.S   @14
                CMP     #keyDown,D0
                BNE.S   @12

@14             MOVE    #watchCursor,-(SP)
                BSR     SetCursor

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTS

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION SaveBits (r: Rect) : BitsHandle;
;———————————————————————————————————————————————————————————————
SaveBits        FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.L    1
ParamBegin      EQU     *
r               DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                CLR.L   (Result,A6)

                MOVEQ   #1,D7
                CMP     #$3FFF,(ROM85)
                BHI.S   @0
                SUBQ.L  #4,SP
                _GetGDevice
                MOVE.L  (SP)+,A0
                MOVE.L  (A0),A0
                MOVE.L  (GDevice.gdPMap,A0),A4
                MOVE.L  (A4),A0
                MOVE    (PixMap.pixelSize,A0),D7
@0              MOVE.L  (r,A6),A0
                MOVE    (Rect.bottom,A0),D1
                SUB     (Rect.top,A0),D1
                MOVE    (Rect.right,A0),D0
                SUB     (Rect.left,A0),D0
                MULU    D7,D0
                ADD.L   #15,D0
                LSR.L   #4,D0
                ADD     D0,D0
                MOVE    D0,D6
                MULU    D1,D0
                ADD.L   #BitMap.sizeof,D0
                CMP     #1,D7
                BLS.S   @1
                ADD.L   #PixMap.sizeof-BitMap.sizeof,D0
@1              _NewHandleClear
                BNE     Exit
                _HLock
                MOVE.L  A0,A3
                MOVE.L  (A3),A2
                CMP     #1,D7
                BHI.S   @2
                LEA     (BitMap.sizeof,A2),A0
                MOVE.L  A0,(BitMap.baseAddr,A2)
                MOVE    D6,(BitMap.rowBytes,A2)
                MOVE.L  (r,A6),A0
                MOVE.L  (Rect.topLeft,A0),(BitMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(BitMap.bounds.botRight,A2)
                BRA.S   @3
@2              LEA     (PixMap.sizeof,A2),A0
                MOVE.L  A0,(PixMap.baseAddr,A2)
                OR      #$8000,D6
                MOVE    D6,(PixMap.rowBytes,A2)
                MOVE.L  (r,A6),A0
                MOVE.L  (Rect.topLeft,A0),(PixMap.bounds.topLeft,A2)
                MOVE.L  (Rect.botRight,A0),(PixMap.bounds.botRight,A2)
                MOVE.L  (A4),A0
                MOVE.L  (PixMap.hRes,A0),(PixMap.hRes,A2)
                MOVE.L  (PixMap.vRes,A0),(PixMap.vRes,A2)
                MOVE    (PixMap.pixelType,A0),(PixMap.pixelType,A2)
                MOVE    (PixMap.pixelSize,A0),(PixMap.pixelSize,A2)
                MOVE    (PixMap.cmpCount,A0),(PixMap.cmpCount,A2)
                MOVE    (PixMap.cmpSize,A0),(PixMap.cmpSize,A2)
                MOVE.L  (PixMap.pmTable,A0),(PixMap.pmTable,A2)
@3              MOVE.L  (0,A5),A0
                MOVE.L  (thePort,A0),A0
                PEA     (GrafPort.portBits,A0)
                MOVE.L  A2,-(SP)
                MOVE.L  (r,A6),-(SP)
                MOVE.L  (r,A6),-(SP)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                MOVE.L  A2,D0
                SUB.L   D0,(BitMap.baseAddr,A2)
                MOVE.L  A3,A0
                _HUnlock
                MOVE.L  A3,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE RestoreBits (bits: BitsHandle);
;———————————————————————————————————————————————————————————————
RestoreBits     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
bits            DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)

                MOVE.L  (bits,A6),A0
                _HLock
                MOVE.L  A0,A3
                MOVE.L  (A3),A2
                MOVE.L  A2,D0
                ADD.L   D0,(BitMap.baseAddr,A2)
                MOVE.L  (0,A5),A0
                MOVE.L  (thePort,A0),A0
                MOVE.L  A2,-(SP)
                PEA     (GrafPort.portBits,A0)
                PEA     (BitMap.bounds,A2)
                PEA     (BitMap.bounds,A2)
                MOVE    #srcCopy,-(SP)
                MOVE.L  #NIL,-(SP)
                _CopyBits
                MOVE.L  A3,A0
                _DisposeHandle

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE DrawControl (theControl: CtlPtr);
;———————————————————————————————————————————————————————————————
DrawControl     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theControl      DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
pnState         DS      PenState
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (theControl,A6),A4

                PEA     (pnState,A6)
                _GetPenState
                _PenNormal
                PEA     (CtlRec.box,A4)
                MOVE    #10,-(SP)
                MOVE    #10,-(SP)
                _EraseRoundRect
                TST.B   (CtlRec.vis,A4)
                BEQ.S   @2
                SUBQ.L  #2,SP
                PEA     (CtlRec.title,A4)
                _StringWidth
                MOVE    (CtlRec.box.left,A4),D0
                ADD     (CtlRec.box.right,A4),D0
                SUB     (SP)+,D0
                ASR     #1,D0
                MOVE    D0,-(SP)
                MOVE    (CtlRec.box.top,A4),D0
                ADD     #14,D0
                MOVE    D0,-(SP)
                _MoveTo
                PEA     (CtlRec.title,A4)
                _DrawString
                CMP.B   #255,(CtlRec.hilite,A4)
                BNE.S   @0
                MOVE.L  (0,A5),A0
                PEA     (gray,A0)
                _PenPat
                MOVE    #patBic,-(SP)
                _PenMode
                PEA     (CtlRec.box,A4)
                MOVE    #10,-(SP)
                MOVE    #10,-(SP)
                _PaintRoundRect
                _PenNormal
@0              TST     (CtlRec.value,A4)
                BEQ.S   @1
                PEA     (CtlRec.box,A4)
                MOVE    #10,-(SP)
                MOVE    #10,-(SP)
                _InvertRoundRect
@1              PEA     (CtlRec.box,A4)
                MOVE    #10,-(SP)
                MOVE    #10,-(SP)
                _FrameRoundRect
@2              PEA     (pnState,A6)
                _SetPenState

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE HiliteControl (theControl: CtlPtr; hiliteState: INTEGER);
;———————————————————————————————————————————————————————————————
HiliteControl   PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theControl      DS.L    1
hiliteState     DS      1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CtlRec

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (theControl,A6),A4

                MOVE    (hiliteState,A6),D0
                CMP.B   (CtlRec.hilite,A4),D0
                BEQ.S   Exit
                MOVE.B  D0,(CtlRec.hilite,A4)
                MOVE.L  A4,-(SP)
                BSR     DrawControl

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE SetCtlValue (theControl: CtlPtr; theValue: INTEGER);
;———————————————————————————————————————————————————————————————
SetCtlValue     PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theControl      DS.L    1
theValue        DS      1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CtlRec

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (theControl,A6),A4

                MOVE    (theValue,A6),D0
                CMP     (value,A4),D0
                BEQ.S   Exit
                MOVE    D0,(value,A4)
                MOVE.L  A4,-(SP)
                BSR     DrawControl

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION TrackControl (theControl: CtlPtr; startPt: Point) : INTEGER;
;———————————————————————————————————————————————————————————————
TrackControl    FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS      1
ParamBegin      EQU     *
theControl      DS.L    1
startPt         DS.L    1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
pt              DS.L    1
LocalSize       EQU     *
                ENDR

                WITH    StackFrame,CtlRec

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (theControl,A6),A4

                MOVE.L  (startPt,A6),(pt,A6)

@0              SUBQ.L  #2,SP
                MOVE.L  (pt,A6),-(SP)
                PEA     (box,A4)
                _PtInRect
                TST.B   (SP)+
                BNE.S   @1
                MOVEQ   #0,D0
                BRA.S   @2
@1              MOVEQ   #1,D0
@2              MOVE    D0,(Result,A6)
                MOVE.L  A4,-(SP)
                MOVE    D0,-(SP)
                BSR     SetCtlValue
                PEA     (pt,A6)
                _GetMouse
                SUBQ.L  #2,SP
                BSR     StillDown
                TST.B   (SP)+
                BNE.S   @0
                MOVE.L  A4,-(SP)
                MOVE    #0,-(SP)
                BSR     SetCtlValue

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
; FUNCTION GetName : OSErr;
;———————————————————————————————————————————————————————————————
GetName         FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS.W    1
RetAddr         DS.L    1
A6Link          DS.L    1
theBits         DS.L    1
hTE             DS.L    1
TErect          DS      Rect
rect1           DS      Rect
rect2           DS      Rect
rect3           DS      Rect
Save            DS      CtlRec
Cancel          DS      CtlRec
pnState         DS      PenState
theEvent        DS      EventRecord
theString       DS.B    64
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                CLR     (Result,A6)
                MOVE.L  (Head,PC),A4
                CLR.B   (log.fileName,A4)

                SUBQ.L  #4,SP
                MOVE    #smEnabled,-(SP)
                _GetScriptManagerVariable
                MOVE.L  (SP)+,D0
                CMP.B   #1,D0
                BLE.S   @14

                SUBQ.L  #4,SP
                MOVE    #smKeyScript,-(SP)
                _GetScriptManagerVariable
                MOVE.L  (SP)+,D0
                CMP     #smRoman,D0
                BEQ.S   @14

                MOVE    #smRoman,-(SP)
                _KeyScript

@14             PEA     (rect1,A6)
                MOVE    #0,-(SP)
                MOVE    #0,-(SP)
                MOVE    #300,-(SP)
                MOVE    #111,-(SP)
                _SetRect

                PEA     (rect1,A6)
                BSR     CenterRect

                SUBQ.L  #4,SP
                PEA     (rect1,A6)
                BSR     SaveBits
                MOVE.L  (SP)+,D0
                BEQ     @13
                MOVE.L  D0,(theBits,A6)

                PEA     (pnState,A6)
                _GetPenState
                _PenNormal
                MOVE.L  (rect1.topLeft,A6),(rect2.topLeft,A6)
                MOVE.L  (rect1.botRight,A6),(rect2.botRight,A6)
                PEA     (rect2,A6)
                _FrameRect
                PEA     (rect2,A6)
                MOVE    #1,-(SP)
                MOVE    #1,-(SP)
                _InsetRect
                MOVE    #2,-(SP)
                MOVE    #2,-(SP)
                _PenSize
                MOVE.L  (0,A5),A0
                PEA     (white,A0)
                _PenPat
                PEA     (rect2,A6)
                _FrameRect
                PEA     (rect2,A6)
                MOVE    #2,-(SP)
                MOVE    #2,-(SP)
                _InsetRect
                MOVE.L  (0,A5),A0
                PEA     (black,A0)
                _PenPat
                PEA     (rect2,A6)
                _FrameRect
                PEA     (rect2,A6)
                MOVE    #2,-(SP)
                MOVE    #2,-(SP)
                _InsetRect
                PEA     (rect2,A6)
                _EraseRect

                MOVE.L  (rect2.topLeft,A6),(rect3.topLeft,A6)
                MOVE.L  #$0019000D,-(SP)
                PEA     (rect3.topLeft,A6)
                _AddPt
                MOVE.L  (rect3.topLeft,A6),-(SP)
                _MoveTo

                PEA     (theString,A6)
                MOVE.L  (myStrings,A4),-(SP)
                MOVE    #32,-(SP)
                BSR     GetIxString
                PEA     (theString,A6)
                _DrawString

                MOVE    (rect2.top,A6),D0
                ADD     #13+16+4,D0
                MOVE    D0,(TErect.top,A6)
                ADD     #22,D0
                MOVE    D0,(TErect.bottom,A6)
                MOVE    (rect2.left,A6),D0
                ADD     #13,D0
                MOVE    D0,(TErect.left,A6)
                MOVE    (rect2.right,A6),D0
                SUB     #13,D0
                MOVE    D0,(TErect.right,A6)
                MOVE.L  (TErect.topLeft,A6),(rect3.topLeft,A6)
                MOVE.L  (TErect.botRight,A6),(rect3.botRight,A6)
                _PenNormal
                PEA     (rect3,A6)
                _FrameRect
                PEA     (rect3,A6)
                MOVE    #3,-(SP)
                MOVE    #3,-(SP)
                _InsetRect
                SUBQ.L  #4,SP
                PEA     (rect3,A6)
                PEA     (rect3,A6)
                _TENew
                MOVE.L  (SP)+,D0
                BEQ     @12
                MOVE.L  D0,(hTE,A6)
                MOVE.L  (hTE,A6),-(SP)
                _TEActivate

                MOVE    (rect2.bottom,A6),D0
                SUB     #13,D0
                MOVE    D0,(Save.box.bottom,A6)
                MOVE    D0,(Cancel.box.bottom,A6)
                SUB     #20,D0
                MOVE    D0,(Save.box.top,A6)
                MOVE    D0,(Cancel.box.top,A6)
                MOVE    (rect2.right,A6),D0
                SUB     #13,D0
                MOVE    D0,(Save.box.right,A6)
                SUB     #64,D0
                MOVE    D0,(Save.box.left,A6)
                SUB     #13,D0
                MOVE    D0,(Cancel.box.right,A6)
                SUB     #64,D0
                MOVE    D0,(Cancel.box.left,A6)

                ST      (Cancel.vis,A6)
                CLR.B   (Cancel.hilite,A6)
                MOVE    #0,(Cancel.value,A6)
                PEA     (Cancel.title,A6)
                MOVE.L  (myStrings,A4),-(SP)
                MOVE    #33,-(SP)
                BSR     GetIxString

                ST      (Save.vis,A6)
                MOVE.B  #255,(Save.hilite,A6)
                MOVE    #0,(Save.value,A6)
                PEA     (Save.title,A6)
                MOVE.L  (myStrings,A4),-(SP)
                MOVE    #34,-(SP)
                BSR     GetIxString

                PEA     (Cancel,A6)
                BSR     DrawControl

                _PenNormal
                MOVE    #3,-(SP)
                MOVE    #3,-(SP)
                _PenSize
                MOVE.L  (Save.box.topLeft,A6),(rect3.topLeft,A6)
                MOVE.L  (Save.box.botRight,A6),(rect3.botRight,A6)
                PEA     (rect3,A6)
                MOVE    #-4,-(SP)
                MOVE    #-4,-(SP)
                _InsetRect
                PEA     (rect3,A6)
                MOVE    #16,-(SP)
                MOVE    #16,-(SP)
                _FrameRoundRect
                PEA     (Save,A6)
                BSR     DrawControl

                MOVE    #arrowCursor,-(SP)
                BSR     SetCursor

@0              MOVE.L  (hTE,A6),-(SP)
                _TEIdle

                LEA     (theEvent,A6),A0
                MOVEQ   #$3F,D0
                _GetOSEvent
                TST.B   D0
                BNE.S   @0
                MOVE    (theEvent.what,A6),D0

                CMP     #mouseDown,D0
                BNE     @3
                PEA     (theEvent.where,A6)
                _GlobalToLocal
                SUBQ.L  #2,SP
                MOVE.L  (theEvent.where,A6),-(SP)
                PEA     (TErect,A6)
                _PtInRect
                TST.B   (SP)+
                BEQ.S   @1
                MOVE.L  (theEvent.where,A6),-(SP)
                MOVE    (theEvent.modifiers,A6),D0
                BTST    #shiftKeyBit,D0
                SNE     -(SP)
                MOVE.L  (hTE,A6),-(SP)
                _TEClick
                BRA.S   @0
@1              SUBQ.L  #2,SP
                MOVE.L  (theEvent.where,A6),-(SP)
                PEA     (Cancel.box,A6)
                _PtInRect
                TST.B   (SP)+
                BEQ.S   @2
                SUBQ.L  #2,SP
                PEA     (Cancel,A6)
                MOVE.L  (theEvent.where,A6),-(SP)
                BSR     TrackControl
                TST     (SP)+
                BNE     @11
                BRA.S   @0
@2              CMP.B   #255,(Save.hilite,A6)
                BEQ.S   @0
                SUBQ.L  #2,SP
                MOVE.L  (theEvent.where,A6),-(SP)
                PEA     (Save.box,A6)
                _PtInRect
                TST.B   (SP)+
                BEQ     @0
                SUBQ.L  #2,SP
                PEA     (Save,A6)
                MOVE.L  (theEvent.where,A6),-(SP)
                BSR     TrackControl
                TST     (SP)+
                BNE     @10
                BRA     @0

@3              CMP     #keyDown,D0
                BEQ.S   @4
                CMP     #autoKey,D0
                BNE     @0
@4              MOVE    (theEvent.modifiers,A6),D0
                BTST    #cmdKeyBit,D0
                BNE     @0
                MOVE.L  (theEvent.message,A6),D0
                CMP.B   #ETX,D0
                BEQ     @9
                CMP.B   #BS,D0
                BEQ.S   @5
                CMP.B   #HT,D0
                BEQ     @8
                CMP.B   #CR,D0
                BEQ     @9
                CMP.B   #FS,D0
                BLO     @0
                CMP.B   #' ',D0
                BLO.S   @5
                CMP.B   #':',D0
                BEQ     @0
                MOVE.L  (hTE,A6),A0
                MOVE.L  (A0),A0
                MOVE    (TERec.teLength,A0),D0
                ADD     (TERec.selStart,A0),D0
                SUB     (TERec.selEnd,A0),D0
                ADDQ    #1,D0
                CMP     #31,D0
                BLS.S   @5
                MOVE    #8,-(SP)
                _SysBeep
                BRA     @0
@5              MOVE.L  (theEvent.message,A6),D0
                AND     #$00FF,D0
                MOVE    D0,-(SP)
                MOVE.L  (hTE,A6),-(SP)
                _TEKey
                MOVE.L  (hTE,A6),A0
                MOVE.L  (A0),A0
                MOVE    (TERec.teLength,A0),D0
                BEQ.S   @6
                CMP     #31,D0                  ; was 63
                BLS.S   @7
@6              PEA     (Save,A6)
                MOVE    #255,-(SP)
                BSR     HiliteControl
                BRA     @0
@7              PEA     (Save,A6)
                MOVE    #0,-(SP)
                BSR     HiliteControl
                BRA     @0
@8              MOVE.L  #0,-(SP)
                MOVE.L  #32767,-(SP)
                MOVE.L  (hTE,A6),-(SP)
                _TESetSelect
                BRA     @0
@9              CMP.B   #255,(Save.hilite,A6)
                BEQ     @0
                PEA     (Save,A6)
                MOVE    #1,-(SP)
                BSR     SetCtlValue
                MOVE    #8,A0
                _Delay
                PEA     (Save,A6)
                MOVE    #0,-(SP)
                BSR     SetCtlValue

@10             MOVE.L  (hTE,A6),A3
                MOVE.L  (A3),A3
                MOVEQ   #0,D0
                MOVE    (TERec.teLength,A3),D0
                MOVE.L  (TERec.hText,A3),A0
                MOVE.L  (A0),A0
                LEA     (log.fileName,A4),A1
                MOVE.B  D0,(A1)+
                _BlockMove
                MOVE    #1,(Result,A6)

@11             MOVE    #watchCursor,-(SP)
                BSR     SetCursor
                _ShowCursor

                MOVE.L  (hTE,A6),-(SP)
                _TEDispose

                PEA     (pnState,A6)
                _SetPenState

                MOVE.L  (theBits,A6),-(SP)
                BSR     RestoreBits
                BRA.S   Exit

@12             MOVE    #memFullErr,(Result,A6)
                PEA     (pnState,A6)
                _SetPenState
                MOVE.L  (theBits,A6),-(SP)
                BSR     RestoreBits
                BRA.S   Exit
@13             MOVE    #memFullErr,(Result,A6)

Exit            MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE Capture;
;———————————————————————————————————————————————————————————————
Capture         PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
RetAddr         DS.L    1
A6Link          DS.L    1
refresh         DS.W    1
saveRealMode    DS.L    1
saveZone        DS.L    1
saveGDevice     DS.L    1
savePort        DS.L    1
theRect         DS      Rect
theEvent        DS      EventRecord
LocalSize       EQU     *
                ENDR

                WITH    Globals,StackFrame,CurrentQDGlobals

                LINK    A6,#LocalSize
                MOVEM.L D3-D7/A2-A4,-(SP)
                MOVE.L  (Head,PC),A4
                ST      (scFlag,A4)

                SF      (refresh,A6)

                _ShowCursor
                BTST    #15,(options,A4)
                BEQ.S   @0

                TST.B   (hasRealMode,A4)
                BEQ.S   @62
                SUBQ.L  #4,SP
                _GetAllDevicesRealMode
                MOVE.L  (SP)+,(saveRealMode,A6)
                MOVE.L  #1,-(SP)
                _SetAllDevicesRealMode

@62             CLR.B   (CrsrVis)

                TST.B   (hasRealMode,A4)
                BEQ.S   @63
                MOVE.L  (saveRealMode,A6),-(SP)
                _SetAllDevicesRealMode

@63             ST      (refresh,A6)

@0              _GetZone
                MOVE.L  A0,(saveZone,A6)
                BSR     GetSysZoneType
                BNE.S   @1
                MOVE.L  (ApplZone),A0
                _SetZone
                BRA.S   @2
@1              MOVE.L  (SysZone),A0
                _SetZone

@2              BSR     GetQDType
                BNE     @24

                MOVEQ   #GrafPort.sizeof,D0
                _NewPtr
                BNE     @23
                MOVE.L  A0,A3
                PEA     (savePort,A6)
                _GetPort
                MOVE.L  A3,-(SP)
                _OpenPort
                SUBQ.L  #4,SP
                MOVE.L  SP,-(SP)
                _GetWMgrPort
                MOVE.L  (SP)+,A0
                MOVE.L  (GrafPort.visRgn,A0),-(SP)
                MOVE.L  (GrafPort.visRgn,A3),-(SP)
                _CopyRgn

                MOVE    #5,-(SP)
                BSR     SetCursor

                LEA     (theRect,A6),A2

                MOVE    (area,A4),D0
                BNE.S   @5

@3              LEA     (theEvent,A6),A0
                MOVEQ   #$3F,D0
                _GetOSEvent
                TST.B   D0
                BNE.S   @3
                MOVE    (theEvent.what,A6),D0

                CMP     #mouseDown,D0
                BNE.S   @4
                MOVE.L  (theEvent.where,A6),-(SP)
                MOVE.L  A2,-(SP)
                BSR     GrowRect
                MOVE    (Rect.right,A2),D0
                SUB     (Rect.left,A2),D0
                MOVE    (Rect.bottom,A2),D1
                SUB     (Rect.top,A2),D1
                MULU    D1,D0
                CMP.L   #16,D0
                BLS     @22
                MOVE.L  (Rect.topLeft,A2),(saveRect.topLeft,A4)
                MOVE.L  (Rect.botRight,A2),(saveRect.botRight,A4)
                MOVE    #0,(log.area,A4)
                BRA     @11

@4              CMP     #keyDown,D0
                BNE.S   @3
                SUBQ.L  #2,SP
                MOVE.L  (theEvent.message,A6),-(SP)
                BSR     GetKeyChar
                MOVE    (SP)+,D0
                CMP.B   (sChar,A4),D0
                BEQ.S   @6
                CMP.B   (mChar,A4),D0
                BEQ.S   @8
                CMP.B   (aChar,A4),D0
                BEQ.S   @10
                CMP.B   (wChar,A4),D0
                BEQ     @69
