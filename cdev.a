                MOVE.L  (SP)+,A0
                _GetHandleSize
                CMP.L   #255,D0
                BLS.S   @0
                MOVE.L  #255,D0
@0              LEA     (text,A6),A1
                MOVE.B  D0,(A1)+
                MOVE.L  (A0),A0
                _BlockMove
                LEA     (text,A6),A0
                _StringToNum
                CMP.L   #1,D0
                BGE.S   @1
                MOVEQ   #1,D0
@1              CMP.L   #100,D0
                BLE.S   @2
                MOVEQ   #100,D0
@2              MOVE    D0,(config.scale,A4)

                SUBQ.L  #4,SP
                MOVE.L  (hTE1,A4),-(SP)
                _TEGetText
                MOVE.L  (SP)+,A0
                _GetHandleSize
                CMP.L   #255,D0
                BLS.S   @3
                MOVE.L  #255,D0
@3              LEA     (text,A6),A1
                MOVE.B  D0,(A1)+
                MOVE.L  (A0),A0
                _BlockMove
                LEA     (text,A6),A0
                _StringToNum
                CMP.L   #0,D0
                BGE.S   @4
                MOVEQ   #0,D0
@4              CMP.L   #999,D0
                BLE.S   @5
                MOVE.L  #999,D0
@5              MOVE    D0,(config.delay,A4)

                MOVE.L  (hTE1,A4),-(SP)
                _TEDispose
                MOVE.L  (hTE0,A4),-(SP)
