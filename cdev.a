                BEQ.S   @1
                CMP.B   #FS,D0
                BLO.S   @5
                CMP.B   #US,D0
                BLS.S   @0
                CMP.B   #'0',D0
                BLO.S   @5
                CMP.B   #'9',D0
                BHI.S   @5

@0              MOVE.L  (EventRecord.message,A3),D0
                AND     #$00FF,D0
