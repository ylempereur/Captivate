                PEA     (config,A4)
                BSR     PutConfig

                MOVE.L  (cdevStorage,A6),A0
                _DisposeHandle
                MOVE.L  #cdevUnset,(cdevStorage,A6)

Exit            MOVE.L  (cdevStorage,A6),(Result,A6)

                MOVEM.L (SP)+,D3-D7/A2-A4
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADD     #ParamSize,SP
                JMP     (A0)

                ENDF
