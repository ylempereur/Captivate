;———————————————————————————————————————————————————————————————
; Resource Header
;———————————————————————————————————————————————————————————————
                MAIN    ENTRY

                IMPORT  cdev

                BRA.S   @0              ; enter here
                DC      0               ; filler
                DC.L    ('cdev')        ; type
                DC      -4064           ; ID
                DC      $0460           ; version

@0              BRA     cdev

                ENDMAIN
;———————————————————————————————————————————————————————————————
; Routine name  TrapAvailable
;
; On entry      D0: trapNum (word)
;
; On exit       D0: 0 if not available, or -1 if available (byte)
;———————————————————————————————————————————————————————————————
TrapAvailable   FUNC    ENTRY

ToolTrapBit     EQU     11
InitGraf        EQU     $A86E
Unimplemented   EQU     $A89F

                MOVEM.L D1/A0/A1,-(SP)
                BTST    #ToolTrapBit,D0
                BEQ.S   @3
                AND     #$07FF,D0
                EXG     D0,D1
                MOVE    #InitGraf,D0
                _GetToolTrapAddress
                MOVE.L  A0,A1
                MOVE    #$AA6E,D0
                _GetToolTrapAddress
                CMP.L   A0,A1
                BNE.S   @0
                MOVE    #$200,D0
                BRA.S   @1
@0              MOVE    #$400,D0
@1              EXG     D0,D1
                CMP     D1,D0
                BLO.S   @2
                MOVE    #Unimplemented,D0
@2              _GetToolTrapAddress
                BRA.S   @4
@3              _GetOSTrapAddress
@4              MOVE.L  A0,A1
                MOVE    #Unimplemented,D0
                _GetToolTrapAddress
                CMP.L   A0,A1
                SNE     D0
                MOVEM.L (SP)+,D1/A0/A1
                TST.B   D0
                RTS

                ENDF
;———————————————————————————————————————————————————————————————
; PROCEDURE Concat (str0,str1,… : Str255; VAR theString: Str255; n: INTEGER);
;———————————————————————————————————————————————————————————————
Concat          PROC    ENTRY

                MOVEM.L D0-D2/A0-A2,-(SP)
                LEA     (28,SP),A1
                MOVE    (A1)+,D0
                MOVE.L  (A1)+,A0
                MOVE    D0,D2
                ADD     D2,D2
                ADD     D2,D2
                ADD     D2,A1
                CLR     D1
                ADDQ    #1,A0
                BRA.S   @3
@0              MOVE.L  -(A1),A2
                CLR     D2
                MOVE.B  (A2)+,D2
                ADD     D2,D1
                CMP     #255,D1
                BLE.S   @2
                SUB     #255,D1
                SUB     D1,D2
                MOVE    #255,D1
                BRA.S   @2
@1              MOVE.B  (A2)+,(A0)+
@2              DBRA    D2,@1
@3              DBRA    D0,@0
                MOVE.L  -(A1),A0
                MOVE.B  D1,(A0)
                MOVE    -(A1),D0
                MOVE.L  A1,A0
                ADD     D0,D0
                ADD     D0,D0
                ADD     D0,A0
                ADDQ    #2,A0
                MOVE.L  -(A1),(A0)
                MOVE.L  A0,(A1)
                MOVEM.L (SP)+,D0-D2/A0-A2
                MOVE.L  (SP)+,SP
                RTS

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE GetTextState (VAR txState: TextState);
;———————————————————————————————————————————————————————————————
GetTextState    PROC    ENTRY

StackFrame      RECORD  {RetAddr},DECR
txState         DS.L    1
RetAddr         DS.L    1
                ENDR

                WITH    StackFrame,CurrentQDGlobals

                MOVE.L  (0,A5),A0
                MOVE.L  (thePort,A0),A0
                LEA     (GrafPort.txFont,A0),A0
                MOVE.L  (txState,SP),A1
                MOVE.L  (A0)+,(A1)+
                MOVE.L  (A0)+,(A1)+
                MOVE.L  (SP)+,(SP)
                RTS

                ENDP
;———————————————————————————————————————————————————————————————
; PROCEDURE SetTextState (txState: TextState);
;———————————————————————————————————————————————————————————————
SetTextState    PROC    ENTRY

StackFrame      RECORD  {RetAddr},DECR
txState         DS.L    1
RetAddr         DS.L    1
                ENDR

                WITH    StackFrame,CurrentQDGlobals

                MOVE.L  (0,A5),A0
                MOVE.L  (thePort,A0),A0
                LEA     (GrafPort.txFont,A0),A0
                MOVE.L  (txState,SP),A1
                MOVE.L  (A1)+,(A0)+
                MOVE.L  (A1)+,(A0)+
                MOVE.L  (SP)+,(SP)
                RTS

                ENDP
;———————————————————————————————————————————————————————————————
; FUNCTION GetIValue (theDialog: DialogPtr; itemNo: INTEGER) : INTEGER;
;———————————————————————————————————————————————————————————————
GetIValue       FUNC    ENTRY

StackFrame      RECORD  {A6Link},DECR
Result          DS      1
ParamBegin      EQU     *
theDialog       DS.L    1
itemNo          DS      1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
itemType        DS      1
item            DS.L    1
box             DS.B    8
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVE.L  (theDialog,A6),-(SP)
                MOVE    (itemNo,A6),-(SP)
                PEA     (itemType,A6)
                PEA     (item,A6)
                PEA     (box,A6)
                _GetDialogItem
                SUBQ.L  #2,SP
                MOVE.L  (item,A6),-(SP)
                _GetControlValue
                MOVE    (SP)+,(Result,A6)
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDF
;———————————————————————————————————————————————————————————————
