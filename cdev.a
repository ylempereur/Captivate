KeyEvt          CMP     #keyEvtDev,D0
                BNE     DeActiv

                MOVE.L  (cdevStorage,A6),A0
                _HGetState
                MOVE.B  D0,-(SP)
                _HLock
                MOVE.L  (A0),A4

                MOVE.L  (theEvent,A6),A3

                MOVE    (EventRecord.modifiers,A3),D0
                BTST    #cmdKeyBit,D0
