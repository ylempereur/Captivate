SetIValue       PROC    ENTRY

StackFrame      RECORD  {A6Link},DECR
ParamBegin      EQU     *
theDialog       DS.L    1
itemNo          DS      1
theValue        DS      1
ParamSize       EQU     ParamBegin-*
RetAddr         DS.L    1
A6Link          DS.L    1
itemType        DS      1
item            DS.L    1
box             DS.B    8
LocalSize       EQU     *
                ENDR

                WITH    StackFrame

                LINK    A6,#LocalSize
                MOVE.L  (theDialog,A6),-(SP)
                MOVE    (itemNo,A6),-(SP)
                PEA     (itemType,A6)
                PEA     (item,A6)
                PEA     (box,A6)
                _GetDialogItem
                MOVE.L  (item,A6),-(SP)
                MOVE    (theValue,A6),-(SP)
                _SetControlValue
                UNLK    A6
                MOVE.L  (SP)+,A0
                ADDQ.L  #ParamSize,SP
                JMP     (A0)

                ENDP
